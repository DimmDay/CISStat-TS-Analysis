                            "РЎРІРѕР№СЃС‚РІРѕ": "РђРІС‚РѕРєРѕСЂСЂРµР»СЏС†РёСЏ",
                            "РњРµС‚РѕРґ": "Ljung-Box Test (Lag=10)",
                            "РћРїРёСЃР°РЅРёРµ": "РџСЂРѕРІРµСЂСЏРµС‚ РіРёРїРѕС‚РµР·Сѓ Рѕ С‚РѕРј, С‡С‚Рѕ Р·РЅР°С‡РµРЅРёСЏ СЂСЏРґР° РЅРµР·Р°РІРёСЃРёРјС‹ (Р±РµР»С‹Р№ С€СѓРј). Hв‚Ђ: РђРІС‚РѕРєРѕСЂСЂРµР»СЏС†РёСЏ СЂР°РІРЅР° 0.",
                            "Р РµР·СѓР»СЊС‚Р°С‚": "вњ… Р‘РµР»С‹Р№ С€СѓРј (РќРµС‚ РђРљ)" if is_white_noise else "вљ пёЏ Р•СЃС‚СЊ Р°РІС‚РѕРєРѕСЂСЂРµР»СЏС†РёСЏ"
                        })

                        # в”Ђв”Ђ 3. РќРѕСЂРјР°Р»СЊРЅРѕСЃС‚СЊ (Jarque-Bera) в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                        from scipy import stats
                        jb_res = stats.jarque_bera(analysis_series)
                        jb_p = jb_res.pvalue if hasattr(jb_res, 'pvalue') else jb_res[1]
                        is_normal = jb_p > 0.05

                        results_data.append({
                            "РЎРІРѕР№СЃС‚РІРѕ": "РќРѕСЂРјР°Р»СЊРЅРѕСЃС‚СЊ",
                            "РњРµС‚РѕРґ": "Jarque-Bera Test",
                            "РћРїРёСЃР°РЅРёРµ": "РџСЂРѕРІРµСЂСЏРµС‚ СЃРѕРѕС‚РІРµС‚СЃС‚РІРёРµ СЂР°СЃРїСЂРµРґРµР»РµРЅРёСЏ РЅРѕСЂРјР°Р»СЊРЅРѕРјСѓ (Р°СЃРёРјРјРµС‚СЂРёСЏ Рё СЌРєСЃС†РµСЃСЃ). Hв‚Ђ: Р Р°СЃРїСЂРµРґРµР»РµРЅРёРµ РЅРѕСЂРјР°Р»СЊРЅРѕ.",
                            "Р РµР·СѓР»СЊС‚Р°С‚": "вњ… РќРѕСЂРјР°Р»СЊРЅРѕ" if is_normal else "вљ пёЏ РћС‚РєР»РѕРЅРµРЅРёРµ РѕС‚ РЅРѕСЂРјС‹"
                        })

                        # в”Ђв”Ђ 4. РќР°РїСЂР°РІР»РµРЅРёРµ С‚СЂРµРЅРґР° в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                        trend_dir = "рџ“€ Р’РѕСЃС…РѕРґСЏС‰РёР№" if slope > 0 else "рџ“‰ РќРёСЃС…РѕРґСЏС‰РёР№" if slope < 0 else "вћЎпёЏ Р“РѕСЂРёР·РѕРЅС‚Р°Р»СЊРЅС‹Р№"

                        results_data.append({
                            "РЎРІРѕР№СЃС‚РІРѕ": "РќР°РїСЂР°РІР»РµРЅРёРµ С‚СЂРµРЅРґР°",
                            "РњРµС‚РѕРґ": "OLS Linear Regression (Slope)",
                            "РћРїРёСЃР°РЅРёРµ": "РћРїСЂРµРґРµР»СЏРµС‚ СѓРіРѕР» РЅР°РєР»РѕРЅР° Р»РёРЅРёРё С‚СЂРµРЅРґР° С‡РµСЂРµР· РјРµС‚РѕРґ РЅР°РёРјРµРЅСЊС€РёС… РєРІР°РґСЂР°С‚РѕРІ.",
                            "Р РµР·СѓР»СЊС‚Р°С‚": f"{trend_dir} (Slope={slope:.4f})"
                        })

                        # в”Ђв”Ђ рџ“€ РљРћР Р Р•Р›РЇР¦РРЇ Р§РРЎР›РћР’Р«РҐ РџР РР—РќРђРљРћР’ (РЅРѕРІР°СЏ РјРµС‚СЂРёРєР°) в”Ђв”Ђв”Ђв”Ђв”Ђ
                        num_cols = ct_f.get("num", [])
                        if len(num_cols) >= 2 and target_col in num_cols:
                            # Р Р°СЃСЃС‡РёС‚С‹РІР°РµРј РєРѕСЂСЂРµР»СЏС†РёРё С‚РѕР»СЊРєРѕ РґР»СЏ С‡РёСЃР»РѕРІС‹С… РєРѕР»РѕРЅРѕРє РІ РѕС‚С„РёР»СЊС‚СЂРѕРІР°РЅРЅС‹С… РґР°РЅРЅС‹С…
                            corr_df = df_filtered[num_cols].corr()
                            target_corr = corr_df[target_col].drop(target_col).sort_values(key=abs, ascending=False)

                            # Р¤РѕСЂРјРёСЂСѓРµРј СЃС‚СЂРѕРєСѓ СЃ С‚РѕРї-3 РєРѕСЂСЂРµР»СЏС†РёСЏРјРё
                            top_corrs = []
                            for col, val in target_corr.head(3).items():
                                sign = "рџџў" if val > 0.5 else ("рџ”ґ" if val < -0.5 else "рџџЎ")
                                top_corrs.append(f"{sign} {col} ({val:.2f})")

                            corr_result = ", ".join(top_corrs) if top_corrs else "вљЄ РќРµС‚ СЃРёР»СЊРЅС‹С… СЃРІСЏР·РµР№ (|r|<0.5)"

                            results_data.append({
                                "РЎРІРѕР№СЃС‚РІРѕ": "РљРѕСЂСЂРµР»СЏС†РёСЏ РїСЂРёР·РЅР°РєРѕРІ",
                                "РњРµС‚РѕРґ": "Pearson correlation matrix",
                                "РћРїРёСЃР°РЅРёРµ": "Р›РёРЅРµР№РЅР°СЏ СЃРІСЏР·СЊ С†РµР»РµРІРѕР№ РјРµС‚СЂРёРєРё СЃ РґСЂСѓРіРёРјРё С‡РёСЃР»РѕРІС‹РјРё РїСЂРёР·РЅР°РєР°РјРё. рџџў>0.5, рџ”ґ<-0.5, рџџЎ СЃР»Р°Р±Р°СЏ",
                                "Р РµР·СѓР»СЊС‚Р°С‚": corr_result
                            })

                        # в”Ђв”Ђ 5. РЎР•Р—РћРќРќРћРЎРўР¬ (РіСЂСѓРїРїРёСЂРѕРІРєР°: Strength + ACF РїРµСЂРёРѕРґС‹) в”Ђв”Ђ
                        from statsmodels.tsa.seasonal import STL
                        period = 7 if (inferred_freq and 'D' in inferred_freq) else 12
                        try:
                            stl_res = STL(analysis_series, period=period, robust=True).fit()
                            var_total = analysis_series.var()
                            var_resid = stl_res.resid.var()
                            var_detrended = var_total - stl_res.trend.var()
                            strength_seasonality = max(0, 1 - var_resid / var_detrended) if var_detrended > 0 else 0
                            is_seasonal = strength_seasonality > 0.6
                        except:
                            strength_seasonality = 0.0
                            is_seasonal = False

                        results_data.append({
                            "РЎРІРѕР№СЃС‚РІРѕ": "РЎРµР·РѕРЅРЅРѕСЃС‚СЊ (СЃРёР»Р°)",
                            "РњРµС‚РѕРґ": "STL Decomposition (Strength)",
                            "РћРїРёСЃР°РЅРёРµ": "Р”РѕР»СЏ РґРёСЃРїРµСЂСЃРёРё, РѕР±СЉСЏСЃРЅСЏРµРјР°СЏ СЃРµР·РѕРЅРЅРѕР№ РєРѕРјРїРѕРЅРµРЅС‚РѕР№ (0..1). >0.6 = СЃРёР»СЊРЅР°СЏ СЃРµР·РѕРЅРЅРѕСЃС‚СЊ.",
                            "Р РµР·СѓР»СЊС‚Р°С‚": f"{'вњ… РЎРёР»СЊРЅР°СЏ' if is_seasonal else 'вљ пёЏ РЎР»Р°Р±Р°СЏ/РќРµС‚'} (S={strength_seasonality:.2f})"
                        })

                        # в”Ђв”Ђ 6. РЎРµР·РѕРЅРЅС‹Рµ РїРµСЂРёРѕРґС‹ (РёР· ACF) вЂ” РЎР РђР—РЈ РџРћРЎР›Р• РЎРР›Р« в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                        from statsmodels.tsa.stattools import acf as acf_func
                        max_lag = min(60, len(analysis_series) // 4)
                        acf_values = acf_func(analysis_series, nlags=max_lag)
                        confidence = 1.96 / np.sqrt(len(analysis_series))
                        significant_lags = np.where(np.abs(acf_values) > confidence)[0][1:]

                        seasonal_periods_acf = []
                        for i, lag in enumerate(significant_lags):
                            if i > 0 and lag - significant_lags[i-1] < 3:
                                continue
                            if lag > 2:
                                seasonal_periods_acf.append(lag)

                        acf_seasonality = seasonal_periods_acf[:3] if seasonal_periods_acf else []
                        results_data.append({
                            "РЎРІРѕР№СЃС‚РІРѕ": "РЎРµР·РѕРЅРЅС‹Рµ РїРµСЂРёРѕРґС‹ (ACF)",
                            "РњРµС‚РѕРґ": "РђРІС‚РѕРєРѕСЂСЂРµР»СЏС†РёРѕРЅРЅР°СЏ С„СѓРЅРєС†РёСЏ + РїРѕСЂРѕРі Р·РЅР°С‡РёРјРѕСЃС‚Рё",
                            "РћРїРёСЃР°РЅРёРµ": "Р›Р°РіРё СЃ РєРѕСЂСЂРµР»СЏС†РёРµР№ РІС‹С€Рµ 95% РґРѕРІРµСЂРёС‚РµР»СЊРЅРѕРіРѕ РёРЅС‚РµСЂРІР°Р»Р°. РџРѕРєР°Р·С‹РІР°РµС‚ РїРµСЂРёРѕРґРёС‡РЅРѕСЃС‚СЊ СЂСЏРґР°.",
                            "Р РµР·СѓР»СЊС‚Р°С‚": f"{'вњ… ' + ', '.join(map(str, acf_seasonality)) if acf_seasonality else 'вљ пёЏ РќРµ РѕР±РЅР°СЂСѓР¶РµРЅС‹'}"
                        })

                        # в”Ђв”Ђ 7. Р”РѕР»РіР°СЏ РїР°РјСЏС‚СЊ (Hurst Exponent) в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                        def hurst_exponent(series, max_lag=20):
                            lags = range(2, max_lag)
                            tau = [max(np.std(np.subtract(series[lag:], series[:-lag])), 1e-8) for lag in lags]
                            try:
                                return np.polyfit(np.log(lags), np.log(tau), 1)[0]
                            except: return 0.5

                        hurst_val = hurst_exponent(analysis_series.values)
                        memory_type = "рџ”µ РђРЅС‚РёРїРµСЂСЃРёСЃС‚РµРЅС‚РЅРѕСЃС‚СЊ" if hurst_val < 0.45 else ("рџ”ґ РЈСЃС‚РѕР№С‡РёРІС‹Р№ С‚СЂРµРЅРґ" if hurst_val > 0.55 else "вљЄ РЎР»СѓС‡Р°Р№РЅРѕРµ Р±Р»СѓР¶РґР°РЅРёРµ")

                        results_data.append({
                            "РЎРІРѕР№СЃС‚РІРѕ": "Р”РѕР»РіР°СЏ РїР°РјСЏС‚СЊ",
                            "РњРµС‚РѕРґ": "Hurst Exponent (R/S Analysis)",
                            "РћРїРёСЃР°РЅРёРµ": "РҐР°СЂР°РєС‚РµСЂРёР·СѓРµС‚ РїРµСЂСЃРёСЃС‚РµРЅС‚РЅРѕСЃС‚СЊ СЂСЏРґР°. H=0.5 (Random Walk), H>0.5 (Trend), H<0.5 (Mean Reverting).",
                            "Р РµР·СѓР»СЊС‚Р°С‚": f"{memory_type} (H={hurst_val:.2f})"
                        })

                        # в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
                        #  рџ†• РЎРџР•РљРўР РђР›Р¬РќР«Р• РЎР’РћР™РЎРўР’Рђ (РёР· СЃРїРµРєС‚СЂР°Р»СЊРЅРѕРіРѕ Р°РЅР°Р»РёР·Р°)
                        # в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ

                        # в”Ђв”Ђ 8. Р”РѕРјРёРЅРёСЂСѓСЋС‰РёРµ С‡Р°СЃС‚РѕС‚С‹ (FFT) в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ

                        n = len(analysis_series)
                        y = analysis_series.values - analysis_series.mean()
                        yf = fft(y)
                        xf = fftfreq(n, 1)[:n//2]
                        amplitude = 2.0/n * np.abs(yf[0:n//2])

                        peaks, _ = find_peaks(amplitude, height=np.mean(amplitude) + np.std(amplitude))
                        fft_periods = [1/xf[p] for p in peaks if xf[p] > 0 and xf[p] < 0.5]
                        fft_dominant = sorted(fft_periods)[:3] if fft_periods else []

                        results_data.append({
                            "РЎРІРѕР№СЃС‚РІРѕ": "Р”РѕРјРёРЅРёСЂСѓСЋС‰РёРµ С‡Р°СЃС‚РѕС‚С‹ (FFT)",
                            "РњРµС‚РѕРґ": "Р‘С‹СЃС‚СЂРѕРµ РїСЂРµРѕР±СЂР°Р·РѕРІР°РЅРёРµ Р¤СѓСЂСЊРµ + РїРѕРёСЃРє РїРёРєРѕРІ",
                            "РћРїРёСЃР°РЅРёРµ": "РџРµСЂРёРѕРґС‹ СЃ РјР°РєСЃРёРјР°Р»СЊРЅРѕР№ Р°РјРїР»РёС‚СѓРґРѕР№ РІ С‡Р°СЃС‚РѕС‚РЅРѕР№ РѕР±Р»Р°СЃС‚Рё. Р”Р»СЏ СЃРѕР·РґР°РЅРёСЏ Fourier features.",
                            "Р РµР·СѓР»СЊС‚Р°С‚": f"{'вњ… ' + ', '.join([f'{p:.1f}' for p in fft_dominant]) if fft_dominant else 'вљ пёЏ РќРµ РѕР±РЅР°СЂСѓР¶РµРЅС‹'}"
                        })

                        # в”Ђв”Ђ 9. РЎРїРµРєС‚СЂР°Р»СЊРЅР°СЏ РїР»РѕС‚РЅРѕСЃС‚СЊ (Periodogram) в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                        from scipy.signal import periodogram
                        freq_per, pxx_per = periodogram(analysis_series.values, fs=1.0, window='hann')
                        peaks_per, _ = find_peaks(pxx_per, height=np.median(pxx_per)*2)
                        periodogram_periods = sorted([1/freq_per[p] for p in peaks_per if freq_per[p] > 0])[:3]

                        results_data.append({
                            "РЎРІРѕР№СЃС‚РІРѕ": "Р—РЅР°С‡РёРјС‹Рµ РїРµСЂРёРѕРґС‹ (РџРµСЂРёРѕРґРѕРіСЂР°РјРјР°)",
                            "РњРµС‚РѕРґ": "Periodogram СЃ РѕРєРЅРѕРј Hann + РїРѕСЂРѕРі РјРѕС‰РЅРѕСЃС‚Рё",
                            "РћРїРёСЃР°РЅРёРµ": "Р§Р°СЃС‚РѕС‚С‹ СЃ РјРѕС‰РЅРѕСЃС‚СЊСЋ РІС‹С€Рµ РјРµРґРёР°РЅС‹ Г— 2. РџРѕРєР°Р·С‹РІР°РµС‚ РІРєР»Р°Рґ СЂР°Р·РЅС‹С… С†РёРєР»РѕРІ РІ РґРёСЃРїРµСЂСЃРёСЋ.",
                            "Р РµР·СѓР»СЊС‚Р°С‚": f"{'вњ… ' + ', '.join([f'{p:.1f}' for p in periodogram_periods]) if periodogram_periods else 'вљ пёЏ РќРµ РѕР±РЅР°СЂСѓР¶РµРЅС‹'}"
                        })

                        # в”Ђв”Ђ 10. Р’РµР№РІР»РµС‚-РјР°СЃС€С‚Р°Р±С‹ (РѕРїС†РёРѕРЅР°Р»СЊРЅРѕ) в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                        wavelet_scales = []
                        try:
                            import pywt
                            widths = np.arange(1, min(128, len(analysis_series)//4))
                            cwtmatr, _ = pywt.cwt(analysis_series.values - analysis_series.mean(), widths, 'morl', sampling_period=1)
                            mean_power = np.mean(np.abs(cwtmatr), axis=1)
                            wavelet_peaks, _ = find_peaks(mean_power, height=np.mean(mean_power))
                            wavelet_scales = widths[wavelet_peaks][:3].tolist() if len(wavelet_peaks) > 0 else []

                            results_data.append({
                                "РЎРІРѕР№СЃС‚РІРѕ": "Р”РѕРјРёРЅРёСЂСѓСЋС‰РёРµ РјР°СЃС€С‚Р°Р±С‹ (Wavelet)",
                                "РњРµС‚РѕРґ": "Continuous Wavelet Transform (Morlet)",
                                "РћРїРёСЃР°РЅРёРµ": "РњР°СЃС€С‚Р°Р±С‹ СЃ РјР°РєСЃРёРјР°Р»СЊРЅРѕР№ СЃСЂРµРґРЅРµР№ РјРѕС‰РЅРѕСЃС‚СЊСЋ. РџРѕРєР°Р·С‹РІР°РµС‚ РёР·РјРµРЅРµРЅРёРµ С†РёРєР»РѕРІ РІРѕ РІСЂРµРјРµРЅРё.",
                                "Р РµР·СѓР»СЊС‚Р°С‚": f"{'вњ… ' + ', '.join(map(str, wavelet_scales)) if wavelet_scales else 'вљ пёЏ РќРµ РѕР±РЅР°СЂСѓР¶РµРЅС‹'}"
                            })
                        except ImportError:
