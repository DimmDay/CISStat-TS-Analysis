                # РЎРѕС…СЂР°РЅРµРЅРёРµ РІ session_state РґР»СЏ РґР°Р»СЊРЅРµР№С€РµРіРѕ РёСЃРїРѕР»СЊР·РѕРІР°РЅРёСЏ
                st.session_state.ih_results = df_ih
