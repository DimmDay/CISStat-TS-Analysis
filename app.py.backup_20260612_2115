            рџ’Ў **РљР°Рє РёСЃРїРѕР»СЊР·РѕРІР°С‚СЊ СЌС‚Сѓ РёРЅС„РѕСЂРјР°С†РёСЋ:**
            - РџСЂРё РѕР±РЅР°СЂСѓР¶РµРЅРёРё РЅР°СЂСѓС€РµРЅРёСЏ СЃРјРѕС‚СЂРёС‚Рµ, РєР°РєРѕРјСѓ СЃС‚Р°РЅРґР°СЂС‚Сѓ РѕРЅРѕ РїСЂРѕС‚РёРІРѕСЂРµС‡РёС‚
            - РСЃРїРѕР»СЊР·СѓР№С‚Рµ С†РµР»РµРІС‹Рµ РїРѕРєР°Р·Р°С‚РµР»Рё (Target DQ Levels) РґР»СЏ РїСЂРёРѕСЂРёС‚РёР·Р°С†РёРё РёСЃРїСЂР°РІР»РµРЅРёР№
            - РЎСЃС‹Р»Р°Р№С‚РµСЃСЊ РЅР° СЃС‚Р°РЅРґР°СЂС‚С‹ РїСЂРё РѕР±РѕСЃРЅРѕРІР°РЅРёРё РЅРµРѕР±С…РѕРґРёРјРѕСЃС‚Рё РѕС‡РёСЃС‚РєРё РґР°РЅРЅС‹С… РїРµСЂРµРґ СЂСѓРєРѕРІРѕРґСЃС‚РІРѕРј
            """)

        st.divider()

        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
        # в”Ђв”Ђ 1. РџР РћР’Р•Р РљРђ РўРРџРћР’ Р”РђРќРќР«РҐ в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ

        if "classification_result" not in st.session_state:
            st.session_state.classification_result = None

        known_cols = set(
            st.session_state.col_types.get("date", []) +
            st.session_state.col_types.get("num", []) +
            st.session_state.col_types.get("cat", [])
        )
        undefined_cols = [col for col in df.columns if col not in known_cols]
        type_issues = len(undefined_cols) > 0

        if type_issues:
            cols_preview = ", ".join(f"`{c}`" for c in undefined_cols[:5])
            if len(undefined_cols) > 5:
                cols_preview += f" Рё РµС‰С‘ {len(undefined_cols) - 5}..."
            type_result = f"вљ пёЏ РќР°Р№РґРµРЅРѕ **{len(undefined_cols)}** РєРѕР»РѕРЅРѕРє СЃ РЅРµРѕРїСЂРµРґРµР»С‘РЅРЅС‹Рј С‚РёРїРѕРј:\n{cols_preview}"
        else:
            type_result = "вњ… Р’СЃРµ С‚РёРїС‹ РєРѕСЂСЂРµРєС‚РЅС‹"

        # Р¤СѓРЅРєС†РёСЏ Р°РІС‚Рѕ-РєР»Р°СЃСЃРёС„РёРєР°С†РёРё
        def auto_classify_types():
            known_cols = set(
                st.session_state.col_types.get("date", []) +
                st.session_state.col_types.get("num", []) +
                st.session_state.col_types.get("cat", [])
            )
            undefined_cols = [col for col in df.columns if col not in known_cols]

            classified = {"date": [], "num": [], "cat": []}
            classification_log = []

            for col in undefined_cols:
                sample = df[col].dropna()
                if len(sample) == 0:
                    continue
                if df[col].dtype == 'object' or str(df[col].dtype) == 'string':
                    try:
                        pd.to_datetime(sample.head(100), errors='raise')
                        classified["date"].append(col)
                        classification_log.append(f"**`{col}`** в†’ рџ“… datetime")
                        continue
                    except:
                        pass

                if pd.api.types.is_numeric_dtype(df[col]):
                    if df[col].nunique() < 50:
                        classified["cat"].append(col)
                        classification_log.append(f"**`{col}`** в†’ рџ“‹ categorical")
                    else:
                        classified["num"].append(col)
                        classification_log.append(f"**`{col}`** в†’ рџ”ў numeric")
                else:
                    classified["cat"].append(col)
                    classification_log.append(f"**`{col}`** в†’ рџ“‹ categorical")

            for cat, cols in classified.items():
                st.session_state.col_types[cat].extend(cols)

            if classification_log:
                st.session_state.classification_result = {"success": True, "count": len(classification_log), "log": classification_log}
            else:
                st.session_state.classification_result = {"success": False, "message": "вљ пёЏ РќРµ СѓРґР°Р»РѕСЃСЊ РєР»Р°СЃСЃРёС„РёС†РёСЂРѕРІР°С‚СЊ."}

        make_card(
            " РџСЂРѕРІРµСЂРєР° С‚РёРїРѕРІ РґР°РЅРЅС‹С… (data types)",
            has_issues=type_issues,
            methodology=(
                "**в—»пёЏ РњРµС‚СЂРёРєРё:** Р¤Р°РєС‚РёС‡РµСЃРєРёР№ `dtype`, Р°РІС‚РѕРєР»Р°СЃСЃРёС„РёРєР°С†РёСЏ `numeric/datetime/categorical`.  \n"
                "**в—»пёЏ РђР»РіРѕСЂРёС‚Рј:** `df.dtypes` в†’ `select_dtypes()` в†’ СЃРІРµСЂРєР° СЃ `detect_and_convert_year_columns`.  \n"
                "**в—»пёЏ Р’Р»РёСЏРЅРёРµ РЅР° TS:** РќРµРєРѕСЂСЂРµРєС‚РЅС‹Р№ С‚РёРї Р»РѕРјР°РµС‚ `DatetimeIndex` в†’ РєСЂРёС‚РёС‡РЅРѕ РґР»СЏ ARIMA/Prophet.  \n"
                "**в—»пёЏ РљР°Рє СЂР°Р±РѕС‚Р°РµС‚ Р°РІС‚Рѕ-РєР»Р°СЃСЃРёС„РёРєР°С†РёСЏ:**  \n"
                "| РЁР°Рі | Р›РѕРіРёРєР° | РџСЂРёРјРµСЂ |  \n"
                "|-----|--------|--------|  \n"
                "| **1. Р”РµС‚РµРєС†РёСЏ РґР°С‚** | РџСЂРѕР±СѓРµС‚ `pd.to_datetime()` РЅР° РїРµСЂРІС‹С… 100 Р·РЅР°С‡РµРЅРёСЏС…. Р•СЃР»Рё СѓСЃРїРµС€РЅРѕ в†’ datetime | `Date_Column` в†’ datetime |  \n"
                "| **2. Р§РёСЃР»РѕРІС‹Рµ** | РџСЂРѕРІРµСЂСЏРµС‚ `is_numeric_dtype()`. Р•СЃР»Рё `<50` СѓРЅРёРєР°Р»СЊРЅС‹С… в†’ РєР°С‚РµРіРѕСЂРёСЏ, РёРЅР°С‡Рµ в†’ numeric | `Region_ID` в†’ categorical (12 Р·РЅР°С‡РµРЅРёР№) |  \n"
                "| **3. РЎС‚СЂРѕРєРѕРІС‹Рµ** | Р’СЃС‘ РѕСЃС‚Р°Р»СЊРЅРѕРµ в†’ РєР°С‚РµРіРѕСЂРёСЏ | `Product_Name` в†’ categorical (45 СѓРЅРёРєР°Р»СЊРЅС‹С…) |"
            ),
            result_text=type_result,
            result_status="вњ…" if not type_issues else "вљ пёЏ",
            fix_action={"label": "РђРІС‚Рѕ-РєР»Р°СЃСЃРёС„РёС†РёСЂРѕРІР°С‚СЊ С‚РёРїС‹", "callback": auto_classify_types} if type_issues else None
        )

        # РџРѕРєР°Р·С‹РІР°РµРј СЂРµР·СѓР»СЊС‚Р°С‚ РєР»Р°СЃСЃРёС„РёРєР°С†РёРё
        if st.session_state.classification_result is not None:
            result = st.session_state.classification_result
            if result["success"]:
                st.success(f"вњ… **РђРІС‚Рѕ-РєР»Р°СЃСЃРёС„РёРєР°С†РёСЏ Р·Р°РІРµСЂС€РµРЅР°!** Р Р°СЃРїСЂРµРґРµР»РµРЅРѕ **{result['count']}** РєРѕР»РѕРЅРѕРє.")
                st.info("рџ’Ў **РЎР»РµРґСѓСЋС‰РёР№ С€Р°Рі:** РќР°Р¶РјРёС‚Рµ **Р—Р°РїСѓСЃС‚РёС‚СЊ РІР°Р»РёРґР°С†РёСЋ** СЃРЅРѕРІР°.")
                if st.button("рџ”„ РЎРєСЂС‹С‚СЊ СЂРµР·СѓР»СЊС‚Р°С‚", key="clear_classification"):
                    st.session_state.classification_result = None
                    st.rerun()
            else:
                st.warning(result["message"])

        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
        # 2. РџР РћР’Р•Р РљРђ Р¤РћР РњРђРўРћР’ Р РЁРђР‘Р›РћРќРћР’ (REGEX)
        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ

        # РџРѕР»СѓС‡Р°РµРј СЂРµР·СѓР»СЊС‚Р°С‚С‹ РёР· session_state
        pattern_results_local = st.session_state.get("pattern_results", [])

        # Р¤РР›Р¬РўР РЈР•Рњ С‚РѕР»СЊРєРѕ Р Р•РђР›Р¬РќР«Р• РЅР°СЂСѓС€РµРЅРёСЏ (РёРіРЅРѕСЂРёСЂСѓРµРј N/A Рё С‡РёСЃР»РѕРІС‹Рµ РєРѕР»РѕРЅРєРё)
        real_violations = []
        for r in pattern_results_local:
            invalid_count = r.get('invalid_count', 'N/A')
            col_name = r.get('РљРѕР»РѕРЅРєР°', '')

            # РџСЂРѕРїСѓСЃРєР°РµРј РµСЃР»Рё:
            # 1. РќРµС‚ РґР°РЅРЅС‹С… Рѕ РЅР°СЂСѓС€РµРЅРёСЏС… (N/A)
            # 2. РќР°СЂСѓС€РµРЅРёР№ = 0
            # 3. РљРѕР»РѕРЅРєР° С‡РёСЃР»РѕРІР°СЏ (РЅРµ РґРѕР»Р¶РЅР° РїСЂРѕРІРµСЂСЏС‚СЊСЃСЏ regex)
            if (invalid_count == 'N/A' or invalid_count is None or invalid_count == 0):
                continue

            # Р”РѕРїРѕР»РЅРёС‚РµР»СЊРЅР°СЏ РїСЂРѕРІРµСЂРєР°: РїСЂРѕРїСѓСЃРєР°РµРј С‡РёСЃР»РѕРІС‹Рµ РєРѕР»РѕРЅРєРё
            if col_name in df.select_dtypes(include=['int64', 'float64']).columns:
                continue

            real_violations.append(r)

        pattern_issues = len(real_violations) > 0

        # РЎРѕС…СЂР°РЅСЏРµРј РѕС‚С„РёР»СЊС‚СЂРѕРІР°РЅРЅС‹Р№ СЃРїРёСЃРѕРє РґР»СЏ РґР°Р»СЊРЅРµР№С€РµРіРѕ РёСЃРїРѕР»СЊР·РѕРІР°РЅРёСЏ
        st.session_state.pattern_results_filtered = real_violations

