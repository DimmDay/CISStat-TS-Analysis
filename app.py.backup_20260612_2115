                    if best_syn["synergy"] > 0.1:
                        recommendations.append(f"рџ¤ќ **РЎРёРЅРµСЂРіРёСЏ**: РїР°СЂР° `{best_syn['pair']}` РґР°С‘С‚ +{best_syn['synergy']*100:.1f}% РёРЅС„РѕСЂРјР°С†РёРё РІРјРµСЃС‚Рµ в†’ СЃРѕР·РґР°Р№С‚Рµ РєРѕРјР±РёРЅРёСЂРѕРІР°РЅРЅС‹Р№ РїСЂРёР·РЅР°Рє")

                # Р’С‹РІРѕРґ СЂРµРєРѕРјРµРЅРґР°С†РёР№
                if recommendations:
