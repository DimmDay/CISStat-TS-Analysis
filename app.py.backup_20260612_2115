            elif "РјРµРґРёР°РЅРѕР№" in fill_strategy or "РњРµРґРёР°РЅР°" in fill_strategy:
                st.info("рџ“Љ **РњРµРґРёР°РЅР° (С‡РёСЃР»РѕРІС‹Рµ)/РјРѕРґР° (РєР°С‚РµРіРѕСЂРёР°Р»СЊРЅС‹Рµ)** вЂ” СѓСЃС‚РѕР№С‡РёРІРѕ Рє РІС‹Р±СЂРѕСЃР°Рј")
            elif "СЃСЂРµРґРЅРёРј" in fill_strategy or "РЎСЂРµРґРЅРµРµ" in fill_strategy:
                st.info("рџ“€ **РЎСЂРµРґРЅРµРµ** вЂ” РґР»СЏ РЅРѕСЂРјР°Р»СЊРЅРѕРіРѕ СЂР°СЃРїСЂРµРґРµР»РµРЅРёСЏ")
            elif "РЅСѓР»С‘Рј" in fill_strategy or "РќРѕР»СЊ" in fill_strategy:
                st.info("0пёЏвѓЈ **РљРѕРЅСЃС‚Р°РЅС‚Р°** вЂ” РїСЂРѕСЃС‚Рѕ, РЅРѕ РјРѕР¶РµС‚ РёСЃРєР°Р·Р°С‚СЊ РґР°РЅРЅС‹Рµ")
            elif "РРЅС‚РµСЂРїРѕР»СЏС†РёСЏ" in fill_strategy:
                st.info("в†•пёЏ **РРЅС‚РµСЂРїРѕР»СЏС†РёСЏ** вЂ” РґР»СЏ РІСЂРµРјРµРЅРЅС‹С… СЂСЏРґРѕРІ")
            elif "РёРЅРґРёРєР°С‚РѕСЂ" in fill_strategy:
                st.info("рџљ© **РРЅРґРёРєР°С‚РѕСЂ** вЂ” РґРѕР±Р°РІРёС‚ РєРѕР»РѕРЅРєРё miss_* СЃ С„Р»Р°РіРѕРј 0/1")
        with c2:
            # рџ”§ РРЎРџР РђР’Р›Р•РќРР•: РљРЅРѕРїРєР° "РџСЂРёРјРµРЅРёС‚СЊ" СѓРґР°Р»РµРЅР°.
            # РџСѓСЃС‚РѕР№ Р±Р»РѕРє РґР»СЏ РІРёР·СѓР°Р»СЊРЅРѕРіРѕ РІС‹СЂР°РІРЅРёРІР°РЅРёСЏ СЃ РґСЂСѓРіРёРјРё РјРѕРґСѓР»СЏРјРё
            st.markdown("<div style='margin-top: 28px;'></div>", unsafe_allow_html=True)

        # РљРЅРѕРїРєР°-С‚СЂРёРіРіРµСЂ РїСЂРµРІСЊСЋ (РѕС‚РґРµР»СЊРЅРѕ РѕС‚ Р»РѕРіРёРєРё РїСЂРµРІСЊСЋ)
        if st.button(" РџРѕРєР°Р·Р°С‚СЊ РїСЂРѕРіРЅРѕР· РІР»РёСЏРЅРёСЏ РЅР° СЃС‚Р°С‚РёСЃС‚РёРєРё", type="secondary", use_container_width=True, key="btn_show_fill_preview"):
            st.session_state.show_fill_preview = True
            st.rerun()

        # в”Ђв”Ђ рџ”Ќ РџР Р•Р’Р¬Р® Р’Р›РРЇРќРРЇ (СЃ Р±РµР·РѕРїР°СЃРЅС‹Рј РґРѕСЃС‚СѓРїРѕРј Рє session_state) в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
        # рџ”§ Р“Р›РђР’РќРћР• РРЎРџР РђР’Р›Р•РќРР•: РСЃРїРѕР»СЊР·СѓРµРј .get() РІРјРµСЃС‚Рѕ РїСЂСЏРјРѕРіРѕ РґРѕСЃС‚СѓРїР°
        show_preview = st.session_state.get("show_fill_preview", False)

        if show_preview:
            strategy = fill_strategy
            st.markdown("#####  РџСЂРѕРіРЅРѕР· РІР»РёСЏРЅРёСЏ РЅР° СЃС‚Р°С‚РёСЃС‚РёРєСѓ:")

            df_preview = df_work.copy()
            num_cols = df_preview.select_dtypes(include='number').columns.tolist()
            cat_cols = df_preview.select_dtypes(include=['object', 'string', 'category']).columns.tolist()

            # РџСЂРёРјРµРЅРµРЅРёРµ СЃС‚СЂР°С‚РµРіРёРё РґР»СЏ РїСЂРµРІСЊСЋ
            if "РЈРґР°Р»РёС‚СЊ" in strategy:
                df_preview = df_preview.dropna()
                note = "(СѓРґР°Р»РµРЅРёРµ)"
            elif "РјРµРґРёР°РЅРѕР№" in strategy or "РњРµРґРёР°РЅР°" in strategy:
                for col in num_cols:
                    if df_preview[col].isnull().any():
                        df_preview[col] = df_preview[col].fillna(df_preview[col].median())
                for col in cat_cols:
                    if df_preview[col].isnull().any():
                        mode = df_preview[col].mode()[0] if not df_preview[col].mode().empty else "Unknown"
                        df_preview[col] = df_preview[col].fillna(mode)
                note = "(РјРµРґРёР°РЅР°/РјРѕРґР°)"
            elif "СЃСЂРµРґРЅРёРј" in strategy or "РЎСЂРµРґРЅРµРµ" in strategy:
                for col in num_cols:
                    if df_preview[col].isnull().any():
                        df_preview[col] = df_preview[col].fillna(df_preview[col].mean())
                for col in cat_cols:
                    if df_preview[col].isnull().any():
                        mode = df_preview[col].mode()[0] if not df_preview[col].mode().empty else "Unknown"
                        df_preview[col] = df_preview[col].fillna(mode)
                note = "(СЃСЂРµРґРЅРµРµ/РјРѕРґР°)"
            elif "РЅСѓР»С‘Рј" in strategy or "РќРѕР»СЊ" in fill_strategy:
                for col in num_cols: df_preview[col] = df_preview[col].fillna(0)
                for col in cat_cols: df_preview[col] = df_preview[col].fillna("Unknown")
                note = "(РєРѕРЅСЃС‚Р°РЅС‚Р°)"
            elif "РРЅС‚РµСЂРїРѕР»СЏС†РёСЏ" in strategy:
                for col in num_cols:
                    if df_preview[col].isnull().any():
                        df_preview[col] = df_preview[col].interpolate(method='linear')
                note = "(РёРЅС‚РµСЂРїРѕР»СЏС†РёСЏ)"
            elif "РёРЅРґРёРєР°С‚РѕСЂ" in strategy:
                for col in df_preview.columns:
                    if df_preview[col].isnull().any():
                        df_preview[f"miss_{col}"] = df_preview[col].isnull().astype(int)
                note = "(РёРЅРґРёРєР°С‚РѕСЂ)"
            else:
                note = "(Р±РµР· РёР·РјРµРЅРµРЅРёР№)"

            # РњРµС‚СЂРёРєРё (4 РєРѕР»РѕРЅРєРё)
            c_p1, c_p2, c_p3, c_p4 = st.columns(4)
            c_p1.metric("рџ“Љ Р—Р°РїРёСЃРµР№", f"{len(df_work)} в†’ {len(df_preview)}", delta=f"{len(df_preview)-len(df_work):+}")

            if num_cols:
                col = num_cols[0]
                def safe_stat(df, c, func):
                    return func(df[c]) if not df.empty and c in df.columns and df[c].notna().any() else 0.0
                m_b, s_b, d_b = safe_stat(df_work, col, np.mean), safe_stat(df_work, col, np.std), safe_stat(df_work, col, np.median)
                m_a, s_a, d_a = safe_stat(df_preview, col, np.mean), safe_stat(df_preview, col, np.std), safe_stat(df_preview, col, np.median)
                fmt = lambda x: f"{x:,.2f}".replace(',', ' ') if pd.notnull(x) and x != 0.0 else "N/A"
                delta = lambda b, a: f"{((a-b)/abs(b)*100):+.1f}%" if b != 0 and pd.notnull(b) else "0%"
                c_p2.metric("рџ“€ Mean", f"{fmt(m_b)} в†’ {fmt(m_a)}", delta=delta(m_b, m_a))
                c_p3.metric("рџ“‰ Std", f"{fmt(s_b)} в†’ {fmt(s_a)}", delta=delta(s_b, s_a))
                c_p4.metric("рџ“Љ Median", f"{fmt(d_b)} в†’ {fmt(d_a)}", delta=delta(d_b, d_a))

            # РљРЅРѕРїРєРё РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ
            st.divider()
            c_ok, c_cancel = st.columns(2)
            with c_ok:
                if st.button("рџ’ѕ РџРѕРґС‚РІРµСЂРґРёС‚СЊ РёР·РјРµРЅРµРЅРёСЏ", type="primary", use_container_width=True, key="btn_confirm_fill"):
                    # рџ”§ РЎРРќРҐР РћРќРР—РђР¦РРЇ Р’РЎР•РҐ Р РђР‘РћР§РРҐ РљРћРџРР™
                    st.session_state.df = df_preview.copy()
                    st.session_state.validation_ready = False
                    st.session_state.show_fill_preview = False
                    
                    # рџ”Ґ РЈРґР°Р»СЏРµРј РІСЃРµ СЂР°Р±РѕС‡РёРµ РєРѕРїРёРё - РѕРЅРё РїРµСЂРµСЃРѕР·РґР°РґСѓС‚СЃСЏ РёР· РѕР±РЅРѕРІР»С‘РЅРЅРѕРіРѕ df
                    work_dfs = [
                        "df_missing_work", "df_pattern_work", "df_range_work",
                        "df_outlier_work", "df_inclusion_work", "df_referential_work",
                        "df_text_work", "df_consistency_work", "df_uniqueness_work",
                        "df_regularity_work"
                    ]
                    for work_df_name in work_dfs:
                        if work_df_name in st.session_state:
                            del st.session_state[work_df_name]
                    
                    # РЎР±СЂР°СЃС‹РІР°РµРј СЂРµР·СѓР»СЊС‚Р°С‚С‹ РІР°Р»РёРґР°С†РёРё
                    if "val_results" in st.session_state:
                        del st.session_state.val_results
                    
                    st.success("вњ… РЎС‚СЂР°С‚РµРіРёСЏ РїСЂРёРјРµРЅРµРЅР°! РџРµСЂРµР·Р°РїСѓСЃС‚РёС‚Рµ РІР°Р»РёРґР°С†РёСЋ.")
                    st.rerun()
            with c_cancel:
                if st.button(" РћС‚РјРµРЅР°", use_container_width=True, key="btn_cancel_fill"):
                    st.session_state.show_fill_preview = False
                    st.rerun()

