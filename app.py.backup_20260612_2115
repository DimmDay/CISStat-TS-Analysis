                # рџ”¬ РЇР”Р Рћ IH-РђРќРђР›РР—Рђ: Р¤РЈРќРљР¦РР
                # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                def discretize_feature(series: pd.Series, sharpness: float, min_samples: int) -> pd.Series:
                    """
                    РђРґР°РїС‚РёРІРЅР°СЏ РґРёСЃРєСЂРµС‚РёР·Р°С†РёСЏ СЃ РїР°СЂР°РјРµС‚СЂРѕРј sharpness.
                    РњРµРЅСЊС€РёР№ sharpness в†’ Р±РѕР»СЊС€Рµ РёРЅС‚РµСЂРІР°Р»РѕРІ.
                    """
                    if pd.api.types.is_categorical_dtype(series) or series.nunique() <= 10:
                        return series.astype(str)

                    # РЈРґР°Р»РµРЅРёРµ РїСЂРѕРїСѓСЃРєРѕРІ РґР»СЏ РґРёСЃРєСЂРµС‚РёР·Р°С†РёРё
                    clean = series.dropna()
                    if len(clean) < min_samples * 2:
                        return series.astype(str)  # fallback

                    # РћС†РµРЅРєР° РѕРїС‚РёРјР°Р»СЊРЅРѕРіРѕ С‡РёСЃР»Р° Р±РёРЅРѕРІ С‡РµСЂРµР· sharpness
                    n_bins = max(2, min(50, int(1 / sharpness)))

                    # РљРІР°РЅС‚РёР»СЊРЅР°СЏ РґРёСЃРєСЂРµС‚РёР·Р°С†РёСЏ (СѓСЃС‚РѕР№С‡РёРІР° Рє РІС‹Р±СЂРѕСЃР°Рј)
                    try:
                        bins = pd.qcut(clean, q=n_bins, duplicates='drop', labels=False)
                        # Р’РѕСЃСЃС‚Р°РЅРѕРІР»РµРЅРёРµ РёРЅРґРµРєСЃР° СЃ СЃРѕС…СЂР°РЅРµРЅРёРµРј РїСЂРѕРїСѓСЃРєРѕРІ
                        result = pd.Series(index=series.index, dtype=object)
                        result[clean.index] = bins.astype(str)
                        result[series.isna()] = '_MISSING_'
                        return result
                    except Exception:
                        # Fallback РЅР° СЂР°РІРЅРѕРјРµСЂРЅСѓСЋ РґРёСЃРєСЂРµС‚РёР·Р°С†РёСЋ
                        bins = pd.cut(clean, bins=n_bins, labels=False)
                        result = pd.Series(index=series.index, dtype=object)
                        result[clean.index] = bins.astype(str)
                        result[series.isna()] = '_MISSING_'
                        return result

                def shannon_entropy(probabilities: np.ndarray, base: float = 2) -> float:
                    """Р’С‹С‡РёСЃР»РµРЅРёРµ СЌРЅС‚СЂРѕРїРёРё РЁРµРЅРЅРѕРЅР°."""
                    probabilities = probabilities[probabilities > 0]  # СѓР±СЂР°С‚СЊ РЅСѓР»Рё
                    return -np.sum(probabilities * np.log(probabilities) / np.log(base))

                def mutual_information(x_disc: pd.Series, y_disc: pd.Series, base: float = 2) -> float:
                    """
                    РћС†РµРЅРєР° РІР·Р°РёРјРЅРѕР№ РёРЅС„РѕСЂРјР°С†РёРё С‡РµСЂРµР· СЃРѕРІРјРµСЃС‚РЅРѕРµ СЂР°СЃРїСЂРµРґРµР»РµРЅРёРµ.
                    """
                    # РЎРѕРІРјРµСЃС‚РЅР°СЏ С‚Р°Р±Р»РёС†Р° С‡Р°СЃС‚РѕС‚
                    joint = pd.crosstab(x_disc, y_disc)
                    joint_prob = joint.values / joint.values.sum()

                    # РњР°СЂРіРёРЅР°Р»СЊРЅС‹Рµ СЂР°СЃРїСЂРµРґРµР»РµРЅРёСЏ
                    px = joint_prob.sum(axis=1)
                    py = joint_prob.sum(axis=0)

                    # MI = ОЈ p(x,y) * log(p(x,y) / (p(x)*p(y)))
                    mi = 0.0
                    for i in range(joint_prob.shape[0]):
                        for j in range(joint_prob.shape[1]):
                            if joint_prob[i, j] > 0 and px[i] > 0 and py[j] > 0:
                                mi += joint_prob[i, j] * np.log(joint_prob[i, j] / (px[i] * py[j]))
                    return mi / np.log(base)  # РєРѕРЅРІРµСЂС‚Р°С†РёСЏ РІ РЅСѓР¶РЅРѕРµ РѕСЃРЅРѕРІР°РЅРёРµ

                def compute_r_metric(x: pd.Series, y: pd.Series, sharpness: float, min_samples: int) -> dict:
                    """
                    Р’С‹С‡РёСЃР»РµРЅРёРµ РЅРѕСЂРјРёСЂРѕРІР°РЅРЅРѕР№ РјРµСЂС‹ СЃРІСЏР·Рё R(Y|X) = I(X;Y) / H(Y).
                    Р’РѕР·РІСЂР°С‰Р°РµС‚ СЃР»РѕРІР°СЂСЊ СЃ РјРµС‚СЂРёРєР°РјРё.
                    """
                    # Р”РёСЃРєСЂРµС‚РёР·Р°С†РёСЏ
                    x_disc = discretize_feature(x, sharpness, min_samples)
                    y_disc = discretize_feature(y, sharpness, min_samples)

                    # РџСЂРѕРІРµСЂРєР° РєРѕРЅСЃС‚Р°РЅС‚РЅС‹С… РїСЂРёР·РЅР°РєРѕРІ
                    if x_disc.nunique() <= 1:
                        return {"R": 0.0, "MI": 0.0, "H_X": 0.0, "H_Y": 0.0, 
                                "n_bins_X": 1, "n_bins_Y": y_disc.nunique(),
                                "error": "РџСЂРёР·РЅР°Рє X РєРѕРЅСЃС‚Р°РЅС‚РµРЅ"}
                    
                    # Р­РЅС‚СЂРѕРїРёРё
                    _, counts_y = np.unique(y_disc, return_counts=True)
                    py = counts_y / counts_y.sum()
                    h_y = shannon_entropy(py)

                    if h_y < 1e-10:  # С†РµР»РµРІР°СЏ РїРµСЂРµРјРµРЅРЅР°СЏ РєРѕРЅСЃС‚Р°РЅС‚Р°
                        return {"R": 0.0, "MI": 0.0, "H_X": 0.0, "H_Y": 0.0, "error": "H(Y) в‰€ 0"}

                    # Р’Р·Р°РёРјРЅР°СЏ РёРЅС„РѕСЂРјР°С†РёСЏ
                    mi = mutual_information(x_disc, y_disc)

                    # РќРѕСЂРјРёСЂРѕРІР°РЅРЅР°СЏ РјРµС‚СЂРёРєР°
                    r_value = min(1.0, mi / h_y)  # Р·Р°С‰РёС‚Р° РѕС‚ С‡РёСЃР»РµРЅРЅС‹С… РѕС€РёР±РѕРє

                    # Р­РЅС‚СЂРѕРїРёСЏ РїСЂРёР·РЅР°РєР°
                    _, counts_x = np.unique(x_disc, return_counts=True)
                    px = counts_x / counts_x.sum()
                    h_x = shannon_entropy(px)

                    return {
                        "R": r_value,
                        "MI": mi,
                        "H_X": h_x,
                        "H_Y": h_y,
                        "n_bins_X": x_disc.nunique(),
