                st.markdown(f"<div style='font-size: 14px; font-weight: 600; color: {roughness_color};'>"
                        f"{roughness_formatted}</div>", unsafe_allow_html=True)
            
            with c_diag4:
                st.markdown("**Р РµРєРѕРјРµРЅРґР°С†РёСЏ**")
                if noise_ratio > 0.5:
                    rec_text, rec_color = "РќСѓР¶РЅРѕ СЃРіР»Р°Р¶РёРІР°РЅРёРµ", "#dc2626"
                elif noise_ratio > 0.3:
                    rec_text, rec_color = "Р–РµР»Р°С‚РµР»СЊРЅРѕ", "#d97706"
                else:
                    rec_text, rec_color = "РќРµ С‚СЂРµР±СѓРµС‚СЃСЏ", "#16a34a"
                st.markdown(f"<div style='font-size: 14px; font-weight: 600; color: {rec_color};'>"
                        f"{rec_text}</div>", unsafe_allow_html=True)
            
            # РћС‚СЃС‚СѓРї
            st.markdown("<div style='height: 30px;'></div>", unsafe_allow_html=True)
            
            # в”Ђв”Ђ РўР•РҐРќРР§Р•РЎРљРђРЇ РЎРџР РђР’РљРђ в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
            with st.expander("Р¦РµР»Рё СЃСѓР±РјРѕРґСѓР»СЏ вЃћ РЎРіР»Р°Р¶РёРІР°РЅРёРµ РІСЂРµРјРµРЅРЅС‹С… СЂСЏРґРѕРІ", expanded=False):
                st.markdown("""
                **Р—Р°С‡РµРј РЅСѓР¶РЅРѕ СЃРіР»Р°Р¶РёРІР°РЅРёРµ:**
                - **Р’С‹РґРµР»РµРЅРёРµ С‚СЂРµРЅРґР°** вЂ” СѓРґР°Р»РµРЅРёРµ РІС‹СЃРѕРєРѕС‡Р°СЃС‚РѕС‚РЅРѕРіРѕ С€СѓРјР°
                - **РЈР»СѓС‡С€РµРЅРёРµ РїСЂРѕРіРЅРѕР·Р°** вЂ” РјРѕРґРµР»Рё Р»СѓС‡С€Рµ СЂР°Р±РѕС‚Р°СЋС‚ РЅР° "С‡РёСЃС‚РѕРј" СЃРёРіРЅР°Р»Рµ
                - **РЎС‚Р°Р±РёР»РёР·Р°С†РёСЏ РѕС†РµРЅРѕРє** вЂ” РјРµРЅСЊС€Рµ Р»РѕР¶РЅС‹С… СЃСЂР°Р±Р°С‚С‹РІР°РЅРёР№ РЅР° РІС‹Р±СЂРѕСЃР°С…
                - **РџРѕРґРіРѕС‚РѕРІРєР° РґР»СЏ ML** вЂ” СЃРіР»Р°Р¶РµРЅРЅС‹Рµ РїСЂРёР·РЅР°РєРё СѓР»СѓС‡С€Р°СЋС‚ РєР°С‡РµСЃС‚РІРѕ
                
                **РљРѕРіРґР° РїСЂРёРјРµРЅСЏС‚СЊ:**
                - вњ… Р СЏРґ СЃРѕРґРµСЂР¶РёС‚ Р·РЅР°С‡РёС‚РµР»СЊРЅС‹Р№ С€СѓРј (noise_ratio > 0.3)
                - вњ… РќСѓР¶РЅРѕ РІС‹РґРµР»РёС‚СЊ С‚СЂРµРЅРґ РґР»СЏ РёРЅС‚РµСЂРїСЂРµС‚Р°С†РёРё
                - вњ… РџРµСЂРµРґ РґРµРєРѕРјРїРѕР·РёС†РёРµР№ (РµСЃР»Рё STL РЅРµ СЃРїСЂР°РІР»СЏРµС‚СЃСЏ СЃ С€СѓРјРѕРј)
                - вќЊ **РќР• РїСЂРёРјРµРЅСЏС‚СЊ** РїРµСЂРµРґ РґРёС„С„РµСЂРµРЅС†РёСЂРѕРІР°РЅРёРµРј (РёСЃРєР°Р¶Р°РµС‚ СЃС‚Р°С†РёРѕРЅР°СЂРЅРѕСЃС‚СЊ)
                - вќЊ **РќР• РїСЂРёРјРµРЅСЏС‚СЊ** РґР»СЏ СЂСЏРґРѕРІ СЃ РІР°Р¶РЅС‹РјРё РєСЂР°С‚РєРѕСЃСЂРѕС‡РЅС‹РјРё РєРѕР»РµР±Р°РЅРёСЏРјРё
                
                **РњРµС‚РѕРґС‹ СЃРіР»Р°Р¶РёРІР°РЅРёСЏ:**
                
                | РњРµС‚РѕРґ | Р¤РѕСЂРјСѓР»Р° | РџР°СЂР°РјРµС‚СЂС‹ | РљРѕРіРґР° РёСЃРїРѕР»СЊР·РѕРІР°С‚СЊ |
