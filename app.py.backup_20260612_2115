                    st.markdown(f"- **РЎРѕРѕС‚РІРµС‚СЃС‚РІРёР№:** `{valid_count}`")

                    # рџ”Ќ РџРѕРєР°Р·Р°С‚СЊ РїСЂРёРјРµСЂС‹ РЅРµРєРѕСЂСЂРµРєС‚РЅС‹С… Р·РЅР°С‡РµРЅРёР№
                    if col_name and col_name in df_work.columns:
                        try:
                            # РЎРѕР·РґР°С‘Рј РјР°СЃРєСѓ РЅР°СЂСѓС€РµРЅРёР№ РўРћР›Р¬РљРћ РґР»СЏ СЌС‚РѕР№ РєРѕР»РѕРЅРєРё
                            mask_invalid = ~df_work[col_name].astype(str).str.fullmatch(pattern, na=False)
