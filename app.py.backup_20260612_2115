                        inferred_freq = pd.infer_freq(analysis_series.index.drop_duplicates().sort_values())
                        freq_result = f"вњ… {inferred_freq}" if inferred_freq else "вљ пёЏ РќРµСЂРµРіСѓР»СЏСЂРЅР°СЏ"

                        results_data.append({
