        # рџ”§ Р”РћР‘РђР’Р›Р•РќРћ: РЎРµР»РµРєС‚РѕСЂ СЃС‚РѕР»Р±С†Р°
        target_col = st.selectbox(
            " Р’С‹Р±РµСЂРёС‚Рµ С‡РёСЃР»РѕРІРѕР№ РїСЂРёР·РЅР°Рє РґР»СЏ СЃРїРµРєС‚СЂР°Р»СЊРЅРѕРіРѕ Р°РЅР°Р»РёР·Р°:",
            options=num_cols,
            index=0,
            key="spectral_analysis_target_col",
            help="Р’С‹Р±РµСЂРёС‚Рµ С†РµР»РµРІСѓСЋ РїРµСЂРµРјРµРЅРЅСѓСЋ РІСЂРµРјРµРЅРЅРѕРіРѕ СЂСЏРґР° РґР»СЏ Р°РЅР°Р»РёР·Р° С‡Р°СЃС‚РѕС‚РЅС‹С… С…Р°СЂР°РєС‚РµСЂРёСЃС‚РёРє"
        )
        
        # РџРѕРґРіРѕС‚РѕРІРєР° РґР°РЅРЅС‹С… РґР»СЏ РІС‹Р±СЂР°РЅРЅРѕРіРѕ СЃС‚РѕР»Р±С†Р°
        if ts_mode_active:
            df_ts_temp = df_ts.copy()
            if target_col in df_ts_temp.columns:
                analysis_series = df_ts_temp[target_col].resample('D').mean().dropna().astype(float)
            else:
                analysis_series = pd.Series()
        else:
            if target_col in df_filtered.columns:
                analysis_series = df_filtered[target_col].dropna().astype(float)
            else:
                analysis_series = pd.Series()
        
        # РџСЂРѕРІРµСЂРєР° РґРѕСЃС‚Р°С‚РѕС‡РЅРѕСЃС‚Рё РґР°РЅРЅС‹С…
        if len(analysis_series) >= 30:
            st.success(f"вњ… **РђРЅР°Р»РёР·РёСЂСѓРµС‚СЃСЏ:** `{target_col}` | **Р”Р»РёРЅР° СЂСЏРґР°:** {len(analysis_series)} РЅР°Р±Р»СЋРґРµРЅРёР№")
            
            # в”Ђв”Ђ 1. ACF Р PACF (РђРІС‚РѕРєРѕСЂСЂРµР»СЏС†РёСЏ) в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
            with st.expander("в—Џ РђРІС‚РѕРєРѕСЂСЂРµР»СЏС†РёРѕРЅРЅС‹Р№ Р°РЅР°Р»РёР· (ACF/PACF)", expanded=False):
                st.markdown(f"**РђРЅР°Р»РёР·РёСЂСѓРµРјС‹Р№ РїСЂРёР·РЅР°Рє:** `{target_col}`")
                st.markdown("""
                **РќР°Р·РЅР°С‡РµРЅРёРµ:** РћР±РЅР°СЂСѓР¶РµРЅРёРµ СЃРµР·РѕРЅРЅРѕСЃС‚Рё С‡РµСЂРµР· Р°РЅР°Р»РёР· РєРѕСЂСЂРµР»СЏС†РёРё СЂСЏРґР° СЃ РµРіРѕ Р»Р°РіР°РјРё.                            
                **РђР»РіРѕСЂРёС‚Рј:** Р Р°СЃС‡РµС‚ РєРѕСЂСЂРµР»СЏС†РёРё РјРµР¶РґСѓ РЅР°Р±Р»СЋРґРµРЅРёСЏРјРё СЃ СЂР°Р·РЅС‹РјРё РІСЂРµРјРµРЅРЅС‹РјРё СЃРґРІРёРіР°РјРё.                           
                **Р’Р»РёСЏРЅРёРµ РЅР° РјРѕРґРµР»СЊ:** РћРїСЂРµРґРµР»СЏРµС‚ РїР°СЂР°РјРµС‚СЂС‹ `p`, `q` РґР»СЏ ARIMA Рё СЃРµР·РѕРЅРЅРѕСЃС‚СЊ `m`.
                """)

                from statsmodels.graphics.tsaplots import plot_acf, plot_pacf

                c1, c2 = st.columns(2)
                max_lag = min(60, len(analysis_series) // 4)

                with c1:
                    st.markdown("**ACF (Autocorrelation Function)**")
                    fig_acf, ax_acf = plt.subplots(figsize=(8, 3))
                    plot_acf(analysis_series, lags=max_lag, ax=ax_acf, alpha=0.05)
                    ax_acf.set_title(f"РђРІС‚РѕРєРѕСЂСЂРµР»СЏС†РёРѕРЅРЅР°СЏ С„СѓРЅРєС†РёСЏ (ACF) вЂ” {target_col}", fontsize=10)
                    st.pyplot(fig_acf, use_container_width=True)

                with c2:
                    st.markdown("**PACF (Partial Autocorrelation Function)**")
                    fig_pacf, ax_pacf = plt.subplots(figsize=(8, 3))
                    plot_pacf(analysis_series, lags=max_lag, ax=ax_pacf, alpha=0.05)
                    ax_pacf.set_title(f"Р§Р°СЃС‚РЅР°СЏ Р°РІС‚РѕРєРѕСЂСЂРµР»СЏС†РёСЏ (PACF) вЂ” {target_col}", fontsize=10)
                    st.pyplot(fig_pacf, use_container_width=True)

                # РђРІС‚РѕРјР°С‚РёС‡РµСЃРєРѕРµ РѕРїСЂРµРґРµР»РµРЅРёРµ СЃРµР·РѕРЅРЅРѕСЃС‚Рё РёР· ACF
                acf_values = acf(analysis_series, nlags=max_lag)
                confidence = 1.96 / np.sqrt(len(analysis_series))
                significant_lags = np.where(np.abs(acf_values) > confidence)[0][1:]  # Р‘РµР· lag=0

                if len(significant_lags) > 0:
                    # РС‰РµРј РїРµСЂРёРѕРґРёС‡РµСЃРєРёРµ РїРёРєРё
                    seasonal_candidates = []
                    for i, lag in enumerate(significant_lags):
                        if i > 0 and lag - significant_lags[i-1] < 3:
                            continue
                        if lag > 2:
                            seasonal_candidates.append(int(lag))

                    if seasonal_candidates:
                        st.success(f"вњ… **РћР±РЅР°СЂСѓР¶РµРЅР° СЃРµР·РѕРЅРЅРѕСЃС‚СЊ** СЃ РїРµСЂРёРѕРґР°РјРё: {seasonal_candidates[:3]}")
                        st.info(f"в„№пёЏ **Р РµРєРѕРјРµРЅРґР°С†РёСЏ:** РСЃРїРѕР»СЊР·СѓР№С‚Рµ SARIMA СЃ seasonal_order=(..., m={seasonal_candidates[0]})")
                else:
                    st.info("в„№пёЏ РЇРІРЅР°СЏ СЃРµР·РѕРЅРЅРѕСЃС‚СЊ РЅРµ РѕР±РЅР°СЂСѓР¶РµРЅР°")

            # в”Ђв”Ђ 2. FFT (Р‘С‹СЃС‚СЂРѕРµ РїСЂРµРѕР±СЂР°Р·РѕРІР°РЅРёРµ Р¤СѓСЂСЊРµ) в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
            with st.expander("в—Џ РџСЂРµРѕР±СЂР°Р·РѕРІР°РЅРёРµ Р¤РЈР Р¬Р• (FFT)", expanded=False):
                st.markdown(f"**РђРЅР°Р»РёР·РёСЂСѓРµРјС‹Р№ РїСЂРёР·РЅР°Рє:** `{target_col}`")
                st.markdown("""
                **РќР°Р·РЅР°С‡РµРЅРёРµ:** Р Р°Р·Р»РѕР¶РµРЅРёРµ РІСЂРµРјРµРЅРЅРѕРіРѕ СЂСЏРґР° РЅР° РіР°СЂРјРѕРЅРёС‡РµСЃРєРёРµ СЃРѕСЃС‚Р°РІР»СЏСЋС‰РёРµ.                                    
                **РђР»РіРѕСЂРёС‚Рј:** FFT РїСЂРµРѕР±СЂР°Р·СѓРµС‚ СЃРёРіРЅР°Р» РёР· РІСЂРµРјРµРЅРЅРѕР№ РѕР±Р»Р°СЃС‚Рё РІ С‡Р°СЃС‚РѕС‚РЅСѓСЋ.                                       
                **Р’Р»РёСЏРЅРёРµ РЅР° РјРѕРґРµР»СЊ:** Р’С‹СЏРІР»СЏРµС‚ РґРѕРјРёРЅРёСЂСѓСЋС‰РёРµ С‡Р°СЃС‚РѕС‚С‹ РґР»СЏ СЃРѕР·РґР°РЅРёСЏ Fourier features.
                """)

                # РџРѕРґРіРѕС‚РѕРІРєР° РґР°РЅРЅС‹С…
                n = len(analysis_series)
                y = analysis_series.values - analysis_series.mean()  # Р¦РµРЅС‚СЂРёСЂСѓРµРј

                # FFT
                yf = fft(y)
                xf = fftfreq(n, 1)[:n//2]
                amplitude = 2.0/n * np.abs(yf[0:n//2])

                # РџРѕРёСЃРє РїРёРєРѕРІ
                peaks, properties = find_peaks(amplitude, height=np.mean(amplitude) + np.std(amplitude))
                dominant_periods = [1/xf[p] for p in peaks if xf[p] > 0]

                # Р’РёР·СѓР°Р»РёР·Р°С†РёСЏ
                c1, c2 = st.columns([2, 1])

                with c1:
                    fig_fft, ax_fft = plt.subplots(figsize=(10, 3))
                    ax_fft.plot(xf[:n//4], amplitude[:n//4], 'b-', linewidth=1)
                    ax_fft.plot(xf[peaks], amplitude[peaks], 'ro', markersize=5, label='РџРёРєРё')
                    ax_fft.set_xlabel('Р§Р°СЃС‚РѕС‚Р° (С†РёРєР»С‹/РµРґРёРЅРёС†Р° РІСЂРµРјРµРЅРё)')
                    ax_fft.set_ylabel('РђРјРїР»РёС‚СѓРґР°')
                    ax_fft.set_title(f'РђРјРїР»РёС‚СѓРґРЅС‹Р№ СЃРїРµРєС‚СЂ (FFT) вЂ” {target_col}')
                    ax_fft.legend()
                    ax_fft.grid(True, alpha=0.3)
                    st.pyplot(fig_fft, use_container_width=True)

                with c2:
                    st.markdown("**Р”РѕРјРёРЅРёСЂСѓСЋС‰РёРµ РїРµСЂРёРѕРґС‹:**")
                    if dominant_periods:
                        for i, period in enumerate(sorted(dominant_periods)[:5], 1):
                            st.metric(f"РџРµСЂРёРѕРґ {i}", f"{period:.1f}")

                        st.info(f"в„№пёЏ **Р РµРєРѕРјРµРЅРґР°С†РёСЏ:** Р”РѕР±Р°РІСЊС‚Рµ Fourier features СЃ РїРµСЂРёРѕРґР°РјРё {sorted(dominant_periods)[:3]}")
                    else:
                        st.info("РЇРІРЅС‹Рµ РїРµСЂРёРѕРґРёС‡РЅРѕСЃС‚Рё РЅРµ РѕР±РЅР°СЂСѓР¶РµРЅС‹")

                # РџСЂРѕРіРЅРѕР· СЃ РёСЃРїРѕР»СЊР·РѕРІР°РЅРёРµРј Р·РЅР°С‡РёРјС‹С… РіР°СЂРјРѕРЅРёРє
                if len(peaks) > 0 and st.checkbox(" РџРѕРєР°Р·Р°С‚СЊ РїСЂРѕРіРЅРѕР· РїРѕ Р·РЅР°С‡РёРјС‹Рј РіР°СЂРјРѕРЅРёРєР°Рј", key="fft_forecast"):
                    # Р‘РµСЂРµРј С‚РѕРї-5 РіР°СЂРјРѕРЅРёРє
                    top_peaks = peaks[np.argsort(amplitude[peaks])[-5:]]

                    # Р РµРєРѕРЅСЃС‚СЂСѓРєС†РёСЏ СЃРёРіРЅР°Р»Р°
                    reconstructed = np.zeros(n)
                    for p in top_peaks:
                        if xf[p] > 0:
                            reconstructed += (amplitude[p] * np.cos(2 * np.pi * xf[p] * np.arange(n) + np.angle(yf[p])))

                    reconstructed += analysis_series.mean()

                    # РР—РњР•РќР•РќРћ: figsize=(10, 2.5) РІРјРµСЃС‚Рѕ (10, 3) РґР»СЏ РѕРґРёРЅР°РєРѕРІРѕР№ РІС‹СЃРѕС‚С‹ СЃ FFT
                    fig_rec, ax_rec = plt.subplots(figsize=(10, 2.5))
                    ax_rec.plot(analysis_series.index[:100], analysis_series.values[:100], 'b-', alpha=0.5, label='РСЃС…РѕРґРЅС‹Р№ СЂСЏРґ')
                    ax_rec.plot(analysis_series.index[:100], reconstructed[:100], 'r-', linewidth=2, label='РџСЂРѕРіРЅРѕР· (FFT)')
                    ax_rec.set_title(f'Р РµРєРѕРЅСЃС‚СЂСѓРєС†РёСЏ СЂСЏРґР° РїРѕ Р·РЅР°С‡РёРјС‹Рј РіР°СЂРјРѕРЅРёРєР°Рј FFT вЂ” {target_col}', fontsize=10)
                    ax_rec.legend(fontsize=8)
                    plt.tight_layout()  # РћРїС‚РёРјРёР·Р°С†РёСЏ РѕС‚СЃС‚СѓРїРѕРІ
                    st.pyplot(fig_rec, use_container_width=True)

            # в”Ђв”Ђ 3. РџР•Р РРћР”РћР“Р РђРњРњРђ в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
            with st.expander("в—Џ РџРµСЂРёРѕРґРѕРіСЂР°РјРјР° (Spectral Density)", expanded=False):
                st.markdown(f"**РђРЅР°Р»РёР·РёСЂСѓРµРјС‹Р№ РїСЂРёР·РЅР°Рє:** `{target_col}`")
                st.markdown("""
                **РќР°Р·РЅР°С‡РµРЅРёРµ:** РћС†РµРЅРєР° СЃРїРµРєС‚СЂР°Р»СЊРЅРѕР№ РїР»РѕС‚РЅРѕСЃС‚Рё РјРѕС‰РЅРѕСЃС‚Рё.                                                    
                **РђР»РіРѕСЂРёС‚Рј:** РњРµС‚РѕРґ РЈСЌР»С‡Р° РґР»СЏ СЃРіР»Р°Р¶РёРІР°РЅРёСЏ СЃРїРµРєС‚СЂР°.                                                             
                **Р’Р»РёСЏРЅРёРµ РЅР° РјРѕРґРµР»СЊ:** РџРѕРєР°Р·С‹РІР°РµС‚ РјРѕС‰РЅРѕСЃС‚СЊ СЂР°Р·Р»РёС‡РЅС‹С… С‡Р°СЃС‚РѕС‚РЅС‹С… РєРѕРјРїРѕРЅРµРЅС‚.
                """)

                from scipy.signal import periodogram, welch

                c1, c2 = st.columns(2)

                # РџРµСЂРёРѕРґРѕРіСЂР°РјРјР°
                with c1:
                    st.markdown("**РџРµСЂРёРѕРґРѕРіСЂР°РјРјР°**")
                    freq_per, pxx_per = periodogram(analysis_series.values, fs=1.0, window='hann')

                    fig_per, ax_per = plt.subplots(figsize=(8, 3))
                    ax_per.semilogy(freq_per, pxx_per)
                    ax_per.set_xlabel('Р§Р°СЃС‚РѕС‚Р°')
                    ax_per.set_ylabel('РЎРїРµРєС‚СЂР°Р»СЊРЅР°СЏ РїР»РѕС‚РЅРѕСЃС‚СЊ РјРѕС‰РЅРѕСЃС‚Рё')
                    ax_per.set_title(f'РџРµСЂРёРѕРґРѕРіСЂР°РјРјР° вЂ” {target_col}')
                    ax_per.grid(True, alpha=0.3)
                    st.pyplot(fig_per, use_container_width=True)

                # РњРµС‚РѕРґ РЈСЌР»С‡Р°
                with c2:
                    st.markdown("**РњРµС‚РѕРґ РЈСЌР»С‡Р° (СЃРіР»Р°Р¶РµРЅРЅС‹Р№)**")
                    freq_welch, pxx_welch = welch(analysis_series.values, fs=1.0, nperseg=min(256, len(analysis_series)//4))

                    fig_welch, ax_welch = plt.subplots(figsize=(8, 3))
                    ax_welch.semilogy(freq_welch, pxx_welch)
                    ax_welch.set_xlabel('Р§Р°СЃС‚РѕС‚Р°')
                    ax_welch.set_ylabel('PSD')
                    ax_welch.set_title(f'Welch PSD вЂ” {target_col}')
                    ax_welch.grid(True, alpha=0.3)
                    st.pyplot(fig_welch, use_container_width=True)

                # Р—РЅР°С‡РёРјС‹Рµ С‡Р°СЃС‚РѕС‚С‹
                peaks_welch, _ = find_peaks(pxx_welch, height=np.median(pxx_welch)*2)

                if len(peaks_welch) > 0:
                    significant_freqs = freq_welch[peaks_welch]
                    significant_periods = 1/significant_freqs[significant_freqs > 0]

                    st.success(f"вњ… **Р—РЅР°С‡РёРјС‹Рµ РїРµСЂРёРѕРґС‹:** {', '.join([f'{p:.1f}' for p in sorted(significant_periods)[:5]])}")

            # в”Ђв”Ђ 4. WAVELET-РџР Р•РћР‘Р РђР—РћР’РђРќРР• в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
            with st.expander("в—Џ Р’РµР№РІР»РµС‚-РїСЂРµРѕР±СЂР°Р·РѕРІР°РЅРёРµ (Wavelet Transform)", expanded=False):
                st.markdown(f"**РђРЅР°Р»РёР·РёСЂСѓРµРјС‹Р№ РїСЂРёР·РЅР°Рє:** `{target_col}`")
                st.markdown("""
                **РќР°Р·РЅР°С‡РµРЅРёРµ:** РђРЅР°Р»РёР· С‡Р°СЃС‚РѕС‚ РІРѕ РІСЂРµРјРµРЅРё РґР»СЏ РЅРµСЃС‚Р°С†РёРѕРЅР°СЂРЅС‹С… СЂСЏРґРѕРІ.                                               
                **РђР»РіРѕСЂРёС‚Рј:** Continuous Wavelet Transform (CWT) СЃ РІРµР№РІР»РµС‚РѕРј РњРѕСЂР»Рµ.                                            
                **Р’Р»РёСЏРЅРёРµ РЅР° РјРѕРґРµР»СЊ:** РџРѕРєР°Р·С‹РІР°РµС‚, РљРћР“Р”Рђ РїСЂРѕРёСЃС…РѕРґСЏС‚ С†РёРєР»РёС‡РµСЃРєРёРµ РёР·РјРµРЅРµРЅРёСЏ.
                """)

                try:
                    import pywt
                    from scipy import signal

                    # CWT
                    widths = np.arange(1, min(128, len(analysis_series)//4))
                    cwtmatr, freqs_cwt = pywt.cwt(analysis_series.values - analysis_series.mean(),
                                                widths, 'morl', sampling_period=1)

                    # РЈСЃСЂРµРґРЅРµРЅРЅС‹Р№ СЃРїРµРєС‚СЂ РїРѕ РІСЂРµРјРµРЅРё
                    mean_power = np.mean(np.abs(cwtmatr), axis=1)

                    # в”Ђв”Ђ Р“РћР РР—РћРќРўРђР›Р¬РќРћР• Р РђРЎРџРћР›РћР–Р•РќРР• РЎ Р•Р”РРќРћР™ РћРЎР¬Р® Y в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5),
                                                    gridspec_kw={'width_ratios': [3, 1]},
                                                    sharey=True)  # рџ”‘ РћР‘Р©РђРЇ РћРЎР¬ Y!

