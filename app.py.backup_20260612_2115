    def _calc_ts_props(series: pd.Series) -> dict:
        """Р‘С‹СЃС‚СЂС‹Р№ СЂР°СЃС‡С‘С‚ РєР»СЋС‡РµРІС‹С… РјРµС‚СЂРёРє РґР»СЏ СЃСЂР°РІРЅРµРЅРёСЏ Р”Рѕ/РџРѕСЃР»Рµ."""
        props = {}
        if len(series) < 30:
            return {"error": "РќРµРґРѕСЃС‚Р°С‚РѕС‡РЅРѕ РґР°РЅРЅС‹С… (<30 С‚РѕС‡РµРє)"}
        try:
            from statsmodels.tsa.stattools import adfuller
            from statsmodels.stats.diagnostic import acorr_ljungbox
            from scipy import stats
            from scipy.stats import linregress

            # 1. ADF Test (СЃС‚Р°С†РёРѕРЅР°СЂРЅРѕСЃС‚СЊ)
            adf_res = adfuller(series, autolag='AIC')
            props['adf_p'] = adf_res[1]
            props['adf_stat'] = "вњ… РЎС‚Р°С†РёРѕРЅР°СЂРµРЅ" if adf_res[1] < 0.05 else "вќЊ РќРµСЃС‚Р°С†РёРѕРЅР°СЂРµРЅ"

            # 2. Ljung-Box Test (Р°РІС‚РѕРєРѕСЂСЂРµР»СЏС†РёСЏ)
            lb_res = acorr_ljungbox(series, lags=[10])
            lb_p = lb_res['lb_pvalue'].iloc[0] if isinstance(lb_res, pd.DataFrame) else lb_res[1][0]
            props['lb_p'] = lb_p
            props['lb_stat'] = "вњ… Р‘РµР»С‹Р№ С€СѓРј" if lb_p > 0.05 else "вљ пёЏ Р•СЃС‚СЊ РђРљ"

            # 3. Jarque-Bera Test (РЅРѕСЂРјР°Р»СЊРЅРѕСЃС‚СЊ)
            jb_res = stats.jarque_bera(series)
            jb_p = jb_res.pvalue if hasattr(jb_res, 'pvalue') else jb_res[1]
            props['jb_p'] = jb_p
            props['jb_stat'] = "вњ… РќРѕСЂРјР°Р»СЊРЅРѕ" if jb_p > 0.05 else "вљ пёЏ РћС‚РєР»РѕРЅРµРЅРёРµ"

            # 4. RВІ С‚СЂРµРЅРґР° (РґРµС‚РµСЂРјРёРЅРёСЂРѕРІР°РЅРЅРѕСЃС‚СЊ)
            slope, _, r_val, _, _ = linregress(range(len(series)), series)
            props['r2'] = r_val**2
            props['r2_stat'] = "Р”РµС‚РµСЂРјРёРЅРёСЂРѕРІР°РЅРЅС‹Р№" if r_val**2 >= 0.7 else "РЎС‚РѕС…Р°СЃС‚РёС‡РµСЃРєРёР№"
        except Exception as e:
            props['error'] = str(e)
        return props

    def _show_comparison_table(props_before: dict, props_after: dict, stage: str):
        """РћС‚РѕР±СЂР°Р¶Р°РµС‚ С‚Р°Р±Р»РёС†Сѓ СЃСЂР°РІРЅРµРЅРёСЏ Р”Рѕ/РџРѕСЃР»Рµ СЃ С†РІРµС‚РѕРІС‹РјРё РёРЅРґРёРєР°С‚РѕСЂР°РјРё."""
        metrics = [
            ('adf_p', 'ADF p-value', 'lower', 'РЎС‚Р°С†РёРѕРЅР°СЂРЅРѕСЃС‚СЊ'),
            ('lb_p', 'Ljung-Box p-value', 'higher', 'РђРІС‚РѕРєРѕСЂСЂРµР»СЏС†РёСЏ'),
            ('jb_p', 'Jarque-Bera p-value', 'higher', 'РќРѕСЂРјР°Р»СЊРЅРѕСЃС‚СЊ'),
            ('r2', 'RВІ С‚СЂРµРЅРґР°', 'neutral', 'Р”РµС‚РµСЂРјРёРЅРёСЂРѕРІР°РЅРЅРѕСЃС‚СЊ')
        ]
        comp_data = []
        for key, name, goal, desc in metrics:
            b_val = props_before.get(key)
            a_val = props_after.get(key)
            if b_val is None or a_val is None:
                continue

            diff = a_val - b_val
            status, rec = "вљ пёЏ РќРµР№С‚СЂР°Р»СЊРЅРѕ", "РќРµС‚ СЃСѓС‰РµСЃС‚РІРµРЅРЅРѕРіРѕ РІР»РёСЏРЅРёСЏ"

            if goal == 'lower':  # Р§РµРј РјРµРЅСЊС€Рµ, С‚РµРј Р»СѓС‡С€Рµ (ADF)
                if a_val < b_val and a_val < 0.05:
                    status, rec = "вњ… РЈР»СѓС‡С€РµРЅРёРµ", "Р СЏРґ СЃС‚Р°Р» СЃС‚Р°С†РёРѕРЅР°СЂРЅРµРµ. РџРѕРґС…РѕРґРёС‚ РґР»СЏ ARIMA/ML."
                elif a_val < b_val:
                    status, rec = "вњ… Р”РёРЅР°РјРёРєР°+", "Р—РЅР°С‡РµРЅРёРµ СЃРЅРёР·РёР»РѕСЃСЊ, РЅРѕ РµС‰С‘ РЅРµ СЃС‚Р°С†РёРѕРЅР°СЂРЅРѕ."
                else:
                    status, rec = "вќЊ РЈС…СѓРґС€РµРЅРёРµ", "РўСЂРµРЅРґ/РЅРµСЃС‚Р°С†РёРѕРЅР°СЂРЅРѕСЃС‚СЊ СѓСЃРёР»РёР»РёСЃСЊ."
            elif goal == 'higher':  # Р§РµРј Р±РѕР»СЊС€Рµ, С‚РµРј Р»СѓС‡С€Рµ (LB, JB)
                if a_val > b_val and a_val > 0.05:
                    status, rec = "вњ… РЈР»СѓС‡С€РµРЅРёРµ", "РђРІС‚РѕРєРѕСЂСЂРµР»СЏС†РёСЏ/РЅРѕСЂРјР°Р»СЊРЅРѕСЃС‚СЊ СѓР»СѓС‡С€РёР»РёСЃСЊ."
                elif a_val > b_val:
                    status, rec = "вњ… Р”РёРЅР°РјРёРєР°+", "РџРѕРєР°Р·Р°С‚РµР»СЊ РІС‹СЂРѕСЃ Рє С†РµР»РµРІРѕРјСѓ РїРѕСЂРѕРіСѓ."
                else:
                    status, rec = "вќЊ РЈС…СѓРґС€РµРЅРёРµ", "Р—Р°РІРёСЃРёРјРѕСЃС‚СЊ/Р°СЃРёРјРјРµС‚СЂРёСЏ СѓСЃРёР»РёР»РёСЃСЊ."
            else:  # РќРµР№С‚СЂР°Р»СЊРЅР°СЏ РјРµС‚СЂРёРєР° (RВІ)
                if abs(diff) < 0.1:
                    status, rec = "вљ пёЏ РќРµР№С‚СЂР°Р»СЊРЅРѕ", "Р”РµС‚РµСЂРјРёРЅРёСЂРѕРІР°РЅРЅРѕСЃС‚СЊ РЅРµ РёР·РјРµРЅРёР»Р°СЃСЊ СЃСѓС‰РµСЃС‚РІРµРЅРЅРѕ."
                elif a_val > b_val:
                    status, rec = "вњ… РЈСЃРёР»РµРЅРёРµ С‚СЂРµРЅРґР°", "Р”РµС‚РµСЂРјРёРЅРёСЂРѕРІР°РЅРЅР°СЏ РєРѕРјРїРѕРЅРµРЅС‚Р° СЃС‚Р°Р»Р° СЃРёР»СЊРЅРµРµ."
                else:
                    status, rec = "вњ… РЎС‚РѕС…Р°СЃС‚РёС‡РЅРѕСЃС‚СЊ+", "Р СЏРґ СЃС‚Р°Р» РјРµРЅРµРµ РїСЂРµРґСЃРєР°Р·СѓРµРјС‹Рј РїРѕ С‚СЂРµРЅРґСѓ."

