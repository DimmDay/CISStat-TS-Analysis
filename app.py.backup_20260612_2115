                                delta="РћС‚Р»РёС‡РЅРѕ" if metrics['snr'] > 10 else "РҐРѕСЂРѕС€Рѕ" if metrics['snr'] > 5 else "РЎР»Р°Р±Рѕ")
                        
                        # РљРѕСЂСЂРµР»СЏС†РёСЏ
                        st.metric("РљРѕСЂСЂРµР»СЏС†РёСЏ СЃ РёСЃС….", f"{metrics['correlation']:.3f}",
                                delta="РЎРёР»СЊРЅР°СЏ" if metrics['correlation'] > 0.9 else "РЎСЂРµРґРЅСЏСЏ")
                        
                        # Smoothness ratio
                        st.metric("Smoothness ratio", f"{metrics['smoothness_ratio']:.1f}x",
                                delta=f"Р’ {metrics['smoothness_ratio']:.1f} СЂР°Р· РіР»Р°Р¶Рµ")
                        
                        # Trend preservation
                        delta_trend = metrics['trend_preservation']
                        st.metric("О” РўСЂРµРЅРґ (RВІ)", f"{delta_trend:+.3f}",
                                delta="РЎРѕС…СЂР°РЅС‘РЅ" if abs(delta_trend) < 0.1 else "РР·РјРµРЅС‘РЅ")
                        
                        # Variance loss
                        st.metric("РџРѕС‚РµСЂСЏ РґРёСЃРїРµСЂСЃРёРё", f"{metrics['variance_loss_pct']:.1f}%",
                                delta="РњР°Р»Рѕ" if metrics['variance_loss_pct'] < 30 else "РњРЅРѕРіРѕ")
                        
                        # Amplitude reduction
                        st.metric("РћСЃР»Р°Р±Р»РµРЅРёРµ Р°РјРїР».", f"{metrics['amplitude_reduction']*100:.1f}%")
                    
                    st.divider()
                    
                    # Р РµРєРѕРјРµРЅРґР°С†РёРё
                    if metrics['snr'] > 10 and metrics['correlation'] > 0.9:
                        st.success("вњ… **РћС‚Р»РёС‡РЅС‹Р№ СЂРµР·СѓР»СЊС‚Р°С‚!** РЁСѓРј СѓРґР°Р»С‘РЅ, С‚СЂРµРЅРґ СЃРѕС…СЂР°РЅС‘РЅ.")
                    elif metrics['snr'] > 5:
                        st.success("вњ… **РҐРѕСЂРѕС€РёР№ СЂРµР·СѓР»СЊС‚Р°С‚.** РњРѕР¶РЅРѕ РїСЂРёРјРµРЅСЏС‚СЊ.")
                    elif metrics['variance_loss_pct'] > 50:
                        st.warning("рџ’Ў **РЎР»РёС€РєРѕРј Р°РіСЂРµСЃСЃРёРІРЅРѕРµ СЃРіР»Р°Р¶РёРІР°РЅРёРµ.** РЈРјРµРЅСЊС€РёС‚Рµ window/span/frac.")
                    elif metrics['correlation'] < 0.7:
                        st.warning("рџ’Ў **РЎРёР»СЊРЅРѕРµ РёСЃРєР°Р¶РµРЅРёРµ.** Р СЏРґ СЃРёР»СЊРЅРѕ РёР·РјРµРЅРёР»СЃСЏ. РџРѕРїСЂРѕР±СѓР№С‚Рµ РґСЂСѓРіРѕР№ РјРµС‚РѕРґ.")
                    else:
                        st.info("рџ’Ў РџРѕРїСЂРѕР±СѓР№С‚Рµ РґСЂСѓРіРёРµ РїР°СЂР°РјРµС‚СЂС‹ РґР»СЏ СѓР»СѓС‡С€РµРЅРёСЏ СЂРµР·СѓР»СЊС‚Р°С‚Р°.")
                    
                    # РРЅС„РѕСЂРјР°С†РёСЏ Рѕ РїР°СЂР°РјРµС‚СЂР°С…
                    st.info(f"**РџР°СЂР°РјРµС‚СЂС‹:** {st.session_state.smooth_transform_result['method']} = {st.session_state.smooth_transform_result['param']}")
            
            # в”Ђв”Ђ РРќР¤РћР РњРђР¦РРЇ Рћ РЎРћРҐР РђРќРЃРќРќР«РҐ РўР РђРќРЎР¤РћР РњРђР¦РРЇРҐ в”Ђв”Ђв”Ђв”Ђ
            if st.session_state.smooth_transform_params:
                st.divider()
                with st.expander("рџ’ѕ РЎРѕС…СЂР°РЅС‘РЅРЅС‹Рµ РїР°СЂР°РјРµС‚СЂС‹ СЃРіР»Р°Р¶РёРІР°РЅРёСЏ", expanded=False):
                    st.json(st.session_state.smooth_transform_params)
                    st.caption("Р­С‚Рё РїР°СЂР°РјРµС‚СЂС‹ РѕРїРёСЃС‹РІР°СЋС‚ РїСЂРёРјРµРЅС‘РЅРЅРѕРµ СЃРіР»Р°Р¶РёРІР°РЅРёРµ. "
                            "РћСЂРёРіРёРЅР°Р»СЊРЅС‹Рµ Р·РЅР°С‡РµРЅРёСЏ СЃРѕС…СЂР°РЅРµРЅС‹ РІ РєРѕР»РѕРЅРєРµ `_original`.")
        
        else:
            st.warning("вљ пёЏ Р’ РґР°С‚Р°СЃРµС‚Рµ РЅРµС‚ С‡РёСЃР»РѕРІС‹С… РєРѕР»РѕРЅРѕРє РґР»СЏ Р°РЅР°Р»РёР·Р°.")
    else:
        st.warning("вљ пёЏ РќРµ РѕР±РЅР°СЂСѓР¶РµРЅС‹ РєРѕР»РѕРЅРєРё СЃ РґР°С‚Р°РјРё РёР»Рё С‡РёСЃР»РѕРІС‹РјРё РґР°РЅРЅС‹РјРё. РЈР±РµРґРёС‚РµСЃСЊ, С‡С‚Рѕ Р°РєС‚РёРІРёСЂРѕРІР°РЅ СЂРµР¶РёРј РІСЂРµРјРµРЅРЅС‹С… СЂСЏРґРѕРІ.")


    # в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
    # рџ”№ 7. РћР‘Р•РЎРџР•Р§Р•РќРР• РЎРўРђР¦РРћРќРђР РќРћРЎРўР (STATIONARITY)
    # в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
    st.divider()
    st.markdown("### РћР±РµСЃРїРµС‡РµРЅРёРµ СЃС‚Р°С†РёРѕРЅР°СЂРЅРѕСЃС‚Рё (РґРёС„С„РµСЂРµРЅС†РёСЂРѕРІР°РЅРёРµ)")
    st.caption("Р‘РѕР»СЊС€РёРЅСЃС‚РІРѕ TS-РјРѕРґРµР»РµР№ (ARIMA, VAR, Р»РёРЅРµР№РЅР°СЏ СЂРµРіСЂРµСЃСЃРёСЏ) С‚СЂРµР±СѓСЋС‚ СЃС‚Р°С†РёРѕРЅР°СЂРЅРѕРіРѕ СЂСЏРґР° вЂ” "
            "СЃ РїРѕСЃС‚РѕСЏРЅРЅС‹РјРё mean, variance Рё autocorrelation. Р”РёС„С„РµСЂРµРЅС†РёСЂРѕРІР°РЅРёРµ СѓРґР°Р»СЏРµС‚ С‚СЂРµРЅРґ Рё СЃРµР·РѕРЅРЅРѕСЃС‚СЊ, "
            "РёСЃРєР»СЋС‡Р°СЏ СЃРјРµС‰РµРЅРёРµ РїРѕР»РѕР¶РµРЅРёСЏ СЂР°РІРЅРѕРІРµСЃРёСЏ.")

    # в”Ђв”Ђ Р”РРђР“РќРћРЎРўРРљРђ РўР•РљРЈР©Р•Р“Рћ РЎРћРЎРўРћРЇРќРРЇ в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
    if st.session_state.primary_date_col and st.session_state.col_types.get("num"):
        date_col = st.session_state.primary_date_col
        num_cols = st.session_state.col_types.get("num", [])
        
        if num_cols:
            df_stat = st.session_state.df.copy()
            df_stat[date_col] = pd.to_datetime(df_stat[date_col])
            df_stat = df_stat.sort_values(date_col)
            df_stat_ts = df_stat.set_index(date_col)
            
            # в”Ђв”Ђ Р¤РЈРќРљР¦РРЇ РњРќРћР–Р•РЎРўР’Р•РќРќР«РҐ РўР•РЎРўРћР’ РЎРўРђР¦РРћРќРђР РќРћРЎРўР в”Ђв”Ђ
            def run_stationarity_tests(series: pd.Series, max_lag: int = None) -> dict:
                """
                Р—Р°РїСѓСЃРєР°РµС‚ 4 С‚РµСЃС‚Р° СЃС‚Р°С†РёРѕРЅР°СЂРЅРѕСЃС‚Рё Рё РІРѕР·РІСЂР°С‰Р°РµС‚ РєРѕРЅСЃРµРЅСЃСѓСЃ.
                
                Returns:
                    dict СЃ РєР»СЋС‡Р°РјРё:
                    - adf: {'stat': float, 'pvalue': float, 'is_stationary': bool}
                    - kpss: {'stat': float, 'pvalue': float, 'is_stationary': bool}
                    - pp: {'stat': float, 'pvalue': float, 'is_stationary': bool}
                    - za: {'stat': float, 'pvalue': float, 'is_stationary': bool, 'breakpoint': int} (РµСЃР»Рё РґРѕСЃС‚СѓРїРµРЅ)
                    - consensus: 'stationary' | 'non-stationary' | 'trend-stationary' | 'inconclusive'
                    - recommendation: str
                """
                results = {}
                n = len(series)
                
                if n < 30:
                    return {'error': 'РќРµРґРѕСЃС‚Р°С‚РѕС‡РЅРѕ РґР°РЅРЅС‹С… (РЅСѓР¶РЅРѕ в‰Ґ 30)'}
                
                try:
                    from statsmodels.tsa.stattools import adfuller, kpss
                    from statsmodels.tsa.stattools import PhillipsPerron
                    
                    # в”Ђв”Ђ 1. ADF TEST в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                    # H0: СЂСЏРґ РёРјРµРµС‚ РµРґРёРЅРёС‡РЅС‹Р№ РєРѕСЂРµРЅСЊ (РЅРµСЃС‚Р°С†РёРѕРЅР°СЂРµРЅ)
                    # H1: СЂСЏРґ СЃС‚Р°С†РёРѕРЅР°СЂРµРЅ
                    if max_lag is None:
                        max_lag_adf = min(int(12 * (n / 100) ** 0.25), n // 3)
                    else:
                        max_lag_adf = max_lag
                    
                    adf_result = adfuller(series.dropna(), autolag='AIC', maxlag=max_lag_adf)
                    results['adf'] = {
                        'stat': adf_result[0],
                        'pvalue': adf_result[1],
                        'lags': adf_result[2],
                        'is_stationary': adf_result[1] < 0.05,
                        'critical_values': adf_result[4]
                    }
                    
                    # в”Ђ 2. KPSS TEST в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                    # H0: СЂСЏРґ СЃС‚Р°С†РёРѕРЅР°СЂРµРЅ (РІРѕРєСЂСѓРі СѓСЂРѕРІРЅСЏ РёР»Рё С‚СЂРµРЅРґР°)
                    # H1: СЂСЏРґ РЅРµСЃС‚Р°С†РёРѕРЅР°СЂРµРЅ
                    # РўРµСЃС‚РёСЂСѓРµРј РґРІР° РІР°СЂРёР°РЅС‚Р°: level (РІРѕРєСЂСѓРі РєРѕРЅСЃС‚Р°РЅС‚С‹) Рё trend (РІРѕРєСЂСѓРі С‚СЂРµРЅРґР°)
                    try:
                        kpss_level = kpss(series.dropna(), regression='c', nlags='auto')
                        kpss_trend = kpss(series.dropna(), regression='ct', nlags='auto')
                        results['kpss'] = {
                            'stat_level': kpss_level[0],
                            'pvalue_level': kpss_level[1],
                            'stat_trend': kpss_trend[0],
                            'pvalue_trend': kpss_trend[1],
                            'is_stationary_level': kpss_level[1] > 0.05,
                            'is_stationary_trend': kpss_trend[1] > 0.05
                        }
                    except Exception as e:
                        results['kpss'] = {'error': str(e)}
                    
                    # в”Ђв”Ђ 3. PHILLIPS-PERRON TEST в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                    # РђР»СЊС‚РµСЂРЅР°С‚РёРІР° ADF, СѓСЃС‚РѕР№С‡РёРІР° Рє РіРµС‚РµСЂРѕСЃРєРµРґР°СЃС‚РёС‡РЅРѕСЃС‚Рё
                    try:
                        pp_result = PhillipsPerron(series.dropna(), lags=max_lag_adf)
                        results['pp'] = {
                            'stat': pp_result.stat,
                            'pvalue': pp_result.pvalue,
                            'is_stationary': pp_result.pvalue < 0.05
                        }
                    except Exception:
                        # Fallback: РµСЃР»Рё PP РЅРµРґРѕСЃС‚СѓРїРµРЅ, РёСЃРїРѕР»СЊР·СѓРµРј ADF РєР°Рє proxy
                        results['pp'] = {
                            'stat': adf_result[0],
                            'pvalue': adf_result[1],
                            'is_stationary': adf_result[1] < 0.05,
                            'note': 'PP РЅРµРґРѕСЃС‚СѓРїРµРЅ, РёСЃРїРѕР»СЊР·СѓРµС‚СЃСЏ ADF'
                        }
                    
                    # в”Ђв”Ђ 4. ZIVOT-ANDREWS TEST (РѕРїС†РёРѕРЅР°Р»СЊРЅРѕ) в”Ђв”Ђ
                    # РЈС‡РёС‚С‹РІР°РµС‚ СЃС‚СЂСѓРєС‚СѓСЂРЅС‹Рµ СЂР°Р·СЂС‹РІС‹
                    try:
                        from statsmodels.tsa.stattools import zivot_andrews
                        za_result = zivot_andrews(series.dropna(), model='c')
                        results['za'] = {
                            'stat': za_result[0],
                            'pvalue': za_result[1],  # РњРѕР¶РµС‚ Р±С‹С‚СЊ РЅРµРґРѕСЃС‚СѓРїРµРЅ РІ СЃС‚Р°СЂС‹С… РІРµСЂСЃРёСЏС…
                            'breakpoint': za_result[2] if len(za_result) > 2 else None,
                            'is_stationary': za_result[0] < -4.8  # РџСЂРёР±Р»РёР·РёС‚РµР»СЊРЅС‹Р№ РєСЂРёС‚РёС‡РµСЃРєРёР№ СѓСЂРѕРІРµРЅСЊ
                        }
                    except Exception:
                        results['za'] = {'note': 'РўРµСЃС‚ Zivot-Andrews РЅРµРґРѕСЃС‚СѓРїРµРЅ (statsmodels < 0.14)'}
                    
                    # в”Ђв”Ђ 5. РљРћРќРЎР•РќРЎРЈРЎ в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                    adf_stat = results['adf']['is_stationary']
                    kpss_level_stat = results['kpss'].get('is_stationary_level', None)
                    kpss_trend_stat = results['kpss'].get('is_stationary_trend', None)
                    pp_stat = results['pp']['is_stationary']
                    
                    if adf_stat and kpss_level_stat:
                        consensus = 'stationary'
                        recommendation = 'вњ… Р СЏРґ СЃС‚Р°С†РёРѕРЅР°СЂРµРЅ. Р”РёС„С„РµСЂРµРЅС†РёСЂРѕРІР°РЅРёРµ РЅРµ С‚СЂРµР±СѓРµС‚СЃСЏ.'
                    elif not adf_stat and kpss_trend_stat:
                        consensus = 'trend-stationary'
                        recommendation = 'вљ пёЏ Р СЏРґ СЃС‚Р°С†РёРѕРЅР°СЂРµРЅ РІРѕРєСЂСѓРі С‚СЂРµРЅРґР°. Р”РѕСЃС‚Р°С‚РѕС‡РЅРѕ СѓРґР°Р»РёС‚СЊ С‚СЂРµРЅРґ (РґРµС‚СЂРµРЅРґ).'
                    elif not adf_stat and not kpss_level_stat:
                        consensus = 'non-stationary'
                        if pp_stat:
                            recommendation = 'вљ пёЏ ADF Рё KPSS РїСЂРѕС‚РёРІРѕСЂРµС‡Р°С‚ PP. РџРѕРїСЂРѕР±СѓР№С‚Рµ РґСЂСѓРіРѕРµ РґРёС„С„РµСЂРµРЅС†РёСЂРѕРІР°РЅРёРµ.'
                        else:
                            recommendation = ' Р СЏРґ РЅРµСЃС‚Р°С†РёРѕРЅР°СЂРµРЅ. РўСЂРµР±СѓРµС‚СЃСЏ РґРёС„С„РµСЂРµРЅС†РёСЂРѕРІР°РЅРёРµ.'
                    else:
                        consensus = 'inconclusive'
                        recommendation = 'пёЏ Р РµР·СѓР»СЊС‚Р°С‚С‹ С‚РµСЃС‚РѕРІ РїСЂРѕС‚РёРІРѕСЂРµС‡РёРІС‹. Р’РёР·СѓР°Р»СЊРЅС‹Р№ Р°РЅР°Р»РёР· + РїСЂРѕР±РЅРѕРµ РґРёС„С„РµСЂРµРЅС†РёСЂРѕРІР°РЅРёРµ.'
                    
                    results['consensus'] = consensus
                    results['recommendation'] = recommendation
                    
                except ImportError as e:
                    results['error'] = f'РќРµ СѓСЃС‚Р°РЅРѕРІР»РµРЅС‹ РЅРµРѕР±С…РѕРґРёРјС‹Рµ Р±РёР±Р»РёРѕС‚РµРєРё: {e}'
                except Exception as e:
                    results['error'] = str(e)
                
                return results
            
            # в”Ђв”Ђ Р¤РЈРќРљР¦РРЇ Р”РР¤Р¤Р•Р Р•РќР¦РР РћР’РђРќРРЇ в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
            def apply_differencing(series: pd.Series, method: str, d: int = 1, s: int = None, 
                                frac_d: float = None) -> pd.Series:
                """
                РџСЂРёРјРµРЅСЏРµС‚ РґРёС„С„РµСЂРµРЅС†РёСЂРѕРІР°РЅРёРµ Рє СЂСЏРґСѓ.
                
                Args:
                    series: РёСЃС…РѕРґРЅС‹Р№ СЂСЏРґ
                    method: 'first', 'seasonal', 'second', 'log', 'fractional', 'combined'
                    d: РїРѕСЂСЏРґРѕРє РїРµСЂРІРѕРіРѕ СЂР°Р·Р»РёС‡РёСЏ
                    s: СЃРµР·РѕРЅРЅС‹Р№ РїРµСЂРёРѕРґ (РґР»СЏ seasonal/combined)
                    frac_d: РґСЂРѕР±РЅС‹Р№ РїРѕСЂСЏРґРѕРє (РґР»СЏ fractional, 0 < d < 1)
                
                Returns:
                    РґРёС„С„РµСЂРµРЅС†РёСЂРѕРІР°РЅРЅС‹Р№ СЂСЏРґ
                """
                s_clean = series.dropna()
                
                if method == 'first':
                    return s_clean.diff(d).dropna()
                
                elif method == 'seasonal':
                    if s is None:
                        s = 12  # default
                    return s_clean.diff(s).dropna()
                
                elif method == 'second':
                    return s_clean.diff(2).dropna()
                
                elif method == 'log':
                    if (s_clean <= 0).any():
                        raise ValueError("Р›РѕРіР°СЂРёС„РјРёС‡РµСЃРєРѕРµ СЂР°Р·Р»РёС‡РёРµ С‚СЂРµР±СѓРµС‚ РїРѕР»РѕР¶РёС‚РµР»СЊРЅС‹С… Р·РЅР°С‡РµРЅРёР№")
                    return np.log(s_clean).diff().dropna()
                
                elif method == 'fractional':
                    if frac_d is None or not (0 < frac_d < 1):
                        raise ValueError("Р”СЂРѕР±РЅС‹Р№ РїРѕСЂСЏРґРѕРє РґРѕР»Р¶РµРЅ Р±С‹С‚СЊ РІ РґРёР°РїР°Р·РѕРЅРµ (0, 1)")
                    # Р РµР°Р»РёР·Р°С†РёСЏ РґСЂРѕР±РЅРѕРіРѕ РґРёС„С„РµСЂРµРЅС†РёСЂРѕРІР°РЅРёСЏ РїРѕ LГіpez de Prado
                    # (1 - L)^d = ОЈ_{k=0}^{в€ћ} (-1)^k * C(d,k) * L^k
                    # РіРґРµ C(d,k) = d*(d-1)*...*(d-k+1)/k!
                    from scipy.special import comb
                    
                    weights = []
                    for k in range(len(s_clean)):
                        weight = (-1) ** k * comb(frac_d, k)
                        weights.append(weight)
                        if abs(weight) < 1e-5:  # РћР±СЂРµР·Р°РµРј РјР°Р»С‹Рµ РІРµСЃР°
                            break
                    
                    weights = np.array(weights[:len(s_clean)])
                    
                    # РџСЂРёРјРµРЅСЏРµРј СЃРІС‘СЂС‚РєСѓ
                    result = np.zeros(len(s_clean))
                    values = s_clean.values
                    for i in range(len(s_clean)):
                        for j, w in enumerate(weights):
                            if i - j >= 0:
                                result[i] += w * values[i - j]
                    
                    return pd.Series(result, index=s_clean.index).dropna()
                
                elif method == 'combined':
                    # РЎРЅР°С‡Р°Р»Р° СЃРµР·РѕРЅРЅРѕРµ, РїРѕС‚РѕРј РїРµСЂРІРѕРµ СЂР°Р·Р»РёС‡РёРµ
                    if s is None:
                        s = 12
                    result = s_clean.diff(s).dropna()
                    result = result.diff(d).dropna()
                    return result
                
                else:
                    raise ValueError(f"РќРµРёР·РІРµСЃС‚РЅС‹Р№ РјРµС‚РѕРґ: {method}")
            
            # в”Ђв”Ђ РњР•РўР РРљР РўР•РљРЈР©Р•Р“Рћ РЎРћРЎРўРћРЇРќРРЇ в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
