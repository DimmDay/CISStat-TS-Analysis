            # в”Ђв”Ђ РўР•РҐРќРР§Р•РЎРљРђРЇ РЎРџР РђР’РљРђ в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
            with st.expander(" Р¦РµР»Рё СЃСѓР±РјРѕРґСѓР»СЏ вЃћ Р”РµРєРѕРјРїРѕР·РёС†РёСЏ РІСЂРµРјРµРЅРЅС‹С… СЂСЏРґРѕРІ", expanded=False):
                st.markdown("""
                **Р—Р°С‡РµРј РЅСѓР¶РЅР° РґРµРєРѕРјРїРѕР·РёС†РёСЏ:**
                -  **РџРѕРЅРёРјР°РЅРёРµ СЃС‚СЂСѓРєС‚СѓСЂС‹:** Р Р°Р·РґРµР»СЏРµС‚ СЂСЏРґ РЅР° РєРѕРјРїРѕРЅРµРЅС‚С‹ (Trend, Seasonal, Cycle, Residual)
                -  **Р’С‹Р±РѕСЂ РјРѕРґРµР»Рё:** РџРѕРјРѕРіР°РµС‚ РѕРїСЂРµРґРµР»РёС‚СЊ, РєР°РєРёРµ РјРѕРґРµР»Рё РїРѕРґС…РѕРґСЏС‚ (ARIMA, ETS, Prophet)
                -  **РџСЂРѕРіРЅРѕР·РёСЂРѕРІР°РЅРёРµ:** РљР°Р¶РґР°СЏ РєРѕРјРїРѕРЅРµРЅС‚Р° РїСЂРѕРіРЅРѕР·РёСЂСѓРµС‚СЃСЏ РѕС‚РґРµР»СЊРЅРѕ
                -  **РџСЂРµРґРѕР±СЂР°Р±РѕС‚РєР°:** РџРѕР·РІРѕР»СЏРµС‚ СѓРґР°Р»РёС‚СЊ С‚СЂРµРЅРґ/СЃРµР·РѕРЅРЅРѕСЃС‚СЊ РїРµСЂРµРґ РјРѕРґРµР»РёСЂРѕРІР°РЅРёРµРј
                
                **РњРµС‚РѕРґС‹ РґРµРєРѕРјРїРѕР·РёС†РёРё:**
                
                | РњРµС‚РѕРґ | РљРѕРіРґР° РёСЃРїРѕР»СЊР·РѕРІР°С‚СЊ | РџСЂРµРёРјСѓС‰РµСЃС‚РІР° | РќРµРґРѕСЃС‚Р°С‚РєРё |
                |-------|-------------------|--------------|------------|
                | **STL** | РЈРЅРёРІРµСЂСЃР°Р»СЊРЅС‹Р№ РјРµС‚РѕРґ | РЈСЃС‚РѕР№С‡РёРІ Рє РІС‹Р±СЂРѕСЃР°Рј, РіРёР±РєРёР№ | РўСЂРµР±СѓРµС‚ СЂРµРіСѓР»СЏСЂРЅС‹Р№ СЂСЏРґ |
                | **Additive** | РџРѕСЃС‚РѕСЏРЅРЅР°СЏ Р°РјРїР»РёС‚СѓРґР° СЃРµР·РѕРЅРЅРѕСЃС‚Рё | РџСЂРѕСЃС‚РѕР№, Р±С‹СЃС‚СЂС‹Р№ | РќРµ СЂР°Р±РѕС‚Р°РµС‚ СЃ СЂР°СЃС‚СѓС‰РµР№ Р°РјРїР»РёС‚СѓРґРѕР№ |
                | **Multiplicative** | Р Р°СЃС‚СѓС‰Р°СЏ Р°РјРїР»РёС‚СѓРґР° СЃРµР·РѕРЅРЅРѕСЃС‚Рё | РЈС‡РёС‚С‹РІР°РµС‚ РјР°СЃС€С‚Р°Р± | РўСЂРµР±СѓРµС‚ РїРѕР»РѕР¶РёС‚РµР»СЊРЅС‹С… Р·РЅР°С‡РµРЅРёР№ |
                
                **РљРѕРјРїРѕРЅРµРЅС‚С‹ СЂСЏРґР°:**
                - **Trend:** Р”РѕР»РіРѕСЃСЂРѕС‡РЅРѕРµ РЅР°РїСЂР°РІР»РµРЅРёРµ (СЂРѕСЃС‚/РїР°РґРµРЅРёРµ)
                - **Seasonal:** РџРµСЂРёРѕРґРёС‡РµСЃРєРёРµ РєРѕР»РµР±Р°РЅРёСЏ (РґРµРЅСЊ/РЅРµРґРµР»СЏ/РјРµСЃСЏС†/РіРѕРґ)
                - **Cycle:** Р”РѕР»РіРѕСЃСЂРѕС‡РЅС‹Рµ С†РёРєР»С‹ (>1 РіРѕРґР°, РЅРµСЂРµРіСѓР»СЏСЂРЅС‹Рµ)
                - **Residual:** РЎР»СѓС‡Р°Р№РЅС‹Р№ С€СѓРј (РґРѕР»Р¶РµРЅ Р±С‹С‚СЊ Р±РµР»С‹Рј С€СѓРјРѕРј)
                
                **Р”РёР°РіРЅРѕСЃС‚РёРєР° РѕСЃС‚Р°С‚РєРѕРІ:**
                - вњ… **ADF Test:** РџСЂРѕРІРµСЂРєР° СЃС‚Р°С†РёРѕРЅР°СЂРЅРѕСЃС‚Рё (p < 0.05)
                - вњ… **Ljung-Box:** РџСЂРѕРІРµСЂРєР° Р°РІС‚РѕРєРѕСЂСЂРµР»СЏС†РёРё (p > 0.05 = Р±РµР»С‹Р№ С€СѓРј)
                - вњ… **Jarque-Bera:** РџСЂРѕРІРµСЂРєР° РЅРѕСЂРјР°Р»СЊРЅРѕСЃС‚Рё (p > 0.05)
                - вњ… **ARCH-LM:** РџСЂРѕРІРµСЂРєР° РіРѕРјРѕСЃРєРµРґР°СЃС‚РёС‡РЅРѕСЃС‚Рё (p > 0.05)
                
                **РљРѕРЅС‚СЂРѕР»СЊ РєР°С‡РµСЃС‚РІР°:**
                - РћСЃС‚Р°С‚РєРё РґРѕР»Р¶РЅС‹ Р±С‹С‚СЊ **Р±РµР»С‹Рј С€СѓРјРѕРј** (РЅРµС‚ Р°РІС‚РѕРєРѕСЂСЂРµР»СЏС†РёРё)
                - РћСЃС‚Р°С‚РєРё РґРѕР»Р¶РЅС‹ Р±С‹С‚СЊ **СЃС‚Р°С†РёРѕРЅР°СЂРЅС‹** (ADF test)
                - РћСЃС‚Р°С‚РєРё РґРѕР»Р¶РЅС‹ Р±С‹С‚СЊ **РЅРѕСЂРјР°Р»СЊРЅРѕ СЂР°СЃРїСЂРµРґРµР»РµРЅС‹** (JB test)
                """)
            
            # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
            # рџЋ® РџР•РЎРћР§РќРР¦Рђ: Р”Р•РљРћРњРџРћР—РР¦РРЇ
            # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
            
            # РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ session_state
            if "show_decomp_preview" not in st.session_state:
                st.session_state.show_decomp_preview = False
            
            # в”Ђв”Ђ Р›Р•Р’РђРЇ РљРћР›РћРќРљРђ: РџРђРќР•Р›Р¬ РЈРџР РђР’Р›Р•РќРРЇ в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
            c1, c2, c3 = st.columns([27, 52, 21])
            
            with c1:
                st.markdown("######  РџР°РЅРµР»СЊ СѓРїСЂР°РІР»РµРЅРёСЏ")
                
                # Р’С‹Р±РѕСЂ С‡РёСЃР»РѕРІРѕР№ РєРѕР»РѕРЅРєРё
                target_col = st.selectbox(
                    "Р§РёСЃР»РѕРІРѕР№ РїСЂРёР·РЅР°Рє:",
                    options=num_cols,
                    index=0,
                    key="decomp_target_col"
                )
                
                # Р’С‹Р±РѕСЂ РјРµС‚РѕРґР° РґРµРєРѕРјРїРѕР·РёС†РёРё
                decomp_method = st.radio(
                    "РњРµС‚РѕРґ РґРµРєРѕРјРїРѕР·РёС†РёРё:",
                    ["STL (СЂРµРєРѕРјРµРЅРґСѓРµС‚СЃСЏ)", "Additive (РєР»Р°СЃСЃРёС‡РµСЃРєРёР№)", "Multiplicative (РєР»Р°СЃСЃРёС‡РµСЃРєРёР№)"],
                    key="decomp_method",
                    label_visibility="collapsed"
                )
                
                # РџР°СЂР°РјРµС‚СЂС‹ STL
                if "STL" in decomp_method:
                    st.markdown("**РџР°СЂР°РјРµС‚СЂС‹ STL:**")
                    
                    # РЎРµР·РѕРЅРЅС‹Р№ РїРµСЂРёРѕРґ
                    if inferred_freq:
                        if 'D' in inferred_freq:
                            default_period = 7
                        elif 'W' in inferred_freq:
                            default_period = 52
                        elif 'M' in inferred_freq:
                            default_period = 12
                        elif 'Q' in inferred_freq:
                            default_period = 4
                        else:
                            default_period = 12
                    else:
                        default_period = 12
                    
                    seasonal_period = st.number_input(
                        "РЎРµР·РѕРЅРЅС‹Р№ РїРµСЂРёРѕРґ:",
                        min_value=2,
                        max_value=365,
                        value=default_period,
                        step=1,
                        key="stl_period",
                        help="Р”Р»РёРЅР° СЃРµР·РѕРЅРЅРѕРіРѕ С†РёРєР»Р° (7 РґР»СЏ РґРЅРµРІРЅС‹С…, 12 РґР»СЏ РјРµСЃСЏС‡РЅС‹С…, 52 РґР»СЏ РЅРµРґРµР»СЊРЅС‹С…)"
                    )
                    
                    # Robust
                    robust = st.checkbox("Robust (СѓСЃС‚РѕР№С‡РёРІРѕСЃС‚СЊ Рє РІС‹Р±СЂРѕСЃР°Рј)", value=True, key="stl_robust")
                    
                    # Seasonal window
                    seasonal_window = st.selectbox(
                        "РЎРіР»Р°Р¶РёРІР°РЅРёРµ СЃРµР·РѕРЅРЅРѕСЃС‚Рё:",
                        [7, 9, 11, 13, 15],
                        index=0,
                        key="stl_seasonal_window",
                        help="РќРµС‡С‘С‚РЅРѕРµ С‡РёСЃР»Рѕ > 1. Р‘РѕР»СЊС€Рµ = РіР»Р°Р¶Рµ СЃРµР·РѕРЅРЅРѕСЃС‚СЊ"
                    )
                    
                    # Trend window
                    trend_window = st.selectbox(
                        "РЎРіР»Р°Р¶РёРІР°РЅРёРµ С‚СЂРµРЅРґР°:",
                        [None, 15, 21, 31, 51],
                        index=0,
                        key="stl_trend_window",
                        help="None = Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРёР№ РІС‹Р±РѕСЂ. РќРµС‡С‘С‚РЅРѕРµ С‡РёСЃР»Рѕ > 1."
                    )
                
                else:
                    # РџР°СЂР°РјРµС‚СЂС‹ РєР»Р°СЃСЃРёС‡РµСЃРєРѕР№ РґРµРєРѕРјРїРѕР·РёС†РёРё
                    st.markdown("**РџР°СЂР°РјРµС‚СЂС‹ РєР»Р°СЃСЃРёС‡РµСЃРєРѕР№ РґРµРєРѕРјРїРѕР·РёС†РёРё:**")
                    
                    if inferred_freq:
                        if 'D' in inferred_freq:
                            default_period = 7
                        elif 'W' in inferred_freq:
                            default_period = 52
                        elif 'M' in inferred_freq:
                            default_period = 12
                        elif 'Q' in inferred_freq:
                            default_period = 4
                        else:
                            default_period = 12
                    else:
                        default_period = 12
                    
                    classic_period = st.number_input(
                        "РЎРµР·РѕРЅРЅС‹Р№ РїРµСЂРёРѕРґ:",
                        min_value=2,
                        max_value=365,
                        value=default_period,
                        step=1,
                        key="classic_period"
                    )
                
                st.divider()
                
                # РљРЅРѕРїРєРё РґРµР№СЃС‚РІРёР№
                if st.button("в–¶ Р’С‹РїРѕР»РЅРёС‚СЊ РґРµРєРѕРјРїРѕР·РёС†РёСЋ", type="primary", use_container_width=True, key="btn_apply_decomp"):
                    st.session_state.show_decomp_preview = True
                    st.rerun()
                
                if st.button("в†¶ РЎР±СЂРѕСЃРёС‚СЊ", use_container_width=True, key="btn_reset_decomp"):
                    st.session_state.show_decomp_preview = False
                    st.rerun()
            
            # в”Ђв”Ђ Р¦Р•РќРўР РђР›Р¬РќРђРЇ РљРћР›РћРќРљРђ: Р’РР—РЈРђР›РР—РђР¦РРЇ в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
            with c2:
                st.markdown("###### Р”РµРєРѕРјРїРѕР·РёС†РёСЏ РІСЂРµРјРµРЅРЅРѕРіРѕ СЂСЏРґР°")
                
                if target_col in df_decomp_ts.columns:
                    original_series = df_decomp_ts[target_col].dropna()
                    
                    if st.session_state.show_decomp_preview:
                        # РџСЂРѕРІРµСЂРєР° РіРѕС‚РѕРІРЅРѕСЃС‚Рё
                        if inferred_freq is None:
                            st.error("вќЊ Р СЏРґ РЅРµСЂРµРіСѓР»СЏСЂРЅС‹Р№. РЎРЅР°С‡Р°Р»Р° РІС‹РїРѕР»РЅРёС‚Рµ РјРѕРґСѓР»СЊ 'Р РµРіСѓР»СЏСЂРЅРѕСЃС‚СЊ С‡Р°СЃС‚РѕС‚С‹'.")
                        elif len(original_series) < 30:
                            st.error(f"вќЊ РќРµРґРѕСЃС‚Р°С‚РѕС‡РЅРѕ РґР°РЅРЅС‹С…: {len(original_series)} РЅР°Р±Р»СЋРґРµРЅРёР№ (РјРёРЅРёРјСѓРј 30).")
                        elif total_missing > 0:
                            st.error(f"вќЊ Р•СЃС‚СЊ РїСЂРѕРїСѓСЃРєРё: {total_missing}. РЎРЅР°С‡Р°Р»Р° РѕР±СЂР°Р±РѕС‚Р°Р№С‚Рµ РїСЂРѕРїСѓСЃРєРё.")
                        else:
                            try:
                                # Р’С‹РїРѕР»РЅСЏРµРј РґРµРєРѕРјРїРѕР·РёС†РёСЋ
                                if "STL" in decomp_method:
                                    from statsmodels.tsa.seasonal import STL
                                    
                                    stl = STL(
                                        original_series,
                                        period=seasonal_period,
                                        seasonal=seasonal_window,
                                        trend=trend_window,
                                        robust=robust
                                    )
                                    result = stl.fit()
                                    
                                    trend = result.trend
                                    seasonal = result.seasonal
                                    residual = result.resid
                                    
                                    # Р¦РёРєР»РёС‡РЅРѕСЃС‚СЊ = Trend - СЃРіР»Р°Р¶РµРЅРЅС‹Р№ С‚СЂРµРЅРґ (СѓРїСЂРѕС‰С‘РЅРЅРѕ)
                                    cycle = trend - trend.rolling(window=seasonal_period*2, center=True, min_periods=1).mean()
                                    
                                    decomp_type = "STL"
                                    
                                elif "Additive" in decomp_method:
                                    from statsmodels.tsa.seasonal import seasonal_decompose
                                    
                                    result = seasonal_decompose(original_series, model='additive', period=classic_period)
                                    trend = result.trend
                                    seasonal = result.seasonal
                                    residual = result.resid
                                    cycle = pd.Series(0, index=original_series.index)  # РќРµС‚ СЏРІРЅРѕР№ С†РёРєР»РёС‡РЅРѕСЃС‚Рё
                                    
                                    decomp_type = "Additive"
                                    
                                elif "Multiplicative" in decomp_method:
                                    from statsmodels.tsa.seasonal import seasonal_decompose
                                    
                                    if (original_series <= 0).any():
                                        st.error("вќЊ Multiplicative РґРµРєРѕРјРїРѕР·РёС†РёСЏ С‚СЂРµР±СѓРµС‚ РїРѕР»РѕР¶РёС‚РµР»СЊРЅС‹С… Р·РЅР°С‡РµРЅРёР№.")
                                    else:
                                        result = seasonal_decompose(original_series, model='multiplicative', period=classic_period)
                                        trend = result.trend
                                        seasonal = result.seasonal
                                        residual = result.resid
