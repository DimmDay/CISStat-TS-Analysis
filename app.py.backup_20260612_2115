                    c_spec1, c_spec2, c_spec3, c_spec4 = st.columns(4)
                    
                    with c_spec1:
                        # FFT
                        from scipy.fft import fft, fftfreq
                        from scipy.signal import find_peaks
                        
                        n = len(series)
                        y = series.values - series.mean()
                        yf = fft(y)
                        xf = fftfreq(n, 1)[:n//2]
                        amplitude = 2.0/n * np.abs(yf[0:n//2])
                        
                        # Р”РѕРјРёРЅРёСЂСѓСЋС‰РёРµ С‡Р°СЃС‚РѕС‚С‹
                        peaks, _ = find_peaks(amplitude, height=np.mean(amplitude) + np.std(amplitude))
                        dominant_periods = [1/xf[p] for p in peaks if xf[p] > 0 and xf[p] < 0.5]
                        
                        #  Р¤РѕСЂРјР°С‚РёСЂСѓРµРј РїРµСЂРёРѕРґС‹ СЃ СЂР°Р·РґРµР»РёС‚РµР»СЏРјРё С‚С‹СЃСЏС‡
                        if dominant_periods:
                            periods_formatted = ', '.join([f'{p:,.1f}'.replace(",", " ") for p in dominant_periods[:3]])
                        else:
                            periods_formatted = "РќРµ РѕР±РЅР°СЂСѓР¶РµРЅС‹"
                        
                        st.metric(" Р”РѕРјРёРЅРёСЂСѓСЋС‰РёРµ РїРµСЂРёРѕРґС‹ (FFT)", 
                                f"{len(dominant_periods)}",
                                delta=periods_formatted)

                    with c_spec2:
                        # РџРµСЂРёРѕРґРѕРіСЂР°РјРјР°
                        from scipy.signal import periodogram
                        
                        freq_per, pxx_per = periodogram(series.values, fs=1.0, window='hann')
                        spectral_energy = np.sum(pxx_per)
                        
                        #  Р¤РѕСЂРјР°С‚РёСЂСѓРµРј СЃРїРµРєС‚СЂР°Р»СЊРЅСѓСЋ СЌРЅРµСЂРіРёСЋ СЃ СЂР°Р·РґРµР»РёС‚РµР»СЏРјРё С‚С‹СЃСЏС‡
                        spectral_energy_formatted = f"{spectral_energy:,.2f}".replace(",", " ")
                        
                        st.metric(" РЎРїРµРєС‚СЂР°Р»СЊРЅР°СЏ СЌРЅРµСЂРіРёСЏ", 
                                spectral_energy_formatted,
                                delta="РњРѕС‰РЅС‹Р№ СЃРёРіРЅР°Р»" if spectral_energy > 100 else "РЎР»Р°Р±С‹Р№ СЃРёРіРЅР°Р»")
                    
                    with c_spec3:
                        # РЎРїРµРєС‚СЂР°Р»СЊРЅР°СЏ СЌРЅС‚СЂРѕРїРёСЏ
                        spectrum = np.abs(yf)**2
                        spectrum_norm = spectrum / np.sum(spectrum)
                        spectral_entropy = -np.sum(spectrum_norm * np.log(spectrum_norm + 1e-10))
                        
                        st.metric(" РЎРїРµРєС‚СЂР°Р»СЊРЅР°СЏ СЌРЅС‚СЂРѕРїРёСЏ", 
                                f"{spectral_entropy:.3f}",
                                delta="РЎР»РѕР¶РЅС‹Р№" if spectral_entropy > 3 else "РџСЂРѕСЃС‚РѕР№")
                    
                    with c_spec4:
                        # РЎРѕРѕС‚РЅРѕС€РµРЅРёРµ РЅРёР·РєРёС…/РІС‹СЃРѕРєРёС… С‡Р°СЃС‚РѕС‚
                        mid_freq = len(xf)//4
                        low_energy = np.sum(amplitude[:mid_freq]**2)
                        high_energy = np.sum(amplitude[mid_freq:]**2)
                        ratio = low_energy / (high_energy + 1e-10)
                        
                        st.metric(" Low/High С‡Р°СЃС‚РѕС‚С‹", 
                                f"{ratio:.2f}",
                                delta="РќРёР·РєРѕС‡Р°СЃС‚РѕС‚РЅС‹Р№" if ratio > 2 else "Р’С‹СЃРѕРєРѕС‡Р°СЃС‚РѕС‚РЅС‹Р№")
                    
                    # в”Ђв”Ђ Р’РР—РЈРђР›РР—РђР¦РРЇ в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                    st.divider()

                    tab_fft, tab_per, tab_wave, tab_acf = st.tabs([
                        "FFT СЃРїРµРєС‚СЂ", 
                        "РџРµСЂРёРѕРґРѕРіСЂР°РјРјР°", 
                        "Wavelet", 
                        "ACF/PACF"
                    ])

                    with tab_fft:
                        fig_fft = px.line(
                            x=xf[:n//2], 
                            y=amplitude,
                            title="FFT: РђРјРїР»РёС‚СѓРґРЅС‹Р№ СЃРїРµРєС‚СЂ",
                            labels={'x': 'Р§Р°СЃС‚РѕС‚Р°', 'y': 'РђРјРїР»РёС‚СѓРґР°'}
                        )
                        # РћС‚РјРµС‚РёС‚СЊ РїРёРєРё
                        for p in peaks[:5]:
                            if xf[p] > 0:
                                fig_fft.add_vline(x=xf[p], line_dash="dash", line_color="red")
                                fig_fft.add_annotation(
                                    x=xf[p], 
                                    y=amplitude[p],
                                    text=f"Period={1/xf[p]:.1f}",
                                    showarrow=True,
                                    arrowhead=2,
                                    ax=0,
                                    ay=-40
                                )
                        # РР—РњР•РќР•РќРћ: height=600 (РІРјРµСЃС‚Рѕ 400)
                        fig_fft.update_layout(height=600, showlegend=False)
                        st.plotly_chart(fig_fft, use_container_width=True, key="fft_spectrum_chart")

                    with tab_per:
                        fig_per = px.line(
                            x=freq_per, 
                            y=pxx_per,
                            title="РџРµСЂРёРѕРґРѕРіСЂР°РјРјР° (СЃРїРµРєС‚СЂР°Р»СЊРЅР°СЏ РїР»РѕС‚РЅРѕСЃС‚СЊ РјРѕС‰РЅРѕСЃС‚Рё)",
                            labels={'x': 'Р§Р°СЃС‚РѕС‚Р°', 'y': 'РњРѕС‰РЅРѕСЃС‚СЊ'}
                        )
                        # рџ”§ РР—РњР•РќР•РќРћ: height=600 (РІРјРµСЃС‚Рѕ 400)
                        fig_per.update_layout(height=600, showlegend=False)
                        st.plotly_chart(fig_per, use_container_width=True, key="periodogram_chart")

                    with tab_wave:
