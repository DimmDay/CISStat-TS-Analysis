                }
                color = consensus_colors.get(consensus, '#6b7280')
                text = consensus_texts.get(consensus, 'РќРµРёР·РІРµСЃС‚РЅРѕ')
                st.markdown(f"<div style='font-size: 14px; font-weight: 600; color: {color};'>{text}</div>", 
                        unsafe_allow_html=True)
            
            # РћС‚СЃС‚СѓРї
            st.markdown("<div style='height: 30px;'></div>", unsafe_allow_html=True)
            
            # в”Ђв”Ђ РўР•РҐРќРР§Р•РЎРљРђРЇ РЎРџР РђР’РљРђ в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
            with st.expander("Р¦РµР»Рё СЃСѓР±РјРѕРґСѓР»СЏ вЃћ РћР±РµСЃРїРµС‡РµРЅРёРµ СЃС‚Р°С†РёРѕРЅР°СЂРЅРѕСЃС‚Рё", expanded=False):
