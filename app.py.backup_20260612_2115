                st.success("вњ… IH-Р°РЅР°Р»РёР· Р·Р°РІРµСЂС€С‘РЅ! Р РµР·СѓР»СЊС‚Р°С‚С‹ СЃРѕС…СЂР°РЅРµРЅС‹.")

                # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                # рџ’Ў Р Р•РљРћРњР•РќР”РђР¦РР РќРђ РћРЎРќРћР’Р• Р Р•Р—РЈР›Р¬РўРђРўРћР’
                # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                st.markdown("###### рџ’Ў РђРІС‚РѕРјР°С‚РёС‡РµСЃРєРёРµ СЂРµРєРѕРјРµРЅРґР°С†РёРё")

                recommendations = []

                # Р’С‹СЃРѕРєР°СЏ РёРЅС„РѕСЂРјР°С‚РёРІРЅРѕСЃС‚СЊ
                high_r = df_ih[df_ih["R"] >= 0.5]
                if not high_r.empty:
                    rec_list = ", ".join([f"`{r}`" for r in high_r["feature"].head(3)])
                    recommendations.append(f"вњ… **РЎРёР»СЊРЅС‹Рµ РїСЂРµРґРёРєС‚РѕСЂС‹**: {rec_list} (R в‰Ґ 0.5) в†’ РёСЃРїРѕР»СЊР·СѓР№С‚Рµ РєР°Рє РѕСЃРЅРѕРІРЅС‹Рµ РїСЂРёР·РЅР°РєРё РІ РјРѕРґРµР»СЏС…")

                # РќРёР·РєР°СЏ РёРЅС„РѕСЂРјР°С‚РёРІРЅРѕСЃС‚СЊ
                low_r = df_ih[df_ih["R"] < 0.1]
                if not low_r.empty and len(low_r) > len(df_ih) * 0.3:
                    recommendations.append("вљ пёЏ **РњРЅРѕРіРѕ СЃР»Р°Р±С‹С… РїСЂРёР·РЅР°РєРѕРІ**: СЂР°СЃСЃРјРѕС‚СЂРёС‚Рµ РѕС‚Р±РѕСЂ РїСЂРёР·РЅР°РєРѕРІ РёР»Рё Р°РіСЂРµРіР°С†РёСЋ")

                # Р’С‹СЃРѕРєР°СЏ СЌРЅС‚СЂРѕРїРёСЏ + РЅРёР·РєРёР№ R (С€СѓРј?)
                noisy = df_ih[(df_ih["H_X"] > df_ih["H_X"].quantile(0.75)) & (df_ih["R"] < 0.15)]
                if not noisy.empty:
                    rec_list = ", ".join([f"`{r}`" for r in noisy["feature"].head(3)])
                    recommendations.append(f"вљЎ **Р’С‹СЃРѕРєР°СЏ СЌРЅС‚СЂРѕРїРёСЏ, РЅРёР·РєР°СЏ СЃРІСЏР·СЊ**: {rec_list} в†’ РІРѕР·РјРѕР¶РµРЅ С€СѓРј, РїСЂРѕРІРµСЂСЊС‚Рµ РєР°С‡РµСЃС‚РІРѕ РґР°РЅРЅС‹С…")

                # РЎРёРЅРµСЂРіРёСЏ (РµСЃР»Рё РµСЃС‚СЊ)
                if "synergy_results" in locals() and synergy_results:
