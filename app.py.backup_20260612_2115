# в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
# Р¤РЈРќРљР¦РРЇ Р РђРЎР§РЃРўРђ РЎР’РћР™РЎРўР’ Р’Р Р•РњР•РќРќРћР“Рћ Р РЇР”Рђ
# в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
def _calc_ts_props(series: pd.Series) -> dict:
    """
    Р Р°СЃСЃС‡РёС‚С‹РІР°РµС‚ РєР»СЋС‡РµРІС‹Рµ СЃРІРѕР№СЃС‚РІР° РІСЂРµРјРµРЅРЅРѕРіРѕ СЂСЏРґР°.

    Args:
        series: pd.Series СЃ РІСЂРµРјРµРЅРЅС‹Рј СЂСЏРґРѕРј (index=datetime, values=numeric)

    Returns:
        dict СЃ РєР»СЋС‡Р°РјРё:
        - n: С‡РёСЃР»Рѕ РЅР°Р±Р»СЋРґРµРЅРёР№
        - mean, std, min, max: Р±Р°Р·РѕРІС‹Рµ СЃС‚Р°С‚РёСЃС‚РёРєРё
        - adf_pvalue: p-value С‚РµСЃС‚Р° Р”РёРєРё-Р¤СѓР»Р»РµСЂР° (СЃС‚Р°С†РёРѕРЅР°СЂРЅРѕСЃС‚СЊ)
        - is_stationary: True РµСЃР»Рё p < 0.05
        - has_trend: РЅР°Р»РёС‡РёРµ С‚СЂРµРЅРґР° (С‡РµСЂРµР· Р»РёРЅРµР№РЅСѓСЋ СЂРµРіСЂРµСЃСЃРёСЋ)
        - has_seasonality: РЅР°Р»РёС‡РёРµ СЃРµР·РѕРЅРЅРѕСЃС‚Рё (С‡РµСЂРµР· FFT)
        - trend_strength: СЃРёР»Р° С‚СЂРµРЅРґР° (RВІ)
        - seasonal_strength: СЃРёР»Р° СЃРµР·РѕРЅРЅРѕСЃС‚Рё
    """
    props = {
        'n': len(series),
        'mean': series.mean(),
        'std': series.std(),
        'min': series.min(),
        'max': series.max(),
        'adf_pvalue': None,
        'is_stationary': None,
        'has_trend': False,
        'has_seasonality': False,
        'trend_strength': 0.0,
        'seasonal_strength': 0.0
    }

    if len(series) < 10:
        return props

    # 1. РўРµСЃС‚ Р”РёРєРё-Р¤СѓР»Р»РµСЂР° (СЃС‚Р°С†РёРѕРЅР°СЂРЅРѕСЃС‚СЊ)
    try:
        from statsmodels.tsa.stattools import adfuller
        adf_result = adfuller(series.dropna(), autolag='AIC')
        props['adf_pvalue'] = adf_result[1]
        props['is_stationary'] = adf_result[1] < 0.05
    except Exception:
        pass

    # 2. РџСЂРѕРІРµСЂРєР° С‚СЂРµРЅРґР° (Р»РёРЅРµР№РЅР°СЏ СЂРµРіСЂРµСЃСЃРёСЏ)
    try:
        from scipy import stats
        x = np.arange(len(series))
        slope, intercept, r_value, p_value, std_err = stats.linregress(x, series.values)
        props['has_trend'] = p_value < 0.05
        props['trend_strength'] = r_value**2
    except Exception:
        pass

    # 3. РџСЂРѕРІРµСЂРєР° СЃРµР·РѕРЅРЅРѕСЃС‚Рё (FFT)
    try:
        from scipy.fft import fft
        fft_vals = np.abs(fft(series.values - series.mean()))
        fft_vals = fft_vals[1:len(fft_vals)//2]  # РЈР±РёСЂР°РµРј РїРѕСЃС‚РѕСЏРЅРЅСѓСЋ СЃРѕСЃС‚Р°РІР»СЏСЋС‰СѓСЋ
        if len(fft_vals) > 0:
            # РС‰РµРј РґРѕРјРёРЅРёСЂСѓСЋС‰СѓСЋ С‡Р°СЃС‚РѕС‚Сѓ
            dominant_freq_idx = np.argmax(fft_vals)
            dominant_amplitude = fft_vals[dominant_freq_idx]
            mean_amplitude = np.mean(fft_vals)
            # Р•СЃР»Рё Р°РјРїР»РёС‚СѓРґР° РґРѕРјРёРЅРёСЂСѓСЋС‰РµР№ С‡Р°СЃС‚РѕС‚С‹ РІ 3+ СЂР°Р·Р° РІС‹С€Рµ СЃСЂРµРґРЅРµР№ вЂ” РµСЃС‚СЊ СЃРµР·РѕРЅРЅРѕСЃС‚СЊ
            props['has_seasonality'] = dominant_amplitude > 3 * mean_amplitude
            props['seasonal_strength'] = dominant_amplitude / mean_amplitude if mean_amplitude > 0 else 0
    except Exception:
        pass

    return props


# в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
