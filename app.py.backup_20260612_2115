                        fig_acf.add_hline(y=-conf_int, line_dash="dash", line_color="red")
                        fig_acf.update_layout(height=600, showlegend=False)  # вњ… РЈР¶Рµ 600
                        st.plotly_chart(fig_acf, use_container_width=True, key="acf_pacf_chart")
                    
                    # в”Ђв”Ђ РђР’РўРћРџРћР”Р‘РћР  Р›РђР“РћР’ Р§Р•Р Р•Р— ACF/PACF в”Ђв”Ђв”Ђв”Ђв”Ђ
                    st.divider()
                    st.markdown("###### РђРІС‚РѕРїРѕРґР±РѕСЂ Р»Р°РіРѕРІ С‡РµСЂРµР· ACF/PACF")
                    
                    if st.button(" РђРІС‚РѕРјР°С‚РёС‡РµСЃРєРё РѕРїСЂРµРґРµР»РёС‚СЊ Р·РЅР°С‡РёРјС‹Рµ Р»Р°РіРё", key="btn_auto_lags"):
                        from statsmodels.tsa.stattools import acf, pacf
                        
                        max_lag = min(60, len(series) // 4)
                        acf_values = acf(series, nlags=max_lag)
                        pacf_values = pacf(series, nlags=max_lag)
                        conf_int = 1.96 / np.sqrt(len(series))
                        
                        # РќР°С…РѕРґРёРј Р·РЅР°С‡РёРјС‹Рµ Р»Р°РіРё
                        significant_acf = np.where(np.abs(acf_values[1:]) > conf_int)[0] + 1
                        significant_pacf = np.where(np.abs(pacf_values[1:]) > conf_int)[0] + 1
                        
                        # Р РµРєРѕРјРµРЅРґСѓРµРјС‹Рµ Р»Р°РіРё (РїРµСЂРІС‹Рµ 5 Р·РЅР°С‡РёРјС‹С…)
                        recommended_lags = sorted(set(significant_acf.tolist() + significant_pacf.tolist()))[:10]
                        
                        st.session_state.recommended_lags = recommended_lags
                        
                        st.success(f"вњ… РћР±РЅР°СЂСѓР¶РµРЅРѕ {len(recommended_lags)} Р·РЅР°С‡РёРјС‹С… Р»Р°РіРѕРІ: {recommended_lags}")
                        st.info("рџ’Ў Р­С‚Рё Р»Р°РіРё Р±СѓРґСѓС‚ РёСЃРїРѕР»СЊР·РѕРІР°РЅС‹ РїСЂРё СЃРѕР·РґР°РЅРёРё РїСЂРёР·РЅР°РєРѕРІ")
                    
                    # РЎРѕС…СЂР°РЅРµРЅРёРµ СЂРµР·СѓР»СЊС‚Р°С‚РѕРІ СЃРїРµРєС‚СЂР°Р»СЊРЅРѕРіРѕ Р°РЅР°Р»РёР·Р°
                    st.session_state.spectral_analysis = {
                        'dominant_periods': dominant_periods,
                        'spectral_energy': spectral_energy,
                        'spectral_entropy': spectral_entropy,
                        'low_high_ratio': ratio
                    }
            
            except Exception as e:
                st.error(f"вќЊ РћС€РёР±РєР° СЃРїРµРєС‚СЂР°Р»СЊРЅРѕРіРѕ Р°РЅР°Р»РёР·Р°: {e}")
            
            st.markdown("<div style='margin-top: 28px;'></div>", unsafe_allow_html=True)
            
