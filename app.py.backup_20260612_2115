            with col2:
                st.markdown("##### рџ“Љ Р“РёСЃС‚РѕРіСЂР°РјРјР° СЃ РјРµС‚СЂРёРєР°РјРё")

                mean_val = df[selected_col].mean()
                median_val = df[selected_col].median()
                q1_val = df[selected_col].quantile(0.25)
                q3_val = df[selected_col].quantile(0.75)
