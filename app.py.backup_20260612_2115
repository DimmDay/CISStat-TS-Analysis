def generate_validation_report(df, val_results):
    import pandas as pd
    import datetime

    miss_summary = val_results.get('miss', {}).get('summary', {})
    outl_summary = val_results.get('outl', {}).get('summary', {})
    ts_data = val_results.get('ts', {})
    total_rows = len(df)

    missing_count = miss_summary.get('total_missing', 0)
    missing_pct = miss_summary.get('missing_rate_pct', (missing_count / total_rows * 100) if total_rows > 0 else 0.0)
    outlier_count = outl_summary.get('total_outliers', 0)
    outlier_pct = outl_summary.get('outlier_rate_pct', (outlier_count / total_rows * 100) if total_rows > 0 else 0.0)

    summary_data = {
        "РџР°СЂР°РјРµС‚СЂ": [
            "РќР°Р·РІР°РЅРёРµ С„Р°Р№Р»Р°", "Р”Р°С‚Р° Р°РЅР°Р»РёР·Р°", "Р’СЃРµРіРѕ Р·Р°РїРёСЃРµР№", "Р’СЃРµРіРѕ РєРѕР»РѕРЅРѕРє",
            "РќР°Р№РґРµРЅРѕ РїСЂРѕРїСѓСЃРєРѕРІ (С€С‚)", "РќР°Р№РґРµРЅРѕ РїСЂРѕРїСѓСЃРєРѕРІ (%)",
            "РќР°Р№РґРµРЅРѕ РІС‹Р±СЂРѕСЃРѕРІ (С€С‚)", "РќР°Р№РґРµРЅРѕ РІС‹Р±СЂРѕСЃРѕРІ (%)",
            "РЎС‚Р°С†РёРѕРЅР°СЂРЅРѕСЃС‚СЊ СЂСЏРґР° (ADF)", "Р§Р°СЃС‚РѕС‚Р° СЂСЏРґР° (Inferred)"
        ],
        "Р—РЅР°С‡РµРЅРёРµ": [
            st.session_state.get("original_filename", "Unknown"),
            datetime.datetime.now().strftime("%Y-%m-%d %H:%M"),
            total_rows, len(df.columns),
            missing_count, f"{missing_pct:.2f}%",
            outlier_count, f"{outlier_pct:.2f}%",
            "Р”Р°" if ts_data.get('is_stationary') else "РќРµС‚",
            ts_data.get('frequency', 'N/A')
        ]
    }
    df_summary = pd.DataFrame(summary_data)

    all_issues = []
    # ... (РЎР±РѕСЂ РїСЂРѕР±Р»РµРј РёР· val_results: РџСЂРѕРїСѓСЃРєРё, Р’С‹Р±СЂРѕСЃС‹, Р”РёР°РїР°Р·РѕРЅС‹, РЈРЅРёРєР°Р»СЊРЅРѕСЃС‚СЊ)
    for col, stats in val_results.get('miss', {}).get('columns', {}).items():
        if isinstance(stats, dict) and stats.get('count', 0) > 0:
            all_issues.append({"РўРёРї РїСЂРѕРІРµСЂРєРё": "РџСЂРѕРїСѓСЃРєРё", "РљРѕР»РѕРЅРєР°": col, "РџСЂРѕР±Р»РµРјР°": f"{stats['count']} С€С‚ ({stats.get('percent', 0):.1f}%)", "Р РµРєРѕРјРµРЅРґР°С†РёСЏ": "Р—Р°РїРѕР»РЅРёС‚СЊ"})
    for col, stats in val_results.get('outl', {}).get('columns', {}).items():
        if isinstance(stats, dict) and stats.get('count', 0) > 0:
            all_issues.append({"РўРёРї РїСЂРѕРІРµСЂРєРё": "Р’С‹Р±СЂРѕСЃС‹", "РљРѕР»РѕРЅРєР°": col, "РџСЂРѕР±Р»РµРјР°": f"{stats['count']} С€С‚ ({stats.get('percent', 0):.1f}%)", "Р РµРєРѕРјРµРЅРґР°С†РёСЏ": "РљСЌРїРёСЂРѕРІР°С‚СЊ"})
    for issue in val_results.get('range_results', []):
        if isinstance(issue, dict):
            all_issues.append({"РўРёРї РїСЂРѕРІРµСЂРєРё": "Р”РёР°РїР°Р·РѕРЅС‹", "РљРѕР»РѕРЅРєР°": issue.get('РљРѕР»РѕРЅРєР°'), "РџСЂРѕР±Р»РµРјР°": f"{issue.get('РќР°СЂСѓС€РµРЅРёР№')} РЅР°СЂСѓС€РµРЅРёР№", "Р РµРєРѕРјРµРЅРґР°С†РёСЏ": "РљСЌРїРёСЂРѕРІР°С‚СЊ"})

    df_issues = pd.DataFrame(all_issues) if all_issues else pd.DataFrame(columns=["РўРёРї РїСЂРѕРІРµСЂРєРё", "РљРѕР»РѕРЅРєР°", "РџСЂРѕР±Р»РµРјР°", "Р РµРєРѕРјРµРЅРґР°С†РёСЏ"])

    ts_summary = {
        "РњРµС‚СЂРёРєР°": ["РЎС‚Р°С†РёРѕРЅР°СЂРЅРѕСЃС‚СЊ (ADF p-value)", "Р§Р°СЃС‚РѕС‚Р° (Frequency)", "РњР°РєСЃ. СЂР°Р·СЂС‹РІ (Max Gap)", "РЎС‚Р°С‚СѓСЃ TS"],
        "Р—РЅР°С‡РµРЅРёРµ": [ts_data.get('adf_pvalue', 'N/A'), ts_data.get('frequency', 'N/A'), str(ts_data.get('max_gap', 'N/A')), ts_data.get('error', 'Р“РѕС‚РѕРІРѕ Рє Р°РЅР°Р»РёР·Сѓ')]
    }
    df_ts = pd.DataFrame(ts_summary)

    filename = f"Statcom_DQ_Report_{datetime.datetime.now().strftime('%Y%m%d_%H%M')}.xlsx"
    with pd.ExcelWriter(filename, engine='openpyxl') as writer:
        df_summary.to_excel(writer, sheet_name='1_РЎРІРѕРґРєР°', index=False)
        df_issues.to_excel(writer, sheet_name='2_РџСЂРѕР±Р»РµРјС‹', index=False)
        df_ts.to_excel(writer, sheet_name='3_TS_Props', index=False)

    return filename

