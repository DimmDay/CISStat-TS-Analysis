            # в”Ђв”Ђ РџР РђР’РђРЇ Р§РђРЎРўР¬: РџРћРЇРЎРќР•РќРРЇ в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
            with col_corr2:
                st.markdown("### **РџРѕСЏСЃРЅРµРЅРёСЏ Рє РєРѕСЂСЂРµР»СЏС†РёСЏРј**")

                # РђРЅР°Р»РёР· Р·РЅР°С‡РёРјС‹С… СЃРІСЏР·РµР№ (r >= 0.5 РёР»Рё r <= -0.5)
                significant_links = []
                for i in range(len(corr_matrix.columns)):
                    for j in range(i + 1, len(corr_matrix.columns)):
                        val = corr_matrix.iloc[i, j]
                        if abs(val) >= 0.5:  # РџРѕСЂРѕРі Р·РЅР°С‡РёРјРѕСЃС‚Рё
                            col1, col2 = corr_matrix.columns[i], corr_matrix.columns[j]
                            strength = "РЎРёР»СЊРЅР°СЏ" if abs(val) >= 0.7 else "РЈРјРµСЂРµРЅРЅР°СЏ"
                            direction = "РїСЂСЏРјР°СЏ (+)" if val > 0 else "РѕР±СЂР°С‚РЅР°СЏ (-)"
                            significant_links.append({
                                "pair": f"{col1} в†” {col2}",
                                "val": val,
                                "desc": f"{strength} {direction} СЃРІСЏР·СЊ (`r = {val:.2f}`)"
                            })

                if significant_links:
                    st.info(f"РќР°Р№РґРµРЅРѕ {len(significant_links)} Р·РЅР°С‡РёРјС‹С… СЃРІСЏР·РµР№ (|r| в‰Ґ 0.5):")
                    for item in significant_links:
                        st.markdown(f"- **{item['pair']}**: {item['desc']}")
                        if abs(item['val']) >= 0.85:
                            st.error("вљ пёЏ **РљСЂРёС‚РёС‡РµСЃРєР°СЏ РєРѕСЂСЂРµР»СЏС†РёСЏ!** Р’РѕР·РјРѕР¶РЅР° РјСѓР»СЊС‚РёРєРѕР»Р»РёРЅРµР°СЂРЅРѕСЃС‚СЊ РёР»Рё РґСѓР±Р»РёСЂРѕРІР°РЅРёРµ РґР°РЅРЅС‹С….")
                else:
                    st.success("вњ… Р—РЅР°С‡РёРјС‹С… Р»РёРЅРµР№РЅС‹С… СЃРІСЏР·РµР№ РјРµР¶РґСѓ С‡РёСЃР»РѕРІС‹РјРё РїСЂРёР·РЅР°РєР°РјРё РЅРµ РѕР±РЅР°СЂСѓР¶РµРЅРѕ.")
                    st.markdown("**РРЅС‚РµСЂРїСЂРµС‚Р°С†РёСЏ:** РќР°Р±Р»СЋРґРµРЅРёСЏ РЅРµР·Р°РІРёСЃРёРјС‹ РґСЂСѓРі РѕС‚ РґСЂСѓРіР°, С‡С‚Рѕ СЏРІР»СЏРµС‚СЃСЏ С…РѕСЂРѕС€РёРј РїСЂРёР·РЅР°РєРѕРј РґР»СЏ РјРѕРґРµР»РµР№ РјР°С€РёРЅРЅРѕРіРѕ РѕР±СѓС‡РµРЅРёСЏ.")

                    # РџРѕРєР°Р·С‹РІР°РµРј СЃР»Р°Р±С‹Рµ СЃРІСЏР·Рё, РµСЃР»Рё РёС… РЅРµС‚ Р·РЅР°С‡РёРјС‹С…
                    if st.checkbox("РџРѕРєР°Р·Р°С‚СЊ СЃР»Р°Р±С‹Рµ СЃРІСЏР·Рё (0.3 < |r| < 0.5)", key="show_weak_corr"):
                        weak_links = []
                        for i in range(len(corr_matrix.columns)):
                            for j in range(i + 1, len(corr_matrix.columns)):
                                val = corr_matrix.iloc[i, j]
                                if 0.3 <= abs(val) < 0.5:
                                    col1, col2 = corr_matrix.columns[i], corr_matrix.columns[j]
                                    weak_links.append(f"{col1} в†” {col2} (`r={val:.2f}`)")
                        if weak_links:
                            st.caption(", ".join(weak_links))
        else:
            st.info("Р”Р»СЏ РєРѕСЂСЂРµР»СЏС†РёРѕРЅРЅРѕРіРѕ Р°РЅР°Р»РёР·Р° РЅРµРѕР±С…РѕРґРёРјРѕ РјРёРЅРёРјСѓРј 2 С‡РёСЃР»РѕРІС‹Рµ РєРѕР»РѕРЅРєРё.")

    # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
    #  Р’РђР РРђРўРР’РќРђРЇ Р’РР—РЈРђР›РР—РђР¦РРЇ (df_filtered)
    # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
    st.divider()
    st.markdown("### Р’Р°СЂРёР°С‚РёРІРЅР°СЏ РІРёР·СѓР°Р»РёР·Р°С†РёСЏ")
    st.caption("РРЅС‚РµСЂР°РєС‚РёРІРЅР°СЏ С„РёР»СЊС‚СЂР°С†РёСЏ РґР°РЅРЅС‹С… РїРѕ РєР°С‚РµРіРѕСЂРёСЏРј Рё РІСЂРµРјРµРЅРЅС‹Рј РїРµСЂРёРѕРґР°Рј. Р”РёРЅР°РјРёС‡РµСЃРєРѕРµ РїРµСЂРµРєР»СЋС‡РµРЅРёРµ РјРµР¶РґСѓ РѕР±С‰РёРј Р°РЅР°Р»РёР·РѕРј Рё РІРёР·СѓР°Р»РёР·Р°С†РёРµР№ РІСЂРµРјРµРЅРЅС‹С… СЂСЏРґРѕРІ РґР»СЏ РёСЃСЃР»РµРґРѕРІР°РЅРёСЏ РїР°С‚С‚РµСЂРЅРѕРІ РІ РїРѕРґРІС‹Р±РѕСЂРєР°С….")

    # рџ”№ Р­РљРЎРџРђРќР”Р•Р : Р·Р°РіРѕР»РѕРІРѕРє РІРёРґРµРЅ, РєРѕРЅС‚РµРЅС‚ СЃРєСЂС‹С‚ РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ
    with st.expander(" РџРѕРєР°Р·Р°С‚СЊ РїР°РЅРµР»СЊ С„РёР»СЊС‚СЂРѕРІ Рё РІРёР·СѓР°Р»РёР·Р°С†РёРё", expanded=False):

        # РљР°С‚РµРіРѕСЂРёР°Р»СЊРЅС‹Рµ РєРѕР»РѕРЅРєРё РґР»СЏ С„РёР»СЊС‚СЂРѕРІ
        cat_cols = df.select_dtypes(include=['object', 'string']).columns.tolist()
        if not cat_cols:
            cat_cols = [c for c in df.select_dtypes(include='number').columns if 1 < df[c].nunique() < 100]

        # РџСЂРёРѕСЂРёС‚РµС‚РЅС‹Рµ РєРѕР»РѕРЅРєРё
        for p in ["Country", "Region", "Р РµРіРёРѕРЅ", "РЎС‚СЂР°РЅР°", "РљР°С‚РµРіРѕСЂРёСЏ", "Product"]:
            if p in cat_cols:
                cat_cols.insert(0, cat_cols.pop(cat_cols.index(p)))

        category_col_1 = st.selectbox(
            "рџ“‚ РџРµСЂРІР°СЏ РєР°С‚РµРіРѕСЂРёСЏ",
            options=cat_cols + ["(РЅРµС‚)"],
            index=0 if cat_cols else len(cat_cols),
            key="sel_cat1"
        )
        category_col_2 = st.selectbox(
            "рџ“‚ Р’С‚РѕСЂР°СЏ РєР°С‚РµРіРѕСЂРёСЏ (РѕРїС†РёРѕРЅР°Р»СЊРЅРѕ)",
            options=cat_cols + ["(РЅРµС‚)"],
            index=len(cat_cols),
            key="sel_cat2"
        )

        if category_col_1 != "(РЅРµС‚)" and category_col_1 == category_col_2:
            st.warning("вљ пёЏ Р’С‹ РІС‹Р±СЂР°Р»Рё РѕРґРЅСѓ Рё С‚Сѓ Р¶Рµ РєРѕР»РѕРЅРєСѓ РґРІР°Р¶РґС‹. Р’С‚РѕСЂР°СЏ РєР°С‚РµРіРѕСЂРёСЏ Р±СѓРґРµС‚ РїСЂРѕРёРіРЅРѕСЂРёСЂРѕРІР°РЅР°.")

        if category_col_1 != "(РЅРµС‚)":
            all_cat1 = sorted(df[category_col_1].dropna().astype(str).unique().tolist())
            selected_cat1 = st.multiselect(
                f"рџ”ў Р—РЅР°С‡РµРЅРёСЏ: {category_col_1}",
                options=all_cat1,
                default=[],
                key="filt_cat1",
                placeholder="Р’С‹Р±РµСЂРёС‚Рµ..."
            )
        else:
            selected_cat1 = []

        if category_col_2 != "(РЅРµС‚)" and category_col_2 != category_col_1:
            all_cat2 = sorted(df[category_col_2].dropna().astype(str).unique().tolist())
            selected_cat2 = st.multiselect(
                f"рџ”ў Р—РЅР°С‡РµРЅРёСЏ: {category_col_2}",
                options=all_cat2,
                default=[],
                key="filt_cat2",
                placeholder="Р’С‹Р±РµСЂРёС‚Рµ..."
            )
        else:
            selected_cat2 = []

        # Р’СЂРµРјРµРЅРЅР°СЏ РєРѕР»РѕРЅРєР°
        datetime_cols = df.select_dtypes(include=['datetime64[ns]']).columns.tolist()
        num_year_cols = [c for c in df.select_dtypes(include='number').columns if 'year' in c.lower() or 'РіРѕРґ' in c.lower()]
        time_cols = datetime_cols + [c for c in num_year_cols if c not in datetime_cols]

        for p in ["Year", "Date", "Р“РѕРґ", "Р”Р°С‚Р°"]:
            if p in time_cols:
                time_cols.insert(0, time_cols.pop(time_cols.index(p)))

        if time_cols:
            time_col = st.selectbox("рџ“… Р’СЂРµРјРµРЅРЅР°СЏ РєРѕР»РѕРЅРєР°", options=time_cols, index=0, key="selector_time_col")
        else:
            time_col = None
            st.caption("в„№пёЏ Р’ РґР°С‚Р°СЃРµС‚Рµ РЅРµ РЅР°Р№РґРµРЅРѕ РєРѕР»РѕРЅРѕРє СЃ РґР°С‚Р°РјРё РёР»Рё РіРѕРґР°РјРё")

        # Р¤РёР»СЊС‚СЂ РїРѕ РіРѕРґР°Рј
        if time_col and time_cols:
            if time_col in datetime_cols:
                df['_tmp_year'] = df[time_col].dt.year.astype(str)
                all_years = sorted(df['_tmp_year'].dropna().unique().tolist(), reverse=True)
                time_col_filter = '_tmp_year'
            else:
                all_years = sorted(df[time_col].dropna().unique().astype(int).astype(str).tolist(), reverse=True)
                time_col_filter = time_col

            selected_years = st.multiselect(
                "рџ“… Р“РѕРґС‹",
                options=all_years,
                default=[],
                key="filt_years",
                placeholder="Р’С‹Р±РµСЂРёС‚Рµ РіРѕРґС‹..."
            )
            if not selected_years:
                selected_years = all_years
        else:
            all_years, selected_years, time_col_filter = [], [], None

        # в”Ђв”Ђ РџР РРњР•РќР•РќРР• Р¤РР›Р¬РўР РћР’ в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
        df_filtered = df.copy()

        if selected_cat1 and category_col_1 != "(РЅРµС‚)":
            df_filtered = df_filtered[df_filtered[category_col_1].astype(str).isin(selected_cat1)]
        if selected_cat2 and category_col_2 != "(РЅРµС‚)":
            df_filtered = df_filtered[df_filtered[category_col_2].astype(str).isin(selected_cat2)]
        if selected_years and time_col_filter and time_col_filter in df_filtered.columns:
            df_filtered = df_filtered[df_filtered[time_col_filter].astype(str).isin(selected_years)]
        if time_col and time_col in df_filtered.columns:
            df_filtered = df_filtered.sort_values(time_col).reset_index(drop=True)
        if '_tmp_year' in df_filtered.columns:
            df_filtered = df_filtered.drop(columns=['_tmp_year'])

        st.caption(
            f"рџ“Љ РђРєС‚РёРІРЅРѕ: {len(df_filtered)} Р·Р°РїРёСЃРµР№ | "
            f"{len(selected_cat1)} Р·РЅР°С‡РµРЅРёР№ (РєР°С‚.1) | "
            f"{len(selected_cat2)} Р·РЅР°С‡РµРЅРёР№ (РєР°С‚.2) | "
            f"{len(selected_years)} Р»РµС‚"
        )

        if df_filtered.empty:
            st.warning("вљ пёЏ РќРµС‚ РґР°РЅРЅС‹С… РґР»СЏ РѕС‚РѕР±СЂР°Р¶РµРЅРёСЏ. РР·РјРµРЅРёС‚Рµ С„РёР»СЊС‚СЂС‹.")
            st.stop()

        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
        #  2. РџРћР”Р“РћРўРћР’РљРђ РњР•РўР РРљ Р TS MODE (ct_f, ts_mode_active)
        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
        # РћРїСЂРµРґРµР»СЏРµРј РєРѕРЅСЃС‚Р°РЅС‚С‹ СЂРµР¶РёРјРѕРІ, РµСЃР»Рё РёС… РЅРµС‚ РіР»РѕР±Р°Р»СЊРЅРѕ
        MODE_TS = "Р’СЂРµРјРµРЅРЅС‹Рµ СЂСЏРґС‹"
        MODE_GEN = "РћР±С‰РёР№ (РєР°С‚РµРіРѕСЂРёРё)"

        ct_f = {
            "num": df_filtered.select_dtypes(include='number').columns.tolist(),
            "cat": [c for c in df_filtered.select_dtypes(include=['object', 'string']).columns if 1 < df_filtered[c].nunique() < 100],
            "date": df_filtered.select_dtypes(include='datetime').columns.tolist()
        }

        # РРЅРёС†РёР°Р»РёР·РёСЂСѓРµРј ts_mode_active
        ts_mode_active = False
        df_ts = pd.DataFrame()

        if ct_f["date"] and ct_f["num"]:
            date_col = ct_f["date"][0]
            df_ts = df_filtered.sort_values(by=date_col).set_index(date_col).copy()
            ts_mode_active = True

        # РђРІС‚РѕРјР°С‚РёС‡РµСЃРєР°СЏ СѓСЃС‚Р°РЅРѕРІРєР° СЂРµР¶РёРјР° РІРёР·СѓР°Р»РёР·Р°С†РёРё
        default_mode = MODE_TS if ts_mode_active else MODE_GEN

        if "viz_mode_toggle" not in st.session_state:
            st.session_state.viz_mode_toggle = default_mode
        elif ts_mode_active and st.session_state.viz_mode_toggle == MODE_GEN:
            # Р•СЃР»Рё TS Р°РєС‚РёРІРёСЂРѕРІР°РЅ, РЅРѕ РІС‹Р±СЂР°РЅ РѕР±С‰РёР№ СЂРµР¶РёРј вЂ” РїРµСЂРµРєР»СЋС‡Р°РµРј РЅР° TS
            # (С‚РѕР»СЊРєРѕ РїСЂРё РїРµСЂРІРѕР№ РёРЅРёС†РёР°Р»РёР·Р°С†РёРё РёР»Рё СЃРјРµРЅРµ РґР°РЅРЅС‹С…)
            if "last_data_hash" not in st.session_state or st.session_state.get("last_data_hash") != hash(df_filtered.to_string()):
                st.session_state.viz_mode_toggle = MODE_TS
                st.session_state.last_data_hash = hash(df_filtered.to_string())

        # РЎРѕС…СЂР°РЅСЏРµРј С…СЌС€ РґР°РЅРЅС‹С… РґР»СЏ РѕС‚СЃР»РµР¶РёРІР°РЅРёСЏ РёР·РјРµРЅРµРЅРёР№
        if "last_data_hash" not in st.session_state:
            st.session_state.last_data_hash = hash(df_filtered.to_string())

        if ts_mode_active:
            # РџРѕРєР°Р·С‹РІР°РµРј РјРµС‚СЂРёРєРё РўРћР›Р¬РљРћ РµСЃР»Рё СЂРµР¶РёРј TS
            if st.session_state.viz_mode_toggle == MODE_TS:
                c1, c2, c3 = st.columns(3)
                with c1:
                    st.metric("РџРµСЂРёРѕРґ", f"{df_ts.index.min().date()} вЂ” {df_ts.index.max().date()}")
                with c2:
                    st.metric("Р—Р°РїРёСЃРµР№", f"{len(df_ts):,}".replace(",", " "))
                with c3:
                    # Р‘РµР·РѕРїР°СЃРЅРѕРµ РѕРїСЂРµРґРµР»РµРЅРёРµ С‡Р°СЃС‚РѕС‚С‹
                    try:
                        freq = pd.infer_freq(df_ts.index) if len(df_ts.index) >= 3 else None
                    except ValueError:
                        freq = None
                    freq_label = freq if freq else "РќРµСЂРµРіСѓР»СЏСЂРЅР°СЏ"
                    st.metric("Р§Р°СЃС‚РѕС‚Р°", freq_label)
        else:
            # Р•СЃР»Рё TS РЅРµ Р°РєС‚РёРІРµРЅ вЂ” РїСЂРёРЅСѓРґРёС‚РµР»СЊРЅРѕ РѕР±С‰РёР№ СЂРµР¶РёРј
            st.session_state.viz_mode_toggle = MODE_GEN
