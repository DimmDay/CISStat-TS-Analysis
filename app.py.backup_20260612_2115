                                color_continuous_scale='Viridis',
                                aspect='auto'  # РђРІС‚РѕРјР°С‚РёС‡РµСЃРєРѕРµ СЃРѕРѕС‚РЅРѕС€РµРЅРёРµ СЃС‚РѕСЂРѕРЅ
                            )

                            fig_wave.update_layout(
                                height=600,  # вњ… РЈР¶Рµ 600
                                yaxis=dict(
                                    scaleanchor='x',
                                    scaleratio=0.3,  # РЎРѕРѕС‚РЅРѕС€РµРЅРёРµ Y Рє X (СѓРІРµР»РёС‡РёРІР°РµС‚ Y)
                                    title='РњР°СЃС€С‚Р°Р± (РїРµСЂРёРѕРґ)',
                                    tickmode='linear',
                                    tick0=0,
                                    dtick=20  # РЁР°Рі РјРµС‚РѕРє РїРѕ Y
                                ),
                                xaxis=dict(
                                    title='Р’СЂРµРјСЏ',
                                    tickmode='linear',
                                    tick0=0,
                                    dtick=1000  # РЁР°Рі РјРµС‚РѕРє РїРѕ X (1k, 2k, 3k...)
                                )
                            )

                            st.plotly_chart(fig_wave, use_container_width=True, key="wavelet_chart")
                        except ImportError:
                            st.warning("вљ пёЏ РЈСЃС‚Р°РЅРѕРІРёС‚Рµ PyWavelets: `pip install PyWavelets`")

                    with tab_acf:
                        from statsmodels.tsa.stattools import acf, pacf
                        
                        max_lag = min(60, len(series) // 4)
                        acf_values = acf(series, nlags=max_lag)
                        pacf_values = pacf(series, nlags=max_lag)
                        
                        fig_acf = make_subplots(
                            rows=2, cols=1,
                            subplot_titles=("РђРІС‚РѕРєРѕСЂСЂРµР»СЏС†РёРѕРЅРЅР°СЏ С„СѓРЅРєС†РёСЏ (ACF)", 
                                        "Р§Р°СЃС‚РЅР°СЏ Р°РІС‚РѕРєРѕСЂСЂРµР»СЏС†РёРѕРЅРЅР°СЏ С„СѓРЅРєС†РёСЏ (PACF)")
                        )

                        fig_acf.add_trace(
                            go.Bar(x=list(range(len(acf_values))), y=acf_values, name='ACF'),
