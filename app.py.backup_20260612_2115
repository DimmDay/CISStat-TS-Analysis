            # РљРЅРѕРїРєР° СЃРѕС…СЂР°РЅРµРЅРёСЏ
            c_save1, c_save2 = st.columns([4, 1])
            with c_save1:
                st.caption("рџ’Ў РћС‚СЂРµРґР°РєС‚РёСЂСѓР№С‚Рµ РІСЂСѓС‡РЅСѓСЋ РёР»Рё РёСЃРїРѕР»СЊР·СѓР№С‚Рµ СЃС‚СЂР°С‚РµРіРёРё РЅРёР¶Рµ")
            with c_save2:
                if st.button("рџ’ѕ РЎРѕС…СЂР°РЅРёС‚СЊ", key="btn_save_manual_missing", use_container_width=True):
