                "**в—»пёЏ Р’Р»РёСЏРЅРёРµ РЅР° TS:** РћС€РёР±РѕС‡РЅС‹Рµ РєР»СЋС‡Рё Р»РѕРјР°СЋС‚ `groupby`, `pivot`, `resample`.  \n"
                "**в—»пёЏ РћРїРёСЃР°РЅРёРµ:** РњРѕРґСѓР»СЊ РїСЂРѕРІРµСЂСЏРµС‚ РґР°РЅРЅС‹Рµ РЅР° СЃРѕРѕС‚РІРµС‚СЃС‚РІРёРµ СЂРµРіСѓР»СЏСЂРЅС‹Рј РІС‹СЂР°Р¶РµРЅРёСЏРј РёР· СЃРїСЂР°РІРѕС‡РЅРёРєР° РїР»Р°С‚С„РѕСЂРјС‹ "
                "(email, С‚РµР»РµС„РѕРЅ, РґР°С‚Р°, РєРѕРґ Рё С‚.Рґ.). Р—РЅР°С‡РµРЅРёСЏ, РЅРµ РїСЂРѕС…РѕРґСЏС‰РёРµ РІР°Р»РёРґР°С†РёСЋ, С„РёРєСЃРёСЂСѓСЋС‚СЃСЏ РґР»СЏ РёСЃРїСЂР°РІР»РµРЅРёСЏ Рё РїСЂРµРґР»Р°РіР°СЋС‚СЃСЏ СЃС‚СЂР°С‚РµРіРёРё РёС… РѕР±СЂР°Р±РѕС‚РєРё."
            ),
            result_text=res_text,
            result_status="вњ…" if not pattern_issues else "вљ пёЏ",
            fix_action=None
        )

        # в”Ђв”Ђ рџ”§ РРќРўР•Р РђРљРўРР’РќР«Р™ РџРђР™РџР›РђР™Рќ РћР‘Р РђР‘РћРўРљР (СЂР°СЃРєСЂС‹РІР°РµС‚СЃСЏ РїСЂРё РЅР°СЂСѓС€РµРЅРёСЏС…) в”Ђв”Ђ
        if pattern_issues:
            with st.expander("рџ“‹ РџРѕРєР°Р·Р°С‚СЊ РґРµС‚Р°Р»Рё РЅР°СЂСѓС€РµРЅРёР№", expanded=True):
                # РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ СЂР°Р±РѕС‡РµРіРѕ РґР°С‚Р°С„СЂРµР№РјР° РґР»СЏ РјРѕРґСѓР»СЏ С„РѕСЂРјР°С‚РѕРІ
                if "df_pattern_work" not in st.session_state:
                    st.session_state.df_pattern_work = df.copy()
                df_work = st.session_state.df_pattern_work

                for v in real_violations:
                    col_name = v.get("РљРѕР»РѕРЅРєР°")
