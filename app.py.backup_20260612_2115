        # РљРЅРѕРїРєР° Р·Р°РїСѓСЃРєР° Р°РЅР°Р»РёР·Р°
        if st.button(" Р Р°СЃСЃС‡РёС‚Р°С‚СЊ СЃРІРѕР№СЃС‚РІР° СЂСЏРґР°", type="primary", key="btn_calc_props"):
            with st.spinner("Р’С‹РїРѕР»РЅСЏРµРј СЃС‚Р°С‚РёСЃС‚РёС‡РµСЃРєРёРµ С‚РµСЃС‚С‹..."):
                try:
                    # 1. РџРѕРґРіРѕС‚РѕРІРєР° РґР°РЅРЅС‹С…
                    if ts_mode_active and target_col in df_ts.columns:
                        analysis_series = df_ts[target_col].resample('D').mean().dropna().astype(float)
