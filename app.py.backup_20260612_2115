            # в”Ђв”Ђ Р¤РЈРќРљР¦РРЇ РўР•РЎРўРђ РќРђ Р“Р•РўР•Р РћРЎРљР•Р”РђРЎРўРР§РќРћРЎРўР¬ в”Ђв”Ђв”Ђв”Ђв”Ђ
            def test_heteroskedasticity(series, window=30):
                """РўРµСЃС‚ РЅР° РіРµС‚РµСЂРѕСЃРєРµРґР°СЃС‚РёС‡РЅРѕСЃС‚СЊ С‡РµСЂРµР· СЃРєРѕР»СЊР·СЏС‰РµРµ std"""
                if len(series) < window * 2:
                    return {
                        'bp_pvalue': None,
                        'is_hetero': None,
                        'rolling_std_corr': None,
                        'amplitude_ratio': None
                    }
                
                # 1. РўРµСЃС‚ Р‘СЂРѕР№С€Р°-РџР°РіР°РЅР° (РµСЃР»Рё РµСЃС‚СЊ statsmodels)
                try:
                    from statsmodels.stats.diagnostic import het_breuschpagan
                    import statsmodels.api as sm
                    
                    # Р РµРіСЂРµСЃСЃРёСЏ РЅР° С‚СЂРµРЅРґ РґР»СЏ РїРѕР»СѓС‡РµРЅРёСЏ РѕСЃС‚Р°С‚РєРѕРІ
                    X = sm.add_constant(np.arange(len(series)))
                    model = sm.OLS(series, X).fit()
                    resid = model.resid
                    
                    # РўРµСЃС‚ Р‘СЂРѕР№С€Р°-РџР°РіР°РЅР°
                    _, bp_pvalue, _, _ = het_breuschpagan(resid, X)
                    is_hetero = bp_pvalue < 0.05
                except Exception:
                    bp_pvalue = None
                    is_hetero = None
                
                # 2. РљРѕСЂСЂРµР»СЏС†РёСЏ РјРµР¶РґСѓ rolling_std Рё rolling_mean
                rolling_mean = series.rolling(window=window).mean()
                rolling_std = series.rolling(window=window).std()
                
                valid_mask = rolling_mean.notna() & rolling_std.notna() & (rolling_std > 0)
                if valid_mask.sum() > 10:
                    corr = rolling_mean[valid_mask].corr(rolling_std[valid_mask])
                else:
                    corr = None
                
                # 3. РћС‚РЅРѕС€РµРЅРёРµ Р°РјРїР»РёС‚СѓРґ (РїРѕСЃР»РµРґРЅСЏСЏ С‚СЂРµС‚СЊ / РїРµСЂРІР°СЏ С‚СЂРµС‚СЊ)
                n = len(series)
                first_third = series.iloc[:n//3]
                last_third = series.iloc[2*n//3:]
                if len(first_third) > 0 and len(last_third) > 0:
                    amplitude_ratio = last_third.std() / (first_third.std() + 1e-10)
                else:
