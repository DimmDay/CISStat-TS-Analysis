                )

                # рџ’ѕ РљРќРћРџРљРђ РЎРћРҐР РђРќР•РќРРЇ
                c_save1, c_save2 = st.columns([4, 1])
                with c_save1:
                    st.caption("рџ’Ў РћС‚СЂРµРґР°РєС‚РёСЂСѓР№С‚Рµ Р·РЅР°С‡РµРЅРёСЏ РІСЂСѓС‡РЅСѓСЋ РёР»Рё РІС‹Р±РµСЂРёС‚Рµ СЃС‚СЂР°С‚РµРіРёСЋ РЅРёР¶Рµ")
                with c_save2:
                    if st.button("рџ’ѕ РЎРѕС…СЂР°РЅРёС‚СЊ", key="btn_save_manual_consistency", use_container_width=True):
                        if '_STATUS' in edited_df.columns:
                            edited_df = edited_df.drop(columns=['_STATUS'])
                        df_work.update(edited_df)
                        st.session_state.df_consistency_work = df_work
                        st.session_state.df = df_work  # РЎРёРЅС…СЂРѕРЅРёР·РёСЂСѓРµРј СЃ РѕСЃРЅРѕРІРЅС‹Рј РґР°С‚Р°СЃРµС‚РѕРј
                        st.session_state.validation_ready = False
                        st.toast("вњ… РџСЂР°РІРєРё СЃРѕС…СЂР°РЅРµРЅС‹!", icon="вњ…")
                        st.rerun()

                st.divider()

                # РџР°РЅРµР»СЊ СЃС‚СЂР°С‚РµРіРёР№ (РђРІС‚РѕРјР°С‚РёС‡РµСЃРєР°СЏ РѕР±СЂР°Р±РѕС‚РєР°)
                st.markdown("### рџ§№ РЎС‚СЂР°С‚РµРіРёРё РѕР±СЂР°Р±РѕС‚РєРё РЅР°СЂСѓС€РµРЅРёР№ СЃРѕРіР»Р°СЃРѕРІР°РЅРЅРѕСЃС‚Рё")
                c1, c2 = st.columns([2, 1])
                with c1:
                    consistency_strategy = st.radio(
                        "Р’С‹Р±РµСЂРёС‚Рµ СЃС‚СЂР°С‚РµРіРёСЋ:",
                        ["РЈРґР°Р»РёС‚СЊ СЃС‚СЂРѕРєРё СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё",
                        "Р—Р°РјРµРЅРёС‚СЊ РЅР° РјРµРґРёР°РЅСѓ (С‡РёСЃР»РѕРІС‹Рµ) / РјРѕРґСѓ",
                        "РСЃРїСЂР°РІРёС‚СЊ С…СЂРѕРЅРѕР»РѕРіРёСЋ (СЃРѕСЂС‚РёСЂРѕРІРєР° РїРѕ РґР°С‚Рµ)",
                        "Р—Р°РјРµРЅРёС‚СЊ РЅР° 0 РёР»Рё NaN",
                        "РўРѕР»СЊРєРѕ РѕС‚РјРµС‚РёС‚СЊ С„Р»Р°РіРѕРј (РЅРµ РјРµРЅСЏС‚СЊ РґР°РЅРЅС‹Рµ)"],
                        key="consistency_fill_strategy"
                    )
                    if "РЈРґР°Р»РёС‚СЊ" in consistency_strategy:
                        st.warning(f"вљ пёЏ Р‘СѓРґРµС‚ СѓРґР°Р»РµРЅРѕ **{combined_mask.sum()} СЃС‚СЂРѕРє** ({combined_mask.sum()/len(df_work)*100:.1f}% РґР°РЅРЅС‹С…).")
                    elif "РјРµРґРёР°РЅСѓ" in consistency_strategy:
                        st.warning("вљ пёЏ РќР°СЂСѓС€Р°СЋС‰РёРµ Р·РЅР°С‡РµРЅРёСЏ Р±СѓРґСѓС‚ Р·Р°РјРµРЅРµРЅС‹ РЅР° РјРµРґРёР°РЅСѓ/РјРѕРґСѓ.")
                    elif "С…СЂРѕРЅРѕР»РѕРіРёСЋ" in consistency_strategy:
                        st.info("в„№пёЏ Р”Р°РЅРЅС‹Рµ Р±СѓРґСѓС‚ РѕС‚СЃРѕСЂС‚РёСЂРѕРІР°РЅС‹ РїРѕ РІСЂРµРјРµРЅРЅРѕР№ РєРѕР»РѕРЅРєРµ РґР»СЏ РёСЃРїСЂР°РІР»РµРЅРёСЏ С…СЂРѕРЅРѕР»РѕРіРёРё.")
                    elif "0пёЏвѓЈ" in consistency_strategy:
                        st.warning("вљ пёЏ Р’СЃРµ РЅР°СЂСѓС€РµРЅРёСЏ Р±СѓРґСѓС‚ Р·Р°РјРµРЅРµРЅС‹ РЅР° 0 РёР»Рё NaN.")
                with c2:
                    st.markdown("<div style='margin-top: 28px;'></div>", unsafe_allow_html=True)

                # РљРЅРѕРїРєР° Р·Р°РїСѓСЃРєР° РїСЂРµРІСЊСЋ
                if "show_consistency_preview" not in st.session_state:
                    st.session_state.show_consistency_preview = False

                st.markdown("<div style='margin: 15px 0;'></div>", unsafe_allow_html=True)
                if st.button("рџ“Љ РџРѕРєР°Р·Р°С‚СЊ РїСЂРѕРіРЅРѕР· РІР»РёСЏРЅРёСЏ РЅР° СЃС‚Р°С‚РёСЃС‚РёРєРё", type="secondary", use_container_width=True, key="btn_show_consistency_preview"):
                    st.session_state.show_consistency_preview = True
                    st.rerun()

                # Р‘Р»РѕРє РїСЂРµРІСЊСЋ
                if st.session_state.show_consistency_preview:
                    strategy = consistency_strategy
                    st.markdown("##### рџ“€ РџСЂРѕРіРЅРѕР· РІР»РёСЏРЅРёСЏ РЅР° СЃС‚Р°С‚РёСЃС‚РёРєСѓ:")

                    df_preview = df_work.copy()
                    num_cols_to_fix = df_preview.select_dtypes(include=['number']).columns.tolist()

                    if "РЈРґР°Р»РёС‚СЊ" in strategy:
                        df_preview = df_preview[~combined_mask].reset_index(drop=True)
                        note = "(СѓРґР°Р»РµРЅРёРµ СЃС‚СЂРѕРє)"
                    elif "РјРµРґРёР°РЅСѓ" in strategy:
                        for col in num_cols_to_fix:
                            if df_preview[col].isnull().any() or combined_mask.any():
                                df_preview.loc[combined_mask, col] = df_preview[col].median()
                        note = "(Р·Р°РјРµРЅР° РјРµРґРёР°РЅРѕР№)"
                    elif "С…СЂРѕРЅРѕР»РѕРіРёСЋ" in strategy:
                        date_cols = [c for c in df_preview.columns if 'date' in c.lower() or 'РґР°С‚Р°' in c.lower()]
                        if date_cols:
                            df_preview = df_preview.sort_values(date_cols[0]).reset_index(drop=True)
                            note = f"(СЃРѕСЂС‚РёСЂРѕРІРєР° РїРѕ {date_cols[0]})"
                        else:
                            st.warning("вљ пёЏ Р’СЂРµРјРµРЅРЅС‹Рµ РєРѕР»РѕРЅРєРё РЅРµ РЅР°Р№РґРµРЅС‹")
                            note = "(Р±РµР· РёР·РјРµРЅРµРЅРёР№)"
                    elif "0пёЏвѓЈ" in strategy:
                        for col in num_cols_to_fix:
                            df_preview.loc[combined_mask, col] = 0
                        note = "(Р·Р°РјРµРЅР° РЅР° 0)"
                    else:
                        note = "(Р±РµР· РёР·РјРµРЅРµРЅРёР№)"

                    # РњРµС‚СЂРёРєРё (4 РєРѕР»РѕРЅРєРё)
                    c_p1, c_p2, c_p3, c_p4 = st.columns(4)
                    c_p1.metric("рџ“Љ Р—Р°РїРёСЃРµР№", f"{len(df_work)} в†’ {len(df_preview)}", delta=f"{len(df_preview)-len(df_work):+}")

                    if num_cols_to_fix:
                        col = num_cols_to_fix[0]
                        def safe_stat(d, c, f):
                            return f(d[c]) if not d.empty and c in d.columns and d[c].notna().any() else 0.0
                        m_b, s_b, d_b = safe_stat(df_work, col, np.mean), safe_stat(df_work, col, np.std), safe_stat(df_work, col, np.median)
                        m_a, s_a, d_a = safe_stat(df_preview, col, np.mean), safe_stat(df_preview, col, np.std), safe_stat(df_preview, col, np.median)
                        fmt = lambda x: f"{x:.2f}" if pd.notnull(x) and x != 0.0 else "N/A"
                        delta = lambda b, a: f"{((a-b)/abs(b)*100):+.1f}%" if b != 0 and pd.notnull(b) else "0%"
                        c_p2.metric("рџ“€ Mean", f"{fmt(m_b)} в†’ {fmt(m_a)}", delta=delta(m_b, m_a))
                        c_p3.metric("рџ“‰ Std", f"{fmt(s_b)} в†’ {fmt(s_a)}", delta=delta(s_b, s_a))
                        c_p4.metric("рџ“Љ Median", f"{fmt(d_b)} в†’ {fmt(d_a)}", delta=delta(d_b, d_a))

                    # РљРЅРѕРїРєРё РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ
                    st.divider()
                    c_ok, c_cancel = st.columns(2)
                    with c_ok:
                        if st.button("рџ’ѕ РџРѕРґС‚РІРµСЂРґРёС‚СЊ РёР·РјРµРЅРµРЅРёСЏ", type="primary", use_container_width=True, key="btn_confirm_consistency"):
                            st.session_state.df_after_fixes = df_preview.copy()
                            st.session_state.df = df_preview
                            st.session_state.validation_ready = False
                            st.session_state.show_consistency_preview = False
                            st.success("вњ… РЎС‚СЂР°С‚РµРіРёСЏ РїСЂРёРјРµРЅРµРЅР°! РџРµСЂРµР·Р°РїСѓСЃС‚РёС‚Рµ РІР°Р»РёРґР°С†РёСЋ.")
                            st.rerun()
                    with c_cancel:
                        if st.button("вќЊ РћС‚РјРµРЅР°", use_container_width=True, key="btn_cancel_consistency"):
                            st.session_state.show_consistency_preview = False
                            st.rerun()

        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
        # 5. РџР РћР’Р•Р РљРђ РЈРќРРљРђР›Р¬РќРћРЎРўР (СЃ РёРЅС‚РµСЂР°РєС‚РёРІРЅС‹Рј РїР°Р№РїР»Р°Р№РЅРѕРј)
        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ

        uniqueness_results_local = locals().get('uniqueness_results', [])
        uniqueness_issues = len(uniqueness_results_local) > 0
        uniqueness_dup_count = sum(r.get('Р”СѓР±Р»РёРєР°С‚РѕРІ', 0) for r in uniqueness_results_local) if uniqueness_issues else 0

        make_card(" РџСЂРѕРІРµСЂРєР° СѓРЅРёРєР°Р»СЊРЅРѕСЃС‚Рё (uniqueness checks)", uniqueness_issues,
            "**в—»пёЏ РњРµС‚СЂРёРєРё:** `% dup = duplicated/total`, РґСѓР±Р»Рё РІСЂРµРјРµРЅРЅС‹С… РјРµС‚РѕРє.  \n"
            "**в—»пёЏ РђР»РіРѕСЂРёС‚Рј:** `df.duplicated()`, Р°СѓРґРёС‚ `datetime.duplicated()`.  \n"
            "**в—»пёЏ Р’Р»РёСЏРЅРёРµ РЅР° TS:** Р”СѓР±Р»Рё РґР°С‚ Р»РѕРјР°СЋС‚ `DatetimeIndex`, `resample()`, STL Рё ARIMA.  \n"
            "**в—»пёЏ РћРїРёСЃР°РЅРёРµ:** РњРѕРґСѓР»СЊ РїСЂРѕРІРѕРґРёС‚ РїСЂРѕРІРµСЂРєСѓ РЅР° РґРІСѓС… СѓСЂРѕРІРЅСЏС…:  \n"
            " 1. РџРѕР»РЅС‹Рµ РґСѓР±Р»РёРєР°С‚С‹ СЃС‚СЂРѕРє. РСЃРїРѕР»СЊР·СѓРµС‚СЃСЏ РјРµС‚РѕРґ df.duplicated() СЃ РїР°СЂР°РјРµС‚СЂРѕРј keep=False, "
            "РїРѕРјРµС‡Р°СЋС‚СЃСЏ РІСЃРµ РєРѕРїРёРё РґСѓР±Р»РёСЂСѓСЋС‰РёС…СЃСЏ СЃС‚СЂРѕРє, РІРѕР·РІСЂР°С‰Р°РµС‚ Р±СѓР»РµРІСѓ РјР°СЃРєСѓ РґР»СЏ РїРѕСЃР»РµРґСѓСЋС‰РµР№ РѕР±СЂР°Р±РѕС‚РєРё.  \n"
            " 2. Р”СѓР±Р»РёРєР°С‚С‹ РїРѕ РєР»СЋС‡Сѓ РІСЂРµРјРµРЅРё (РґР»СЏ TS-СЂРµР¶РёРјР°) вЂ” "
            "РїСЂРѕРІРµСЂСЏРµС‚ СѓРЅРёРєР°Р»СЊРЅРѕСЃС‚СЊ РїРѕ РєРѕР»РѕРЅРєРµ СЃ РґР°С‚РѕР№ (РєСЂРёС‚РёС‡РµСЃРєРё РІР°Р¶РЅРѕ РґР»СЏ РїРѕСЃС‚СЂРѕРµРЅРёСЏ DatetimeIndex). Р•СЃР»Рё Р°РєС‚РёРІРµРЅ СЂРµР¶РёРј РїР°РЅРµР»Рё РґР°РЅРЅС‹С… вЂ” РїСЂРѕРІРµСЂРєР° РїРѕ (Country, Date).",
            "вњ… Р”СѓР±Р»РёРєР°С‚С‹ РѕС‚СЃСѓС‚СЃС‚РІСѓСЋС‚" if not uniqueness_issues else f"вљ пёЏ РќР°Р№РґРµРЅРѕ {uniqueness_dup_count} РґСѓР±Р»РёРєР°С‚РѕРІ",
            "вњ…" if not uniqueness_issues else "вљ пёЏ", None)

        # в”Ђв”Ђ рџ”§ РРќРўР•Р РђРљРўРР’РќР«Р™ РџРђР™РџР›РђР™Рќ РћР‘Р РђР‘РћРўРљР (СЂР°СЃРєСЂС‹РІР°РµС‚СЃСЏ РїСЂРё РїСЂРѕР±Р»РµРјР°С…) в”Ђв”Ђ
        if uniqueness_issues:
            with st.expander("рџ”§ РџРѕР»РЅС‹Р№ РїР°Р№РїР»Р°Р№РЅ РѕР±СЂР°Р±РѕС‚РєРё РґСѓР±Р»РёРєР°С‚РѕРІ", expanded=True):
                st.markdown("### рџ“‹ РўР°Р±Р»РёС†Р° РґСѓР±Р»РёРєР°С‚РѕРІ СЃ СЂСѓС‡РЅРѕР№ РєРѕСЂСЂРµРєС‚РёСЂРѕРІРєРѕР№")

                # РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ СЃРѕСЃС‚РѕСЏРЅРёР№
                if "df_uniqueness_work" not in st.session_state:
                    st.session_state.df_uniqueness_work = df.copy()
                df_work = st.session_state.df_uniqueness_work

                # РџРѕРёСЃРє РґСѓР±Р»РёРєР°С‚РѕРІ
                if st.session_state.col_types.get("date"):
                    date_col = st.session_state.col_types["date"][0]
                    # Р”Р»СЏ РІСЂРµРјРµРЅРЅС‹С… СЂСЏРґРѕРІ: РґСѓР±Р»Рё РїРѕ РґР°С‚Рµ
                    duplicate_mask = df_work.duplicated(subset=[date_col], keep=False)
                    duplicate_indices = df_work[duplicate_mask].index.tolist()
                else:
                    # РћР±С‰РёР№ СЃР»СѓС‡Р°Р№: РїРѕР»РЅС‹Рµ РґСѓР±Р»РёРєР°С‚С‹ СЃС‚СЂРѕРє
                    duplicate_mask = df_work.duplicated(keep=False)
                    duplicate_indices = df_work[duplicate_mask].index.tolist()

                # Р¤РёР»СЊС‚СЂ РѕС‚РѕР±СЂР°Р¶РµРЅРёСЏ
                view_filter = st.radio(
                    "Р¤РёР»СЊС‚СЂ СЃС‚СЂРѕРє:",
                    ["вљ пёЏ РўРѕР»СЊРєРѕ РґСѓР±Р»РёРєР°С‚С‹", "вњ… РџРѕРєР°Р·Р°С‚СЊ РІСЃС‘"],
                    horizontal=True,
                    key="uniqueness_view_filter"
                )

                if view_filter == "вљ пёЏ РўРѕР»СЊРєРѕ РґСѓР±Р»РёРєР°С‚С‹":
                    df_view = df_work.loc[duplicate_indices].copy() if duplicate_indices else df_work.iloc[:0].copy()
                else:
                    df_view = df_work.copy()

                # Р”РѕР±Р°РІР»СЏРµРј СЃС‚Р°С‚СѓСЃ-РєРѕР»РѕРЅРєСѓ
                df_view = df_view.copy()
                df_view.insert(0, '_STATUS', df_view.index.map(lambda idx: "рџ”ґ Р”СѓР±Р»РёРєР°С‚" if idx in duplicate_indices else "рџџў РЈРЅРёРєР°Р»СЊРЅРѕ"))

                # РРЅС‚РµСЂР°РєС‚РёРІРЅР°СЏ С‚Р°Р±Р»РёС†Р° (Р СѓС‡РЅР°СЏ РїСЂР°РІРєР°)
                edited_df = st.data_editor(
                    df_view,
                    use_container_width=True,
                    height=300,
                    num_rows="dynamic",
                    disabled=['_STATUS'],
                    key="uniqueness_editor",
                    column_config={
                        "_STATUS": st.column_config.TextColumn("РЎС‚Р°С‚СѓСЃ", disabled=True, width="small")
                    }
                )

                # рџ’ѕ РљРќРћРџРљРђ РЎРћРҐР РђРќР•РќРРЇ
                c_save1, c_save2 = st.columns([4, 1])
                with c_save1:
                    st.caption("рџ’Ў РћС‚СЂРµРґР°РєС‚РёСЂСѓР№С‚Рµ Р·РЅР°С‡РµРЅРёСЏ РІСЂСѓС‡РЅСѓСЋ РёР»Рё РІС‹Р±РµСЂРёС‚Рµ СЃС‚СЂР°С‚РµРіРёСЋ РЅРёР¶Рµ")
                with c_save2:
                    if st.button("рџ’ѕ РЎРѕС…СЂР°РЅРёС‚СЊ", key="btn_save_manual_uniqueness", use_container_width=True):
                        if '_STATUS' in edited_df.columns:
                            edited_df = edited_df.drop(columns=['_STATUS'])
                        df_work.update(edited_df)
                        st.session_state.df_uniqueness_work = df_work
                        st.session_state.df = df_work
                        st.session_state.validation_ready = False
                        st.toast("вњ… РџСЂР°РІРєРё СЃРѕС…СЂР°РЅРµРЅС‹!", icon="вњ…")
                        st.rerun()

                st.divider()

                # РџР°РЅРµР»СЊ СЃС‚СЂР°С‚РµРіРёР№ (РђРІС‚РѕРјР°С‚РёС‡РµСЃРєР°СЏ РѕР±СЂР°Р±РѕС‚РєР°)
                st.markdown("### рџ§№ РЎС‚СЂР°С‚РµРіРёРё РѕР±СЂР°Р±РѕС‚РєРё РґСѓР±Р»РёРєР°С‚РѕРІ")
                c1, c2 = st.columns([2, 1])
                with c1:
                    uniqueness_strategy = st.radio(
                        "Р’С‹Р±РµСЂРёС‚Рµ СЃС‚СЂР°С‚РµРіРёСЋ:",
                        ["РЈРґР°Р»РёС‚СЊ РґСѓР±Р»РёРєР°С‚С‹ (РѕСЃС‚Р°РІРёС‚СЊ РїРµСЂРІС‹Р№)",
                        "РЈРґР°Р»РёС‚СЊ РґСѓР±Р»РёРєР°С‚С‹ (РѕСЃС‚Р°РІРёС‚СЊ РїРѕСЃР»РµРґРЅРёР№)",
                        "РЈРґР°Р»РёС‚СЊ РІСЃРµ РґСѓР±Р»РёРєР°С‚С‹ РїРѕР»РЅРѕСЃС‚СЊСЋ",
                        "РђРіСЂРµРіРёСЂРѕРІР°С‚СЊ РґСѓР±Р»РёРєР°С‚С‹ (mean/sum)",
                        "РўРѕР»СЊРєРѕ РѕС‚РјРµС‚РёС‚СЊ С„Р»Р°РіРѕРј (РЅРµ РјРµРЅСЏС‚СЊ РґР°РЅРЅС‹Рµ)"],
                        key="uniqueness_fill_strategy"
                    )
                    if "РЈРґР°Р»РёС‚СЊ РґСѓР±Р»РёРєР°С‚С‹" in uniqueness_strategy:
                        st.warning(f"вљ пёЏ Р‘СѓРґРµС‚ СѓРґР°Р»РµРЅРѕ **{len(duplicate_indices)} СЃС‚СЂРѕРє** СЃ РґСѓР±Р»РёРєР°С‚Р°РјРё ({len(duplicate_indices)/len(df_work)*100:.1f}% РґР°РЅРЅС‹С…).")
                    elif "РђРіСЂРµРіРёСЂРѕРІР°С‚СЊ" in uniqueness_strategy:
                        st.info("в„№пёЏ Р”СѓР±Р»РёРєР°С‚С‹ Р±СѓРґСѓС‚ Р°РіСЂРµРіРёСЂРѕРІР°РЅС‹ С‡РµСЂРµР· mean (С‡РёСЃР»РѕРІС‹Рµ) / first (РєР°С‚РµРіРѕСЂРёРё).")
                    elif "С„Р»Р°РіРѕРј" in uniqueness_strategy:
                        st.info("рџљ© Р‘СѓРґРµС‚ РґРѕР±Р°РІР»РµРЅР° РєРѕР»РѕРЅРєР° `_is_duplicate` СЃ True/False")
                with c2:
                    st.markdown("<div style='margin-top: 28px;'></div>", unsafe_allow_html=True)

                # РљРЅРѕРїРєР° Р·Р°РїСѓСЃРєР° РїСЂРµРІСЊСЋ
                if "show_uniqueness_preview" not in st.session_state:
                    st.session_state.show_uniqueness_preview = False

                st.markdown("<div style='margin: 15px 0;'></div>", unsafe_allow_html=True)
                if st.button("рџ“Љ РџРѕРєР°Р·Р°С‚СЊ РїСЂРѕРіРЅРѕР· РІР»РёСЏРЅРёСЏ РЅР° СЃС‚Р°С‚РёСЃС‚РёРєРё", type="secondary", use_container_width=True, key="btn_show_uniqueness_preview"):
                    st.session_state.show_uniqueness_preview = True
                    st.rerun()

                # Р‘Р»РѕРє РїСЂРµРІСЊСЋ
                if st.session_state.show_uniqueness_preview:
                    strategy = uniqueness_strategy
                    st.markdown("##### рџ“€ РџСЂРѕРіРЅРѕР· РІР»РёСЏРЅРёСЏ РЅР° СЃС‚Р°С‚РёСЃС‚РёРєСѓ:")

                    df_preview = df_work.copy()
                    num_cols_to_check = df_preview.select_dtypes(include=['number']).columns.tolist()

                    if "РЈРґР°Р»РёС‚СЊ РґСѓР±Р»РёРєР°С‚С‹ (РѕСЃС‚Р°РІРёС‚СЊ РїРµСЂРІС‹Р№)" in strategy:
                        if st.session_state.col_types.get("date"):
                            df_preview = df_preview.drop_duplicates(subset=[st.session_state.col_types["date"][0]], keep='first')
                        else:
                            df_preview = df_preview.drop_duplicates(keep='first')
                        note = "(СѓРґР°Р»РµРЅРёРµ, keep='first')"
                    elif "РЈРґР°Р»РёС‚СЊ РґСѓР±Р»РёРєР°С‚С‹ (РѕСЃС‚Р°РІРёС‚СЊ РїРѕСЃР»РµРґРЅРёР№)" in strategy:
                        if st.session_state.col_types.get("date"):
                            df_preview = df_preview.drop_duplicates(subset=[st.session_state.col_types["date"][0]], keep='last')
                        else:
                            df_preview = df_preview.drop_duplicates(keep='last')
                        note = "(СѓРґР°Р»РµРЅРёРµ, keep='last')"
                    elif "РЈРґР°Р»РёС‚СЊ РІСЃРµ РґСѓР±Р»РёРєР°С‚С‹ РїРѕР»РЅРѕСЃС‚СЊСЋ" in strategy:
                        if st.session_state.col_types.get("date"):
                            df_preview = df_preview.drop_duplicates(subset=[st.session_state.col_types["date"][0]], keep=False)
                        else:
                            df_preview = df_preview.drop_duplicates(keep=False)
                        note = "(СѓРґР°Р»РµРЅРёРµ РІСЃРµС… РґСѓР±Р»РёРєР°С‚РѕРІ)"
                    elif "РђРіСЂРµРіРёСЂРѕРІР°С‚СЊ РґСѓР±Р»РёРєР°С‚С‹" in strategy:
                        if st.session_state.col_types.get("date"):
                            date_col = st.session_state.col_types["date"][0]
                            # РђРіСЂРµРіР°С†РёСЏ: mean РґР»СЏ С‡РёСЃР»РѕРІС‹С…, first РґР»СЏ РєР°С‚РµРіРѕСЂРёР°Р»СЊРЅС‹С…
                            agg_dict = {col: 'mean' if col in num_cols_to_check else 'first' for col in df_preview.columns if col != date_col}
                            df_preview = df_preview.groupby(date_col).agg(agg_dict).reset_index()
                        note = "(Р°РіСЂРµРіР°С†РёСЏ)"
                    else:
                        note = "(Р±РµР· РёР·РјРµРЅРµРЅРёР№)"

                    # РњРµС‚СЂРёРєРё (4 РєРѕР»РѕРЅРєРё)
                    c_p1, c_p2, c_p3, c_p4 = st.columns(4)
                    c_p1.metric("рџ“Љ Р—Р°РїРёСЃРµР№", f"{len(df_work)} в†’ {len(df_preview)}", delta=f"{len(df_preview)-len(df_work):+}")

                    if num_cols_to_check:
                        col = num_cols_to_check[0]
                        def safe_stat(d, c, f):
                            return f(d[c]) if not d.empty and c in d.columns and d[c].notna().any() else 0.0
                        m_b, s_b, d_b = safe_stat(df_work, col, np.mean), safe_stat(df_work, col, np.std), safe_stat(df_work, col, np.median)
                        m_a, s_a, d_a = safe_stat(df_preview, col, np.mean), safe_stat(df_preview, col, np.std), safe_stat(df_preview, col, np.median)
                        fmt = lambda x: f"{x:.2f}" if pd.notnull(x) and x != 0.0 else "N/A"
                        delta = lambda b, a: f"{((a-b)/abs(b)*100):+.1f}%" if b != 0 and pd.notnull(b) else "0%"
                        c_p2.metric("рџ“€ Mean", f"{fmt(m_b)} в†’ {fmt(m_a)}", delta=delta(m_b, m_a))
                        c_p3.metric("рџ“‰ Std", f"{fmt(s_b)} в†’ {fmt(s_a)}", delta=delta(s_b, s_a))
                        c_p4.metric("рџ“Љ Median", f"{fmt(d_b)} в†’ {fmt(d_a)}", delta=delta(d_b, d_a))

                    # РљРЅРѕРїРєРё РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ
                    st.divider()
                    c_ok, c_cancel = st.columns(2)
                    with c_ok:
                        if st.button("рџ’ѕ РџРѕРґС‚РІРµСЂРґРёС‚СЊ РёР·РјРµРЅРµРЅРёСЏ", type="primary", use_container_width=True, key="btn_confirm_uniqueness"):
                            st.session_state.df_after_fixes = df_preview.copy()
                            st.session_state.df = df_preview
                            st.session_state.validation_ready = False
                            st.session_state.show_uniqueness_preview = False
                            st.success("вњ… РЎС‚СЂР°С‚РµРіРёСЏ РїСЂРёРјРµРЅРµРЅР°! РџРµСЂРµР·Р°РїСѓСЃС‚РёС‚Рµ РІР°Р»РёРґР°С†РёСЋ.")
                            st.rerun()
                    with c_cancel:
                        if st.button("вќЊ РћС‚РјРµРЅР°", use_container_width=True, key="btn_cancel_uniqueness"):
                            st.session_state.show_uniqueness_preview = False
                            st.rerun()

        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
        # 6. РџР РћР’Р•Р РљРђ РџР РРќРђР”Р›Р•Р–РќРћРЎРўР Рљ РќРђР‘РћР РЈ (inclusion/lookup)
        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ

        # 6. Inclusion/Lookup
        inclusion_results_local = locals().get('inclusion_results', [])
        inclusion_issues = len(inclusion_results_local) > 0
        inclusion_viol_count = sum(r.get('РќР°СЂСѓС€РµРЅРёР№', 0) for r in inclusion_results_local) if inclusion_issues else 0

        make_card(" РџСЂРѕРІРµСЂРєР° РїСЂРёРЅР°РґР»РµР¶РЅРѕСЃС‚Рё Рє РЅР°Р±РѕСЂСѓ (inclusion/lookup)", inclusion_issues,
            "**в—»пёЏ РњРµС‚СЂРёРєРё:** `% invalid = not_in_set/total`, С‡РёСЃР»Рѕ Р·РЅР°С‡РµРЅРёР№ РІРЅРµ СЃРїСЂР°РІРѕС‡РЅРёРєР°.  \n"
            "**в—»пёЏ РђР»РіРѕСЂРёС‚Рј:** `df[col].isin(allowed_values)`, РїСЂРѕРІРµСЂРєР° РїРѕ РІРЅРµС€РЅРёРј СЃРїСЂР°РІРѕС‡РЅРёРєР°Рј.  \n"
            "**в—»пёЏ Р’Р»РёСЏРЅРёРµ РЅР° TS:** РќРµРёР·РІРµСЃС‚РЅС‹Рµ РєР°С‚РµРіРѕСЂРёРё Р»РѕРјР°СЋС‚ `groupby`, `pivot`, `resample` РїРѕ РєР°С‚РµРіРѕСЂРёСЏРј.  \n"
            "**в—»пёЏ РћРїРёСЃР°РЅРёРµ:** РњРѕРґСѓР»СЊ РїСЂРѕРІРµСЂСЏРµС‚, С‡С‚Рѕ Р·РЅР°С‡РµРЅРёСЏ РІ РєР°С‚РµРіРѕСЂРёР°Р»СЊРЅС‹С… РєРѕР»РѕРЅРєР°С… РїСЂРёРЅР°РґР»РµР¶Р°С‚ СѓС‚РІРµСЂР¶РґС‘РЅРЅРѕРјСѓ СЃРїСЂР°РІРѕС‡РЅРёРєСѓ (РґРѕРјРµРЅСѓ). Р”Р»СЏ С‚РёРїРѕРІС‹С… РґР°С‚Р°СЃРµС‚РѕРІ РёСЃРїРѕР»СЊР·СѓСЋС‚СЃСЏ РіРѕС‚РѕРІС‹Рµ С€Р°Р±Р»РѕРЅС‹ YAML.  \n"
            "Р”Р»СЏ РЅРѕРІС‹С… С‚РёРїРѕРІ РґР°РЅРЅС‹С… РїР»Р°С‚С„РѕСЂРјР° Р°РІС‚РѕРіРµРЅРµСЂРёСЂСѓРµС‚ Р±Р°Р·РѕРІС‹Рµ РїСЂР°РІРёР»Р°, Р°РЅР°Р»РёС‚РёРє РёС… РєРѕСЂСЂРµРєС‚РёСЂСѓРµС‚. Р’С‹СЏРІР»СЏСЋС‚СЃСЏ РѕРїРµС‡Р°С‚РєРё, СѓСЃС‚Р°СЂРµРІС€РёРµ РєРѕРґС‹, РЅРµСЃСѓС‰РµСЃС‚РІСѓСЋС‰РёРµ РєР°С‚РµРіРѕСЂРёРё. РљСЂРёС‚РёС‡РЅРѕ РґР»СЏ Р°РіСЂРµРіР°С†РёРё Рё С„РёР»СЊС‚СЂР°С†РёРё РґР°РЅРЅС‹С….",
            "вњ… Р’СЃРµ Р·РЅР°С‡РµРЅРёСЏ СЃРѕРѕС‚РІРµС‚СЃС‚РІСѓСЋС‚ СЃРїСЂР°РІРѕС‡РЅРёРєР°Рј" if not inclusion_issues else f"вљ пёЏ РќР°Р№РґРµРЅРѕ {inclusion_viol_count} РЅР°СЂСѓС€РµРЅРёР№",
            "вњ…" if not inclusion_issues else "вљ пёЏ", None)

        # в”Ђв”Ђ рџ”§ РРќРўР•Р РђРљРўРР’РќР«Р™ РџРђР™РџР›РђР™Рќ РћР‘Р РђР‘РћРўРљР (СЂР°СЃРєСЂС‹РІР°РµС‚СЃСЏ РїСЂРё РїСЂРѕР±Р»РµРјР°С…) в”Ђв”Ђ
        if inclusion_issues:
            with st.expander("рџ”§ РџРѕР»РЅС‹Р№ РїР°Р№РїР»Р°Р№РЅ РѕР±СЂР°Р±РѕС‚РєРё РЅР°СЂСѓС€РµРЅРёР№ РїСЂРёРЅР°РґР»РµР¶РЅРѕСЃС‚Рё", expanded=True):
                st.markdown("### рџ“‹ РўР°Р±Р»РёС†Р° РЅР°СЂСѓС€РµРЅРёР№ СЃ СЂСѓС‡РЅРѕР№ РєРѕСЂСЂРµРєС‚РёСЂРѕРІРєРѕР№")

                # РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ СЃРѕСЃС‚РѕСЏРЅРёР№
                if "df_inclusion_work" not in st.session_state:
                    st.session_state.df_inclusion_work = df.copy()
                df_work = st.session_state.df_inclusion_work

                # РџРѕРёСЃРє РЅР°СЂСѓС€РµРЅРёР№ inclusion
                inclusion_violations = []
                for col, allowed_vals in inclusion_rules.items():  # inclusion_rules РёР· rules.yaml
                    if col in df_work.columns:
                        invalid_mask = ~df_work[col].isin(allowed_vals) & df_work[col].notna()
                        if invalid_mask.any():
                            invalid_values = df_work.loc[invalid_mask, col].unique()
                            inclusion_violations.append({
                                'column': col,
                                'invalid_values': invalid_values,
                                'count': invalid_mask.sum(),
                                'mask': invalid_mask
                            })

                # РћР±С‰Р°СЏ РјР°СЃРєР° РІСЃРµС… РЅР°СЂСѓС€РµРЅРёР№
                combined_mask = pd.Series(False, index=df_work.index)
                for v in inclusion_violations:
                    combined_mask |= v['mask']

                # Р¤РёР»СЊС‚СЂ РѕС‚РѕР±СЂР°Р¶РµРЅРёСЏ
                view_filter = st.radio(
                    "Р¤РёР»СЊС‚СЂ СЃС‚СЂРѕРє:",
                    ["вљ пёЏ РўРѕР»СЊРєРѕ СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё", "вњ… РџРѕРєР°Р·Р°С‚СЊ РІСЃС‘"],
                    horizontal=True,
                    key="inclusion_view_filter"
                )

                if view_filter == "вљ пёЏ РўРѕР»СЊРєРѕ СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё":
                    df_view = df_work[combined_mask].copy() if combined_mask.any() else df_work.iloc[:0].copy()
                else:
                    df_view = df_work.copy()

                # Р”РѕР±Р°РІР»СЏРµРј СЃС‚Р°С‚СѓСЃ-РєРѕР»РѕРЅРєСѓ
                df_view = df_view.copy()
                df_view.insert(0, '_STATUS', df_view.index.map(lambda idx: "рџ”ґ РќР°СЂСѓС€РµРЅРёРµ" if combined_mask.loc[idx] else "рџџў РќРѕСЂРјР°"))

                # РРЅС‚РµСЂР°РєС‚РёРІРЅР°СЏ С‚Р°Р±Р»РёС†Р° (Р СѓС‡РЅР°СЏ РїСЂР°РІРєР°)
                edited_df = st.data_editor(
                    df_view,
                    use_container_width=True,
                    height=300,
                    num_rows="dynamic",
                    disabled=['_STATUS'],
                    key="inclusion_editor",
                    column_config={
                        "_STATUS": st.column_config.TextColumn("РЎС‚Р°С‚СѓСЃ", disabled=True, width="small")
                    }
                )

                # рџ’ѕ РљРќРћРџРљРђ РЎРћРҐР РђРќР•РќРРЇ
                c_save1, c_save2 = st.columns([4, 1])
                with c_save1:
                    st.caption("рџ’Ў РћС‚СЂРµРґР°РєС‚РёСЂСѓР№С‚Рµ Р·РЅР°С‡РµРЅРёСЏ РІСЂСѓС‡РЅСѓСЋ РёР»Рё РІС‹Р±РµСЂРёС‚Рµ СЃС‚СЂР°С‚РµРіРёСЋ РЅРёР¶Рµ")
                with c_save2:
                    if st.button("рџ’ѕ РЎРѕС…СЂР°РЅРёС‚СЊ", key="btn_save_manual_inclusion", use_container_width=True):
                        if '_STATUS' in edited_df.columns:
                            edited_df = edited_df.drop(columns=['_STATUS'])
                        df_work.update(edited_df)
                        st.session_state.df_inclusion_work = df_work
                        st.session_state.df = df_work
                        st.session_state.validation_ready = False
                        st.toast("вњ… РџСЂР°РІРєРё СЃРѕС…СЂР°РЅРµРЅС‹!", icon="вњ…")
                        st.rerun()

                st.divider()

                # РџР°РЅРµР»СЊ СЃС‚СЂР°С‚РµРіРёР№ (РђРІС‚РѕРјР°С‚РёС‡РµСЃРєР°СЏ РѕР±СЂР°Р±РѕС‚РєР°)
                st.markdown("### рџ§№ РЎС‚СЂР°С‚РµРіРёРё РѕР±СЂР°Р±РѕС‚РєРё РЅР°СЂСѓС€РµРЅРёР№ РїСЂРёРЅР°РґР»РµР¶РЅРѕСЃС‚Рё")
                c1, c2 = st.columns([2, 1])
                with c1:
                    inclusion_strategy = st.radio(
                        "Р’С‹Р±РµСЂРёС‚Рµ СЃС‚СЂР°С‚РµРіРёСЋ:",
                        ["Р—Р°РјРµРЅРёС‚СЊ РЅР° РЅР°РёР±РѕР»РµРµ С‡Р°СЃС‚РѕРµ РґРѕРїСѓСЃС‚РёРјРѕРµ Р·РЅР°С‡РµРЅРёРµ",
                        "Р—Р°РјРµРЅРёС‚СЊ РЅР° NaN (СѓРґР°Р»РёС‚СЊ Р·РЅР°С‡РµРЅРёСЏ)",
                        "РЈРґР°Р»РёС‚СЊ СЃС‚СЂРѕРєРё СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё",
                        "Р—Р°РјРµРЅРёС‚СЊ РЅР° Р·РЅР°С‡РµРЅРёРµ РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ (РёР· СЃРїСЂР°РІРѕС‡РЅРёРєР°)",
                        "РўРѕР»СЊРєРѕ РѕС‚РјРµС‚РёС‚СЊ С„Р»Р°РіРѕРј (РЅРµ РјРµРЅСЏС‚СЊ РґР°РЅРЅС‹Рµ)"],
                        key="inclusion_fill_strategy"
                    )
                    if "РЅР°РёР±РѕР»РµРµ С‡Р°СЃС‚РѕРµ" in inclusion_strategy:
                        st.info("в„№пёЏ РќР°СЂСѓС€Р°СЋС‰РёРµ Р·РЅР°С‡РµРЅРёСЏ Р±СѓРґСѓС‚ Р·Р°РјРµРЅРµРЅС‹ РЅР° РјРѕРґСѓ (РЅР°РёР±РѕР»РµРµ С‡Р°СЃС‚РѕРµ РґРѕРїСѓСЃС‚РёРјРѕРµ Р·РЅР°С‡РµРЅРёРµ).")
                    elif "NaN" in inclusion_strategy:
                        st.warning("вљ пёЏ РќР°СЂСѓС€Р°СЋС‰РёРµ Р·РЅР°С‡РµРЅРёСЏ Р±СѓРґСѓС‚ Р·Р°РјРµРЅРµРЅС‹ РЅР° `NaN` (РїСЂРѕРїСѓС‰РµРЅРЅС‹Рµ).")
                    elif "РЈРґР°Р»РёС‚СЊ" in inclusion_strategy:
                        st.warning(f"вљ пёЏ Р‘СѓРґРµС‚ СѓРґР°Р»РµРЅРѕ **{combined_mask.sum()} СЃС‚СЂРѕРє** ({combined_mask.sum()/len(df_work)*100:.1f}% РґР°РЅРЅС‹С…).")
                    elif "РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ" in inclusion_strategy:
                        st.info("в„№пёЏ РќР°СЂСѓС€РµРЅРёСЏ Р±СѓРґСѓС‚ Р·Р°РјРµРЅРµРЅС‹ РЅР° Р·РЅР°С‡РµРЅРёРµ РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ РёР· СЃРїСЂР°РІРѕС‡РЅРёРєР°.")
                with c2:
                    st.markdown("<div style='margin-top: 28px;'></div>", unsafe_allow_html=True)

                # РљРЅРѕРїРєР° Р·Р°РїСѓСЃРєР° РїСЂРµРІСЊСЋ
                if "show_inclusion_preview" not in st.session_state:
                    st.session_state.show_inclusion_preview = False

                st.markdown("<div style='margin: 15px 0;'></div>", unsafe_allow_html=True)
                if st.button("рџ“Љ РџРѕРєР°Р·Р°С‚СЊ РїСЂРѕРіРЅРѕР· РІР»РёСЏРЅРёСЏ РЅР° СЃС‚Р°С‚РёСЃС‚РёРєРё", type="secondary", use_container_width=True, key="btn_show_inclusion_preview"):
                    st.session_state.show_inclusion_preview = True
                    st.rerun()

                # Р‘Р»РѕРє РїСЂРµРІСЊСЋ
                if st.session_state.show_inclusion_preview:
                    strategy = inclusion_strategy
                    st.markdown("##### рџ“€ РџСЂРѕРіРЅРѕР· РІР»РёСЏРЅРёСЏ РЅР° СЃС‚Р°С‚РёСЃС‚РёРєСѓ:")

                    df_preview = df_work.copy()
                    num_cols_to_check = df_preview.select_dtypes(include=['number']).columns.tolist()

                    if "РЅР°РёР±РѕР»РµРµ С‡Р°СЃС‚РѕРµ" in strategy:
                        # Р”Р»СЏ РєР°Р¶РґРѕР№ РєРѕР»РѕРЅРєРё СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё Р·Р°РјРµРЅСЏРµРј РЅР° РјРѕРґСѓ
                        for v in inclusion_violations:
                            col = v['column']
                            allowed = inclusion_rules.get(col, [])
                            mode_val = df_preview[df_preview[col].isin(allowed)][col].mode()
                            if len(mode_val) > 0:
                                df_preview.loc[v['mask'], col] = mode_val[0]
                        note = "(Р·Р°РјРµРЅР° РЅР° РјРѕРґСѓ)"
                    elif "NaN" in strategy:
                        for v in inclusion_violations:
                            df_preview.loc[v['mask'], v['column']] = np.nan
                        note = "(Р·Р°РјРµРЅР° РЅР° NaN)"
                    elif "РЈРґР°Р»РёС‚СЊ" in strategy:
                        df_preview = df_preview[~combined_mask].reset_index(drop=True)
                        note = "(СѓРґР°Р»РµРЅРёРµ СЃС‚СЂРѕРє)"
                    elif "РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ" in strategy:
                        for v in inclusion_violations:
                            col = v['column']
                            default_val = inclusion_defaults.get(col, np.nan)  # inclusion_defaults РёР· РєРѕРЅС„РёРіР°
                            df_preview.loc[v['mask'], col] = default_val
                        note = "(Р·Р°РјРµРЅР° РЅР° default)"
                    else:
                        note = "(Р±РµР· РёР·РјРµРЅРµРЅРёР№)"

                    # РњРµС‚СЂРёРєРё (4 РєРѕР»РѕРЅРєРё)
                    c_p1, c_p2, c_p3, c_p4 = st.columns(4)
                    c_p1.metric("рџ“Љ Р—Р°РїРёСЃРµР№", f"{len(df_work)} в†’ {len(df_preview)}", delta=f"{len(df_preview)-len(df_work):+}")

                    if num_cols_to_check:
                        col = num_cols_to_check[0]
                        def safe_stat(d, c, f):
                            return f(d[c]) if not d.empty and c in d.columns and d[c].notna().any() else 0.0
                        m_b, s_b, d_b = safe_stat(df_work, col, np.mean), safe_stat(df_work, col, np.std), safe_stat(df_work, col, np.median)
                        m_a, s_a, d_a = safe_stat(df_preview, col, np.mean), safe_stat(df_preview, col, np.std), safe_stat(df_preview, col, np.median)
                        fmt = lambda x: f"{x:.2f}" if pd.notnull(x) and x != 0.0 else "N/A"
                        delta = lambda b, a: f"{((a-b)/abs(b)*100):+.1f}%" if b != 0 and pd.notnull(b) else "0%"
                        c_p2.metric("рџ“€ Mean", f"{fmt(m_b)} в†’ {fmt(m_a)}", delta=delta(m_b, m_a))
                        c_p3.metric("рџ“‰ Std", f"{fmt(s_b)} в†’ {fmt(s_a)}", delta=delta(s_b, s_a))
                        c_p4.metric("рџ“Љ Median", f"{fmt(d_b)} в†’ {fmt(d_a)}", delta=delta(d_b, d_a))

                    # РљРЅРѕРїРєРё РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ
                    st.divider()
                    c_ok, c_cancel = st.columns(2)
                    with c_ok:
                        if st.button("рџ’ѕ РџРѕРґС‚РІРµСЂРґРёС‚СЊ РёР·РјРµРЅРµРЅРёСЏ", type="primary", use_container_width=True, key="btn_confirm_inclusion"):
                            st.session_state.df_after_fixes = df_preview.copy()
                            st.session_state.df = df_preview
                            st.session_state.validation_ready = False
                            st.session_state.show_inclusion_preview = False
                            st.success("вњ… РЎС‚СЂР°С‚РµРіРёСЏ РїСЂРёРјРµРЅРµРЅР°! РџРµСЂРµР·Р°РїСѓСЃС‚РёС‚Рµ РІР°Р»РёРґР°С†РёСЋ.")
                            st.rerun()
                    with c_cancel:
                        if st.button("вќЊ РћС‚РјРµРЅР°", use_container_width=True, key="btn_cancel_inclusion"):
                            st.session_state.show_inclusion_preview = False
                            st.rerun()

        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
        # 7. РџР РћР’Р•Р РљРђ РЎРЎР«Р›РћР§РќРћР™ Р¦Р•Р›РћРЎРўРќРћРЎРўР (СЃ РёРЅС‚РµСЂР°РєС‚РёРІРЅС‹Рј РїР°Р№РїР»Р°Р№РЅРѕРј)
        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ

        # 7. Referential Integrity
        ref_results_local = locals().get('ref_results', [])
        ref_masks = locals().get('ref_masks', {})  # РњР°СЃРєРё РЅР°СЂСѓС€РµРЅРёР№ (РµСЃР»Рё РµСЃС‚СЊ)
        referential_issues = len(ref_results_local) > 0
        ref_violations = sum(r.get('РќР°СЂСѓС€РµРЅРёР№', 0) for r in ref_results_local) if referential_issues else 0

        make_card(" РџСЂРѕРІРµСЂРєР° СЃСЃС‹Р»РѕС‡РЅРѕР№ С†РµР»РѕСЃС‚РЅРѕСЃС‚Рё (referential integrity)", referential_issues,
            "**в—»пёЏ РњРµС‚СЂРёРєРё:** `% invalid = violations/valid`, РєРѕР»-РІРѕ 'СЃРёСЂРѕС‚СЃРєРёС…' Р·Р°РїРёСЃРµР№.  \n"
            "**в—»пёЏ РђР»РіРѕСЂРёС‚Рј:** Р’РµРєС‚РѕСЂРёР·РѕРІР°РЅРЅС‹Рµ РјР°СЃРєРё `(df[A]==cond) & df[B].isna()`, РїСЂРѕРІРµСЂРєР° РІРЅРµС€РЅРёС… РєР»СЋС‡РµР№.  \n"
            "**в—»пёЏ Р’Р»РёСЏРЅРёРµ РЅР° TS:** РќР°СЂСѓС€РµРЅРёРµ СЃРІСЏР·РµР№ РёСЃРєР°Р¶Р°РµС‚ Р°РіСЂРµРіР°С†РёСЋ, Р»РѕРјР°РµС‚ VAR/VECM.  \n"
            "**в—»пёЏ РћРїРёСЃР°РЅРёРµ:** РњРѕРґСѓР»СЊ РІС‹СЏРІР»СЏРµС‚ 'СЃРёСЂРѕС‚СЃРєРёРµ' Р·Р°РїРёСЃРё вЂ” СЃС‚СЂРѕРєРё, РіРґРµ Р·РЅР°С‡РµРЅРёРµ РІ РґРѕС‡РµСЂРЅРµР№ РєРѕР»РѕРЅРєРµ "
            "РЅРµ РёРјРµРµС‚ СЃРѕРѕС‚РІРµС‚СЃС‚РІРёСЏ РІ СЂРѕРґРёС‚РµР»СЊСЃРєРѕР№ С‚Р°Р±Р»РёС†Рµ/СЃРїСЂР°РІРѕС‡РЅРёРєРµ. РќР°РїСЂРёРјРµСЂ, С†РµРЅР° РґР»СЏ РЅРµСЃСѓС‰РµСЃС‚РІСѓСЋС‰РµР№ СЃС‚СЂР°РЅС‹, "
            "РѕРїРµСЂР°С†РёСЏ Р±РµР· СЃРІСЏР·Р°РЅРЅРѕРіРѕ РєР»РёРµРЅС‚Р°, РёР»Рё СЂР°Р·СЂС‹РІ РјРµР¶РґСѓ `supply_id` Рё С‚Р°Р±Р»РёС†РµР№ РїРѕСЃС‚Р°РІС‰РёРєРѕРІ. "
            "РќР°СЂСѓС€РµРЅРёСЏ СЃСЃС‹Р»РѕС‡РЅРѕР№ С†РµР»РѕСЃС‚РЅРѕСЃС‚Рё РєСЂРёС‚РёС‡РЅС‹ РґР»СЏ JOIN-РѕРїРµСЂР°С†РёР№ Рё РїР°РЅРµР»СЊРЅРѕРіРѕ Р°РЅР°Р»РёР·Р°.",
            "вњ… РЎСЃС‹Р»РѕС‡РЅР°СЏ С†РµР»РѕСЃС‚РЅРѕСЃС‚СЊ РЅРµ РЅР°СЂСѓС€РµРЅР°" if not referential_issues else f"вљ пёЏ РќР°Р№РґРµРЅРѕ {ref_violations} РЅР°СЂСѓС€РµРЅРёР№ СЃРІСЏР·РµР№",
            "вњ…" if not referential_issues else "вљ пёЏ", None)

        # в”Ђв”Ђ рџ”§ РРќРўР•Р РђРљРўРР’РќР«Р™ РџРђР™РџР›РђР™Рќ РћР‘Р РђР‘РћРўРљР (СЂР°СЃРєСЂС‹РІР°РµС‚СЃСЏ РїСЂРё РїСЂРѕР±Р»РµРјР°С…) в”Ђв”Ђ
        if referential_issues:
            with st.expander("рџ”§ РџРѕР»РЅС‹Р№ РїР°Р№РїР»Р°Р№РЅ РѕР±СЂР°Р±РѕС‚РєРё РЅР°СЂСѓС€РµРЅРёР№ СЃСЃС‹Р»РѕС‡РЅРѕР№ С†РµР»РѕСЃС‚РЅРѕСЃС‚Рё", expanded=True):
                st.markdown("### рџ“‹ РўР°Р±Р»РёС†Р° РЅР°СЂСѓС€РµРЅРёР№ СЃ СЂСѓС‡РЅРѕР№ РєРѕСЂСЂРµРєС‚РёСЂРѕРІРєРѕР№")

                # РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ СЃРѕСЃС‚РѕСЏРЅРёР№
                if "df_referential_work" not in st.session_state:
                    st.session_state.df_referential_work = df.copy()
                df_work = st.session_state.df_referential_work

                # Р¤РѕСЂРјРёСЂСѓРµРј РѕР±С‰СѓСЋ РјР°СЃРєСѓ РЅР°СЂСѓС€РµРЅРёР№
                combined_mask = pd.Series(False, index=df_work.index)

                # Р•СЃР»Рё РµСЃС‚СЊ РіРѕС‚РѕРІС‹Рµ РјР°СЃРєРё РёР· validate_referential()
                if ref_masks:
                    for mask in ref_masks.values():
                        combined_mask |= mask
                else:
                    # Fallback: РѕРїСЂРµРґРµР»СЏРµРј РЅР°СЂСѓС€РµРЅРёСЏ РёР· СЂРµР·СѓР»СЊС‚Р°С‚РѕРІ
                    for r in ref_results_local:
                        col = r.get('РљРѕР»РѕРЅРєР°') or r.get('child_column')
                        allowed_values = r.get('allowed_values', [])
                        if col and col in df_work.columns and allowed_values:
                            mask = ~df_work[col].isin(allowed_values) & df_work[col].notna()
                            combined_mask |= mask

                # Р¤РёР»СЊС‚СЂ РѕС‚РѕР±СЂР°Р¶РµРЅРёСЏ
                view_filter = st.radio(
                    "Р¤РёР»СЊС‚СЂ СЃС‚СЂРѕРє:",
                    ["вљ пёЏ РўРѕР»СЊРєРѕ СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё", "вњ… РџРѕРєР°Р·Р°С‚СЊ РІСЃС‘"],
                    horizontal=True,
                    key="referential_view_filter"
                )

                if view_filter == "вљ пёЏ РўРѕР»СЊРєРѕ СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё":
                    df_view = df_work[combined_mask].copy() if combined_mask.any() else df_work.iloc[:0].copy()
                else:
                    df_view = df_work.copy()

                # Р”РѕР±Р°РІР»СЏРµРј СЃС‚Р°С‚СѓСЃ-РєРѕР»РѕРЅРєСѓ
                df_view = df_view.copy()
                df_view.insert(0, '_STATUS', df_view.index.map(lambda idx: "рџ”ґ РЎРёСЂРѕС‚Р°" if combined_mask.loc[idx] else "рџџў РќРѕСЂРјР°"))

                # РРЅС‚РµСЂР°РєС‚РёРІРЅР°СЏ С‚Р°Р±Р»РёС†Р° (Р СѓС‡РЅР°СЏ РїСЂР°РІРєР°)
                edited_df = st.data_editor(
                    df_view,
                    use_container_width=True,
                    height=300,
                    num_rows="dynamic",
                    disabled=['_STATUS'],
                    key="referential_editor",
                    column_config={
                        "_STATUS": st.column_config.TextColumn("РЎС‚Р°С‚СѓСЃ", disabled=True, width="small")
                    }
                )

                # рџ’ѕ РљРќРћРџРљРђ РЎРћРҐР РђРќР•РќРРЇ
                c_save1, c_save2 = st.columns([4, 1])
                with c_save1:
                    st.caption("рџ’Ў РћС‚СЂРµРґР°РєС‚РёСЂСѓР№С‚Рµ Р·РЅР°С‡РµРЅРёСЏ РІСЂСѓС‡РЅСѓСЋ РёР»Рё РІС‹Р±РµСЂРёС‚Рµ СЃС‚СЂР°С‚РµРіРёСЋ РЅРёР¶Рµ")
                with c_save2:
                    if st.button("рџ’ѕ РЎРѕС…СЂР°РЅРёС‚СЊ", key="btn_save_manual_referential", use_container_width=True):
                        if '_STATUS' in edited_df.columns:
                            edited_df = edited_df.drop(columns=['_STATUS'])
                        df_work.update(edited_df)
                        st.session_state.df_referential_work = df_work
                        st.session_state.df = df_work
                        st.session_state.validation_ready = False
                        st.toast("вњ… РџСЂР°РІРєРё СЃРѕС…СЂР°РЅРµРЅС‹!", icon="вњ…")
                        st.rerun()

                st.divider()

                # РџР°РЅРµР»СЊ СЃС‚СЂР°С‚РµРіРёР№ (РђРІС‚РѕРјР°С‚РёС‡РµСЃРєР°СЏ РѕР±СЂР°Р±РѕС‚РєР°)
                st.markdown("### рџ§№ РЎС‚СЂР°С‚РµРіРёРё РѕР±СЂР°Р±РѕС‚РєРё РЅР°СЂСѓС€РµРЅРёР№ СЃСЃС‹Р»РѕС‡РЅРѕР№ С†РµР»РѕСЃС‚РЅРѕСЃС‚Рё")
                c1, c2 = st.columns([2, 1])
                with c1:
                    ref_strategy = st.radio(
                        "Р’С‹Р±РµСЂРёС‚Рµ СЃС‚СЂР°С‚РµРіРёСЋ:",
                        ["РЈРґР°Р»РёС‚СЊ СЃРёСЂРѕС‚СЃРєРёРµ Р·Р°РїРёСЃРё",
                        "Р—Р°РјРµРЅРёС‚СЊ РЅР° Р·РЅР°С‡РµРЅРёРµ РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ (РёР· СЃРїСЂР°РІРѕС‡РЅРёРєР°)",
                        "Р—Р°РјРµРЅРёС‚СЊ РЅР° РЅР°РёР±РѕР»РµРµ С‡Р°СЃС‚РѕРµ РІР°Р»РёРґРЅРѕРµ Р·РЅР°С‡РµРЅРёРµ (РјРѕРґР°)",
                        "Р—Р°РјРµРЅРёС‚СЊ РЅР° NaN (РїРѕРјРµС‚РёС‚СЊ РєР°Рє РїСЂРѕРїСѓСЃРє)",
                        "РўРѕР»СЊРєРѕ РѕС‚РјРµС‚РёС‚СЊ С„Р»Р°РіРѕРј (РЅРµ РјРµРЅСЏС‚СЊ РґР°РЅРЅС‹Рµ)"],
                        key="referential_fill_strategy"
                    )
                    if "РЈРґР°Р»РёС‚СЊ" in ref_strategy:
                        st.warning(f"вљ пёЏ Р‘СѓРґРµС‚ СѓРґР°Р»РµРЅРѕ **{combined_mask.sum()} СЃС‚СЂРѕРє** ({combined_mask.sum()/len(df_work)*100:.1f}% РґР°РЅРЅС‹С…).")
                    elif "РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ" in ref_strategy:
                        st.info("в„№пёЏ РќР°СЂСѓС€РµРЅРёСЏ Р±СѓРґСѓС‚ Р·Р°РјРµРЅРµРЅС‹ РЅР° Р·РЅР°С‡РµРЅРёРµ РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ РёР· СЃРїСЂР°РІРѕС‡РЅРёРєР° (РµСЃР»Рё Р·Р°РґР°РЅРѕ).")
                    elif "РјРѕРґСѓ" in ref_strategy:
                        st.info("в„№пёЏ РќР°СЂСѓС€РµРЅРёСЏ Р±СѓРґСѓС‚ Р·Р°РјРµРЅРµРЅС‹ РЅР° РЅР°РёР±РѕР»РµРµ С‡Р°СЃС‚РѕРµ РІР°Р»РёРґРЅРѕРµ Р·РЅР°С‡РµРЅРёРµ РІ РєРѕР»РѕРЅРєРµ.")
                    elif "NaN" in ref_strategy:
                        st.warning("вљ пёЏ РќР°СЂСѓС€РµРЅРёСЏ Р±СѓРґСѓС‚ Р·Р°РјРµРЅРµРЅС‹ РЅР° `NaN` (РїРѕС‚СЂРµР±СѓРµС‚ РґР°Р»СЊРЅРµР№С€РµР№ РѕР±СЂР°Р±РѕС‚РєРё РїСЂРѕРїСѓСЃРєРѕРІ).")
                    elif "С„Р»Р°РіРѕРј" in ref_strategy:
                        st.info("рџљ© Р‘СѓРґРµС‚ РґРѕР±Р°РІР»РµРЅР° РєРѕР»РѕРЅРєР° `_ref_valid` СЃ True/False.")
                with c2:
                    st.markdown("<div style='margin-top: 28px;'></div>", unsafe_allow_html=True)

                # РљРЅРѕРїРєР° Р·Р°РїСѓСЃРєР° РїСЂРµРІСЊСЋ
                if "show_referential_preview" not in st.session_state:
                    st.session_state.show_referential_preview = False

                st.markdown("<div style='margin: 15px 0;'></div>", unsafe_allow_html=True)
                if st.button("рџ“Љ РџРѕРєР°Р·Р°С‚СЊ РїСЂРѕРіРЅРѕР· РІР»РёСЏРЅРёСЏ РЅР° СЃС‚Р°С‚РёСЃС‚РёРєРё", type="secondary", use_container_width=True, key="btn_show_referential_preview"):
                    st.session_state.show_referential_preview = True
                    st.rerun()

                # Р‘Р»РѕРє РїСЂРµРІСЊСЋ
                if st.session_state.show_referential_preview:
                    strategy = ref_strategy
                    st.markdown("##### рџ“€ РџСЂРѕРіРЅРѕР· РІР»РёСЏРЅРёСЏ РЅР° СЃС‚Р°С‚РёСЃС‚РёРєСѓ:")

                    df_preview = df_work.copy()
                    num_cols_to_check = df_preview.select_dtypes(include=['number']).columns.tolist()

                    if "РЈРґР°Р»РёС‚СЊ" in strategy:
                        df_preview = df_preview[~combined_mask].reset_index(drop=True)
                        note = "(СѓРґР°Р»РµРЅРёРµ СЃРёСЂРѕС‚СЃРєРёС… Р·Р°РїРёСЃРµР№)"
                    elif "РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ" in strategy:
                        # Р—Р°РјРµРЅСЏРµРј РЅР° Р·РЅР°С‡РµРЅРёРµ РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ РёР· РїСЂР°РІРёР» (РµСЃР»Рё Р·Р°РґР°РЅРѕ)
                        for r in ref_results_local:
                            col = r.get('РљРѕР»РѕРЅРєР°') or r.get('child_column')
                            default_val = r.get('default_value', 'Unknown')
                            if col and col in df_preview.columns:
                                df_preview.loc[combined_mask, col] = default_val
                        note = "(Р·Р°РјРµРЅР° РЅР° default)"
                    elif "РјРѕРґСѓ" in strategy:
                        # Р—Р°РјРµРЅСЏРµРј РЅР° РјРѕРґСѓ РІР°Р»РёРґРЅС‹С… Р·РЅР°С‡РµРЅРёР№
                        for r in ref_results_local:
                            col = r.get('РљРѕР»РѕРЅРєР°') or r.get('child_column')
                            allowed = r.get('allowed_values', [])
                            if col and col in df_preview.columns and allowed:
                                valid_data = df_preview[df_preview[col].isin(allowed)][col]
                                if not valid_data.empty:
                                    mode_val = valid_data.mode()
                                    if len(mode_val) > 0:
                                        df_preview.loc[combined_mask, col] = mode_val[0]
                        note = "(Р·Р°РјРµРЅР° РЅР° РјРѕРґСѓ)"
                    elif "NaN" in strategy:
                        for r in ref_results_local:
                            col = r.get('РљРѕР»РѕРЅРєР°') or r.get('child_column')
                            if col and col in df_preview.columns:
                                df_preview.loc[combined_mask, col] = np.nan
                        note = "(Р·Р°РјРµРЅР° РЅР° NaN)"
                    else:
                        note = "(Р±РµР· РёР·РјРµРЅРµРЅРёР№)"

                    # РњРµС‚СЂРёРєРё (4 РєРѕР»РѕРЅРєРё)
                    c_p1, c_p2, c_p3, c_p4 = st.columns(4)
                    c_p1.metric("рџ“Љ Р—Р°РїРёСЃРµР№", f"{len(df_work)} в†’ {len(df_preview)}", delta=f"{len(df_preview)-len(df_work):+}")

                    if num_cols_to_check:
                        col = num_cols_to_check[0]
                        def safe_stat(d, c, f):
                            return f(d[c]) if not d.empty and c in d.columns and d[c].notna().any() else 0.0
                        m_b, s_b, d_b = safe_stat(df_work, col, np.mean), safe_stat(df_work, col, np.std), safe_stat(df_work, col, np.median)
                        m_a, s_a, d_a = safe_stat(df_preview, col, np.mean), safe_stat(df_preview, col, np.std), safe_stat(df_preview, col, np.median)
                        fmt = lambda x: f"{x:.2f}" if pd.notnull(x) and x != 0.0 else "N/A"
                        delta = lambda b, a: f"{((a-b)/abs(b)*100):+.1f}%" if b != 0 and pd.notnull(b) else "0%"
                        c_p2.metric("рџ“€ Mean", f"{fmt(m_b)} в†’ {fmt(m_a)}", delta=delta(m_b, m_a))
                        c_p3.metric("рџ“‰ Std", f"{fmt(s_b)} в†’ {fmt(s_a)}", delta=delta(s_b, s_a))
                        c_p4.metric("рџ“Љ Median", f"{fmt(d_b)} в†’ {fmt(d_a)}", delta=delta(d_b, d_a))

                    # РљРЅРѕРїРєРё РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ
                    st.divider()
                    c_ok, c_cancel = st.columns(2)
                    with c_ok:
                        if st.button("рџ’ѕ РџРѕРґС‚РІРµСЂРґРёС‚СЊ РёР·РјРµРЅРµРЅРёСЏ", type="primary", use_container_width=True, key="btn_confirm_referential"):
                            st.session_state.df_after_fixes = df_preview.copy()
                            st.session_state.df = df_preview
                            st.session_state.validation_ready = False
                            st.session_state.show_referential_preview = False
                            st.success("вњ… РЎС‚СЂР°С‚РµРіРёСЏ РїСЂРёРјРµРЅРµРЅР°! РџРµСЂРµР·Р°РїСѓСЃС‚РёС‚Рµ РІР°Р»РёРґР°С†РёСЋ.")
                            st.rerun()
                    with c_cancel:
                        if st.button("вќЊ РћС‚РјРµРЅР°", use_container_width=True, key="btn_cancel_referential"):
                            st.session_state.show_referential_preview = False
                            st.rerun()

        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
        # 8. РџР РћР’Р•Р РљРђ Р¦Р•Р›РћРЎРўРќРћРЎРўР РўР•РљРЎРўРђ (text quality)
        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ

        # 8. Text Quality
        text_results_local = locals().get('text_results', [])
        text_masks = locals().get('text_masks', {})  # РњР°СЃРєРё РЅР°СЂСѓС€РµРЅРёР№ (РµСЃР»Рё РµСЃС‚СЊ)
        text_issues = len(text_results_local) > 0
        text_problem_cols = len([r for r in text_results_local if r.get('РќР°СЂСѓС€РµРЅРёР№', 0) > 0])

        make_card(" РџСЂРѕРІРµСЂРєР° С†РµР»РѕСЃС‚РЅРѕСЃС‚Рё С‚РµРєСЃС‚Р° (text quality)", text_issues,
            "**в—»пёЏ РњРµС‚СЂРёРєРё:** `% issues = invalid/total`, РЅР°Р»РёС‡РёРµ 'РјСѓСЃРѕСЂРЅС‹С…' СЃРёРјРІРѕР»РѕРІ, РґР»РёРЅР° СЃС‚СЂРѕРє, РєРѕРґРёСЂРѕРІРєР°.  \n"
            "**в—»пёЏ РђР»РіРѕСЂРёС‚Рј:** `str.len()`, Regex-РїР°С‚С‚РµСЂРЅС‹ (СЃРїРµС†СЃРёРјРІРѕР»С‹, РЅРµС‡РёС‚Р°РµРјС‹Рµ СЃРёРјРІРѕР»С‹, mixed case).  \n"
            "**в—»пёЏ Р’Р»РёСЏРЅРёРµ РЅР° TS:** 'Р“СЂСЏР·РЅС‹Р№' С‚РµРєСЃС‚ С„СЂР°РіРјРµРЅС‚РёСЂСѓРµС‚ РєР°С‚РµРіРѕСЂРёРё РїСЂРё `groupby`, Р»РѕРјР°РµС‚ СЃРїСЂР°РІРѕС‡РЅРёРєРё.  \n"
            "**в—»пёЏ РћРїРёСЃР°РЅРёРµ:** РњРѕРґСѓР»СЊ Р°РЅР°Р»РёР·РёСЂСѓРµС‚ СЃС‚СЂРѕРєРѕРІС‹Рµ РєРѕР»РѕРЅРєРё РЅР° РЅР°Р»РёС‡РёРµ РїСЂРѕР±Р»РµРј РєР°С‡РµСЃС‚РІР°: РЅРµС‡РёС‚Р°РµРјС‹С… СЃРёРјРІРѕР»РѕРІ "
            "(РїРѕСЃР»РµРґРѕРІР°С‚РµР»СЊРЅРѕСЃС‚Рё С‚РёРїР° '', '\\x00', 'ГЇВїВЅ'), Р»РёС€РЅРёС… РїСЂРѕР±РµР»РѕРІ, СЃРјРµС€Р°РЅРЅРѕРіРѕ СЂРµРіРёСЃС‚СЂР°, РїРѕРґРѕР·СЂРёС‚РµР»СЊРЅРѕ РєРѕСЂРѕС‚РєРёС… "
            "РёР»Рё РґР»РёРЅРЅС‹С… Р·РЅР°С‡РµРЅРёР№, Р° С‚Р°РєР¶Рµ С‚РµС…РЅРёС‡РµСЃРєРёС… Р°СЂС‚РµС„Р°РєС‚РѕРІ РєРѕРґРёСЂРѕРІРєРё. РљСЂРёС‚РёС‡РЅРѕ РґР»СЏ РєРѕР»РѕРЅРѕРє Country, Category, "
            "Name вЂ” Р»СЋР±С‹Рµ РёСЃРєР°Р¶РµРЅРёСЏ РїСЂРёРІРѕРґСЏС‚ Рє РґСѓР±Р»РёСЂРѕРІР°РЅРёСЋ РєР°С‚РµРіРѕСЂРёР№ Рё РѕС€РёР±РѕС‡РЅРѕР№ Р°РіСЂРµРіР°С†РёРё.",
            "вњ… РљР°С‡РµСЃС‚РІРѕ С‚РµРєСЃС‚Р° СЃРѕРѕС‚РІРµС‚СЃС‚РІСѓРµС‚ СЃС‚Р°РЅРґР°СЂС‚Р°Рј" if not text_issues else f"вљ пёЏ РќР°Р№РґРµРЅРѕ {text_problem_cols} С‚РµРєСЃС‚РѕРІС‹С… РєРѕР»РѕРЅРѕРє СЃ РїСЂРѕР±Р»РµРјР°РјРё",
            "вњ…" if not text_issues else "пёЏ", None)

        # в”Ђв”Ђ РРќРўР•Р РђРљРўРР’РќР«Р™ РџРђР™РџР›РђР™Рќ РћР‘Р РђР‘РћРўРљР (СЂР°СЃРєСЂС‹РІР°РµС‚СЃСЏ РїСЂРё РїСЂРѕР±Р»РµРјР°С…) в”Ђв”Ђ
        if text_issues:
            with st.expander("рџ”§ РџРѕР»РЅС‹Р№ РїР°Р№РїР»Р°Р№РЅ РѕР±СЂР°Р±РѕС‚РєРё С‚РµРєСЃС‚РѕРІС‹С… РЅР°СЂСѓС€РµРЅРёР№", expanded=True):
                st.markdown("### рџ“‹ РўР°Р±Р»РёС†Р° РЅР°СЂСѓС€РµРЅРёР№ СЃ СЂСѓС‡РЅРѕР№ РєРѕСЂСЂРµРєС‚РёСЂРѕРІРєРѕР№")

                # РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ СЃРѕСЃС‚РѕСЏРЅРёР№
                if "df_text_work" not in st.session_state:
                    st.session_state.df_text_work = df.copy()
                df_work = st.session_state.df_text_work

                # Р¤РѕСЂРјРёСЂСѓРµРј РѕР±С‰СѓСЋ РјР°СЃРєСѓ РЅР°СЂСѓС€РµРЅРёР№
                combined_mask = pd.Series(False, index=df_work.index)

                if text_masks:
                    for mask in text_masks.values():
                        combined_mask |= mask
                else:
                    # Fallback: РѕРїСЂРµРґРµР»СЏРµРј РЅР°СЂСѓС€РµРЅРёСЏ РїРѕ СЂРµР·СѓР»СЊС‚Р°С‚Р°Рј РїСЂРѕРІРµСЂРєРё
                    text_cols = df_work.select_dtypes(include=['object', 'string']).columns.tolist()
                    for r in text_results_local:
                        col = r.get('РљРѕР»РѕРЅРєР°')
                        if col and col in df_work.columns:
                            issue_type = r.get('РўРёРї', '').lower()
                            if 'РјСѓСЃРѕСЂ' in issue_type or 'СЃРёРјРІРѕР»' in issue_type:
                                # РџР°С‚С‚РµСЂРЅ РјСѓСЃРѕСЂРЅС‹С… СЃРёРјРІРѕР»РѕРІ
                                mask = df_work[col].astype(str).str.contains(
                                    r'[\x00\x01\x02ГЇВїВЅ\ufffd]', na=False, regex=True
                                )
                            elif 'РґР»РёРЅР°' in issue_type or 'len' in issue_type:
                                # РЎР»РёС€РєРѕРј РєРѕСЂРѕС‚РєРёРµ РёР»Рё РґР»РёРЅРЅС‹Рµ Р·РЅР°С‡РµРЅРёСЏ
                                mask = (df_work[col].astype(str).str.len() < 1) | \
                                       (df_work[col].astype(str).str.len() > 200)
                            elif 'СЂРµРіРёСЃС‚СЂ' in issue_type or 'case' in issue_type:
                                # РЎРјРµС€Р°РЅРЅС‹Р№ СЂРµРіРёСЃС‚СЂ
                                mask = df_work[col].astype(str).str.contains(
                                    r'[A-ZРђ-РЇРЃ]+[a-zР°-СЏС‘]+[A-ZРђ-РЇРЃ]', na=False, regex=True
                                )
                            else:
                                # РћР±С‰РёР№ РїР°С‚С‚РµСЂРЅ: non-printable chars
                                mask = df_work[col].astype(str).str.contains(
                                    r'[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]', na=False, regex=True
                                )
                            combined_mask |= mask

                # Р¤РёР»СЊС‚СЂ РѕС‚РѕР±СЂР°Р¶РµРЅРёСЏ
                view_filter = st.radio(
                    "Р¤РёР»СЊС‚СЂ СЃС‚СЂРѕРє:",
                    ["вљ пёЏ РўРѕР»СЊРєРѕ СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё", "вњ… РџРѕРєР°Р·Р°С‚СЊ РІСЃС‘"],
                    horizontal=True,
                    key="text_view_filter"
                )

                if view_filter == "вљ пёЏ РўРѕР»СЊРєРѕ СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё":
                    df_view = df_work[combined_mask].copy() if combined_mask.any() else df_work.iloc[:0].copy()
                else:
                    df_view = df_work.copy()

                # Р”РѕР±Р°РІР»СЏРµРј СЃС‚Р°С‚СѓСЃ-РєРѕР»РѕРЅРєСѓ
                df_view = df_view.copy()
                df_view.insert(0, '_STATUS', df_view.index.map(lambda idx: "рџ”ґ РџСЂРѕР±Р»РµРјР°" if combined_mask.loc[idx] else "рџџў РќРѕСЂРјР°"))

                # РРЅС‚РµСЂР°РєС‚РёРІРЅР°СЏ С‚Р°Р±Р»РёС†Р° (Р СѓС‡РЅР°СЏ РїСЂР°РІРєР°)
                edited_df = st.data_editor(
                    df_view,
                    use_container_width=True,
                    height=300,
                    num_rows="dynamic",
                    disabled=['_STATUS'],
                    key="text_editor",
                    column_config={
                        "_STATUS": st.column_config.TextColumn("РЎС‚Р°С‚СѓСЃ", disabled=True, width="small")
                    }
                )

                # рџ’ѕ РљРќРћРџРљРђ РЎРћРҐР РђРќР•РќРРЇ
                c_save1, c_save2 = st.columns([4, 1])
                with c_save1:
                    st.caption("рџ’Ў РћС‚СЂРµРґР°РєС‚РёСЂСѓР№С‚Рµ Р·РЅР°С‡РµРЅРёСЏ РІСЂСѓС‡РЅСѓСЋ РёР»Рё РІС‹Р±РµСЂРёС‚Рµ СЃС‚СЂР°С‚РµРіРёСЋ РЅРёР¶Рµ")
                with c_save2:
                    if st.button("рџ’ѕ РЎРѕС…СЂР°РЅРёС‚СЊ", key="btn_save_manual_text", use_container_width=True):
                        if '_STATUS' in edited_df.columns:
                            edited_df = edited_df.drop(columns=['_STATUS'])
                        df_work.update(edited_df)
                        st.session_state.df_text_work = df_work
                        st.session_state.df = df_work
                        st.session_state.validation_ready = False
                        st.toast("вњ… РџСЂР°РІРєРё СЃРѕС…СЂР°РЅРµРЅС‹!", icon="вњ…")
                        st.rerun()

                st.divider()

                # РџР°РЅРµР»СЊ СЃС‚СЂР°С‚РµРіРёР№ (РђРІС‚РѕРјР°С‚РёС‡РµСЃРєР°СЏ РѕР±СЂР°Р±РѕС‚РєР°)
                st.markdown("### рџ§№ РЎС‚СЂР°С‚РµРіРёРё РѕР±СЂР°Р±РѕС‚РєРё С‚РµРєСЃС‚РѕРІС‹С… РЅР°СЂСѓС€РµРЅРёР№")
                c1, c2 = st.columns([2, 1])
                with c1:
                    text_strategy = st.radio(
                        "Р’С‹Р±РµСЂРёС‚Рµ СЃС‚СЂР°С‚РµРіРёСЋ:",
                        ["РћС‡РёСЃС‚РёС‚СЊ СЃРїРµС†СЃРёРјРІРѕР»С‹ Рё РЅРѕСЂРјР°Р»РёР·РѕРІР°С‚СЊ (strip + lower)",
                        "РЈРґР°Р»РёС‚СЊ СЃС‚СЂРѕРєРё СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё С‚РµРєСЃС‚Р°",
                        "Р—Р°РјРµРЅРёС‚СЊ РЅР° NaN (РїРѕРјРµС‚РёС‚СЊ РєР°Рє РїСЂРѕРїСѓСЃРє)",
                        "Р—Р°РјРµРЅРёС‚СЊ РЅР° 'РќРµРёР·РІРµСЃС‚РЅРѕ' (default РґР»СЏ РєР°С‚РµРіРѕСЂРёР№)",
                        "РўРѕР»СЊРєРѕ РѕС‚РјРµС‚РёС‚СЊ С„Р»Р°РіРѕРј (РЅРµ РјРµРЅСЏС‚СЊ РґР°РЅРЅС‹Рµ)"],
                        key="text_fill_strategy"
                    )
                    if "РћС‡РёСЃС‚РёС‚СЊ" in text_strategy:
                        st.info("в„№пёЏ Р‘СѓРґРµС‚ РІС‹РїРѕР»РЅРµРЅР° РЅРѕСЂРјР°Р»РёР·Р°С†РёСЏ: СѓРґР°Р»РµРЅРёРµ СЃРїРµС†СЃРёРјРІРѕР»РѕРІ, strip(), lower().")
                    elif "РЈРґР°Р»РёС‚СЊ" in text_strategy:
                        st.warning(f"вљ пёЏ Р‘СѓРґРµС‚ СѓРґР°Р»РµРЅРѕ **{combined_mask.sum()} СЃС‚СЂРѕРє** ({combined_mask.sum()/len(df_work)*100:.1f}% РґР°РЅРЅС‹С…).")
                    elif "NaN" in text_strategy:
                        st.warning("вљ пёЏ РќР°СЂСѓС€РµРЅРёСЏ Р±СѓРґСѓС‚ Р·Р°РјРµРЅРµРЅС‹ РЅР° `NaN` (РїРѕС‚СЂРµР±СѓРµС‚ РґР°Р»СЊРЅРµР№С€РµР№ РѕР±СЂР°Р±РѕС‚РєРё РїСЂРѕРїСѓСЃРєРѕРІ).")
                    elif "РќРµРёР·РІРµСЃС‚РЅРѕ" in text_strategy:
                        st.info("в„№пёЏ РќР°СЂСѓС€РµРЅРёСЏ Р±СѓРґСѓС‚ Р·Р°РјРµРЅРµРЅС‹ РЅР° СЃС‚СЂРѕРєСѓ `'РќРµРёР·РІРµСЃС‚РЅРѕ'` (РґР»СЏ РєР°С‚РµРіРѕСЂРёР№).")
                    elif "С„Р»Р°РіРѕРј" in text_strategy:
                        st.info("рџљ© Р‘СѓРґРµС‚ РґРѕР±Р°РІР»РµРЅР° РєРѕР»РѕРЅРєР° `_text_valid` СЃ True/False.")
                with c2:
                    st.markdown("<div style='margin-top: 28px;'></div>", unsafe_allow_html=True)

                # РљРЅРѕРїРєР° Р·Р°РїСѓСЃРєР° РїСЂРµРІСЊСЋ
                if "show_text_preview" not in st.session_state:
                    st.session_state.show_text_preview = False

                st.markdown("<div style='margin: 15px 0;'></div>", unsafe_allow_html=True)
                if st.button(" РџРѕРєР°Р·Р°С‚СЊ РїСЂРѕРіРЅРѕР· РІР»РёСЏРЅРёСЏ РЅР° С‚РµРєСЃС‚", type="secondary", use_container_width=True, key="btn_show_text_preview"):
                    st.session_state.show_text_preview = True
                    st.rerun()

                # Р‘Р»РѕРє РїСЂРµРІСЊСЋ (СЃРїРµС†РёС„РёС‡РЅС‹Р№ РґР»СЏ С‚РµРєСЃС‚Р°)
                if st.session_state.show_text_preview:
                    strategy = text_strategy
                    st.markdown("##### рџ“€ РџСЂРѕРіРЅРѕР· РІР»РёСЏРЅРёСЏ РЅР° С‚РµРєСЃС‚РѕРІС‹Рµ РєРѕР»РѕРЅРєРё:")

                    df_preview = df_work.copy()
                    text_cols = df_preview.select_dtypes(include=['object', 'string']).columns.tolist()

                    if "РћС‡РёСЃС‚РёС‚СЊ" in strategy:
                        for col in text_cols:
                            # РќРѕСЂРјР°Р»РёР·Р°С†РёСЏ С‚РѕР»СЊРєРѕ РїСЂРѕР±Р»РµРјРЅС‹С… Р·РЅР°С‡РµРЅРёР№
                            df_preview.loc[combined_mask, col] = (
                                df_preview.loc[combined_mask, col]
                                .astype(str)
                                .str.strip()
                                .str.lower()
                                .str.replace(r'[^\w\sР°-СЏС‘a-z0-9\-]', '', regex=True)
                                .str.replace(r'\s+', ' ', regex=True)
                            )
                        note = "(РЅРѕСЂРјР°Р»РёР·Р°С†РёСЏ С‚РµРєСЃС‚Р°)"
                    elif "РЈРґР°Р»РёС‚СЊ" in strategy:
                        df_preview = df_preview[~combined_mask].reset_index(drop=True)
                        note = "(СѓРґР°Р»РµРЅРёРµ СЃС‚СЂРѕРє)"
                    elif "NaN" in strategy:
                        for col in text_cols:
                            df_preview.loc[combined_mask, col] = np.nan
                        note = "(Р·Р°РјРµРЅР° РЅР° NaN)"
                    elif "РќРµРёР·РІРµСЃС‚РЅРѕ" in strategy:
                        for col in text_cols:
                            df_preview.loc[combined_mask, col] = "РќРµРёР·РІРµСЃС‚РЅРѕ"
                        note = "(Р·Р°РјРµРЅР° РЅР° 'РќРµРёР·РІРµСЃС‚РЅРѕ')"
                    else:
                        note = "(Р±РµР· РёР·РјРµРЅРµРЅРёР№)"

                    # РњРµС‚СЂРёРєРё РґР»СЏ С‚РµРєСЃС‚Р° (4 РєРѕР»РѕРЅРєРё)
                    c_p1, c_p2, c_p3, c_p4 = st.columns(4)
                    c_p1.metric("рџ“Љ Р—Р°РїРёСЃРµР№", f"{len(df_work)} в†’ {len(df_preview)}", delta=f"{len(df_preview)-len(df_work):+}")

                    if text_cols:
                        col = text_cols[0]
                        # Р”Р»СЏ С‚РµРєСЃС‚Р° СЃС‡РёС‚Р°РµРј РґСЂСѓРіРёРµ РјРµС‚СЂРёРєРё
                        def safe_text_stat(d, c):
                            if c not in d.columns or d.empty:
                                return 0, 0, 0
                            s = d[c].astype(str)
                            avg_len = s.str.len().mean()
                            unique = d[c].nunique()
                            invalid = combined_mask.sum() if len(d) == len(df_work) else 0
                            return avg_len, unique, invalid

                        al_b, u_b, inv_b = safe_text_stat(df_work, col)
                        al_a, u_a, inv_a = safe_text_stat(df_preview, col)

                        fmt = lambda x: f"{x:.1f}" if pd.notnull(x) else "N/A"

                        c_p2.metric("рџ“Џ Avg РґР»РёРЅР°", f"{fmt(al_b)} в†’ {fmt(al_a)}")
                        c_p3.metric(" РЈРЅРёРєР°Р»СЊРЅС‹С…", f"{u_b} в†’ {u_a}")
                        c_p4.metric("вљ пёЏ РќР°СЂСѓС€РµРЅРёР№", f"{inv_b} в†’ {inv_a}")

                    st.caption(f"рџ“ќ РЎС‚СЂР°С‚РµРіРёСЏ: {note}")

                    # РљРЅРѕРїРєРё РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ
                    st.divider()
                    c_ok, c_cancel = st.columns(2)
                    with c_ok:
                        if st.button("рџ’ѕ РџРѕРґС‚РІРµСЂРґРёС‚СЊ РёР·РјРµРЅРµРЅРёСЏ", type="primary", use_container_width=True, key="btn_confirm_text"):
                            st.session_state.df_after_fixes = df_preview.copy()
                            st.session_state.df = df_preview
                            st.session_state.validation_ready = False
                            st.session_state.show_text_preview = False
                            st.success("вњ… РЎС‚СЂР°С‚РµРіРёСЏ РїСЂРёРјРµРЅРµРЅР°! РџРµСЂРµР·Р°РїСѓСЃС‚РёС‚Рµ РІР°Р»РёРґР°С†РёСЋ.")
                            st.rerun()
                    with c_cancel:
                        if st.button("вќЊ РћС‚РјРµРЅР°", use_container_width=True, key="btn_cancel_text"):
                            st.session_state.show_text_preview = False
                            st.rerun()

        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
        # 9. РџР РћР’Р•Р РљРђ Р РђР’РќРћРњР•Р РќРћРЎРўР Р’Р Р•РњР•РќРќРћР“Рћ РЁРђР“Рђ (regularity)
        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ

        # 9. Regularity Check
        regularity_results_local = locals().get('regularity_results', [])
        regularity_masks = locals().get('regularity_masks', {})
        regularity_freq_info = locals().get('regularity_freq_info', {})

        regularity_issues = len(regularity_results_local) > 0
        regularity_gaps = sum(r.get('РџСЂРѕРїСѓСЃРєРѕРІ', r.get('Р’СЃРµРіРѕ РїСЂРѕРїСѓСЃРєРѕРІ', 0)) for r in regularity_results_local) if regularity_issues else 0

        make_card(" РџСЂРѕРІРµСЂРєР° СЂР°РІРЅРѕРјРµСЂРЅРѕСЃС‚Рё РІСЂРµРјРµРЅРЅРѕРіРѕ С€Р°РіР° (regularity)", regularity_issues,
            "**в—»пёЏ РњРµС‚СЂРёРєРё:** `inferred_freq` (РѕРїСЂРµРґРµР»РµРЅРЅР°СЏ С‡Р°СЃС‚РѕС‚Р°), `gap_count` (С‡РёСЃР»Рѕ РїСЂРѕРїСѓСЃРєРѕРІ), `interval_variance`.  \n"
            "**в—»пёЏ РђР»РіРѕСЂРёС‚Рј:** `pd.infer_freq()`, РІС‹С‡РёСЃР»РµРЅРёРµ РёРЅС‚РµСЂРІР°Р»РѕРІ `diff()`, РґРµС‚РµРєС†РёСЏ Р°РЅРѕРјР°Р»РёР№ (>1.5Г—РјРѕРґС‹).  \n"
            "**в—»пёЏ Р’Р»РёСЏРЅРёРµ РЅР° TS:** РќРµСЂР°РІРЅРѕРјРµСЂРЅС‹Р№ С€Р°Рі Р»РѕРјР°РµС‚ ARIMA/SARIMA (С‚СЂРµР±СѓСЋС‚ СЂРµРіСѓР»СЏСЂРЅС‹Р№ РёРЅРґРµРєСЃ), РёСЃРєР°Р¶Р°РµС‚ FFT/СЃРїРµРєС‚СЂР°Р»СЊРЅС‹Р№ Р°РЅР°Р»РёР·.  \n"
            "**в—»пёЏ РћРїРёСЃР°РЅРёРµ:** РњРѕРґСѓР»СЊ РїСЂРѕРІРµСЂСЏРµС‚, С‡С‚Рѕ РІСЂРµРјРµРЅРЅС‹Рµ РјРµС‚РєРё СЃР»РµРґСѓСЋС‚ СЃ РїРѕСЃС‚РѕСЏРЅРЅС‹Рј РёРЅС‚РµСЂРІР°Р»РѕРј (РґРµРЅСЊ, РјРµСЃСЏС†, РіРѕРґ). "
            "Р”Р»СЏ РїР°РЅРµР»СЊРЅС‹С… РґР°РЅРЅС‹С… (СЃС‚СЂР°РЅС‹ Г— РІСЂРµРјСЏ) РїСЂРѕРІРµСЂРєР° РІС‹РїРѕР»РЅСЏРµС‚СЃСЏ РІРЅСѓС‚СЂРё РєР°Р¶РґРѕР№ РіСЂСѓРїРїС‹. РћР±РЅР°СЂСѓР¶РёРІР°СЋС‚СЃСЏ РїСЂРѕРїСѓС‰РµРЅРЅС‹Рµ РїРµСЂРёРѕРґС‹, "
            "РЅРµСЂРµРіСѓР»СЏСЂРЅС‹Рµ РёРЅС‚РµСЂРІР°Р»С‹, СЃРјРµС€Р°РЅРЅС‹Рµ С‡Р°СЃС‚РѕС‚С‹. РљСЂРёС‚РёС‡РЅРѕ РґР»СЏ РјРѕРґРµР»РµР№, С‚СЂРµР±СѓСЋС‰РёС… DatetimeIndex СЃ РїРѕСЃС‚РѕСЏРЅРЅРѕР№ С‡Р°СЃС‚РѕС‚РѕР№.",
            "вњ… Р’СЂРµРјРµРЅРЅРѕР№ С€Р°Рі СЂР°РІРЅРѕРјРµСЂРЅС‹Р№" if not regularity_issues else f"вљ пёЏ РћР±РЅР°СЂСѓР¶РµРЅРѕ {regularity_gaps} РїСЂРѕРїСѓСЃРєРѕРІ РІ {len(regularity_results_local)} РіСЂСѓРїРїР°С…",
            "вњ…" if not regularity_issues else "вљ пёЏ", None)

        # в”Ђв”Ђ рџ”§ РРќРўР•Р РђРљРўРР’РќР«Р™ РџРђР™РџР›РђР™Рќ РћР‘Р РђР‘РћРўРљР (СЂР°СЃРєСЂС‹РІР°РµС‚СЃСЏ РїСЂРё РїСЂРѕР±Р»РµРјР°С…) в”Ђв”Ђ
        if regularity_issues:
            with st.expander("рџ”§ РџРѕР»РЅС‹Р№ РїР°Р№РїР»Р°Р№РЅ РѕР±СЂР°Р±РѕС‚РєРё РЅР°СЂСѓС€РµРЅРёР№ СЂРµРіСѓР»СЏСЂРЅРѕСЃС‚Рё", expanded=True):
                st.markdown("### рџ“‹ РўР°Р±Р»РёС†Р° РЅР°СЂСѓС€РµРЅРёР№ СЃ СЂСѓС‡РЅРѕР№ РєРѕСЂСЂРµРєС‚РёСЂРѕРІРєРѕР№")

                # РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ СЃРѕСЃС‚РѕСЏРЅРёР№
                if "df_regularity_work" not in st.session_state:
                    st.session_state.df_regularity_work = df.copy()
                df_work = st.session_state.df_regularity_work

                # Р¤РѕСЂРјРёСЂСѓРµРј РѕР±С‰СѓСЋ РјР°СЃРєСѓ РЅР°СЂСѓС€РµРЅРёР№
                combined_mask = pd.Series(False, index=df_work.index)

                if regularity_masks:
                    for mask in regularity_masks.values():
                        combined_mask |= mask
                else:
                    # Fallback: РѕРїСЂРµРґРµР»СЏРµРј РЅР°СЂСѓС€РµРЅРёСЏ РёР· СЂРµР·СѓР»СЊС‚Р°С‚РѕРІ
                    date_col = None
                    for r in regularity_results_local:
                        if 'Р’СЂРµРјРµРЅРЅР°СЏ РєРѕР»РѕРЅРєР°' in r:
                            date_col = r['Р’СЂРµРјРµРЅРЅР°СЏ РєРѕР»РѕРЅРєР°']
                            break

                    if date_col and date_col in df_work.columns:
                        if pd.api.types.is_datetime64_any_dtype(df_work[date_col]):
                            ts_sorted = df_work.sort_values(date_col)
                            intervals = ts_sorted[date_col].diff()
                            modal_interval = intervals.mode().iloc[0] if len(intervals.mode()) > 0 else intervals.median()
                            combined_mask.loc[intervals[intervals > modal_interval * 1.5].index] = True

                # Р¤РёР»СЊС‚СЂ РѕС‚РѕР±СЂР°Р¶РµРЅРёСЏ
                view_filter = st.radio(
                    "Р¤РёР»СЊС‚СЂ СЃС‚СЂРѕРє:",
                    ["вљ пёЏ РўРѕР»СЊРєРѕ СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё (РїСЂРѕРїСѓСЃРєРё)", "вњ… РџРѕРєР°Р·Р°С‚СЊ РІСЃС‘"],
                    horizontal=True,
                    key="regularity_view_filter"
                )

                if view_filter == "вљ пёЏ РўРѕР»СЊРєРѕ СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё (РїСЂРѕРїСѓСЃРєРё)":
                    df_view = df_work[combined_mask].copy() if combined_mask.any() else df_work.iloc[:0].copy()
                else:
                    df_view = df_work.copy()

                # Р”РѕР±Р°РІР»СЏРµРј СЃС‚Р°С‚СѓСЃ-РєРѕР»РѕРЅРєСѓ
                df_view = df_view.copy()
                df_view.insert(0, '_STATUS', df_view.index.map(lambda idx: "рџ”ґ РџСЂРѕРїСѓСЃРє" if combined_mask.loc[idx] else "рџџў РќРѕСЂРјР°"))

                # РРЅС‚РµСЂР°РєС‚РёРІРЅР°СЏ С‚Р°Р±Р»РёС†Р° (Р СѓС‡РЅР°СЏ РїСЂР°РІРєР°)
                edited_df = st.data_editor(
                    df_view,
                    use_container_width=True,
                    height=300,
                    num_rows="dynamic",
                    disabled=['_STATUS'],
                    key="regularity_editor",
                    column_config={
                        "_STATUS": st.column_config.TextColumn("РЎС‚Р°С‚СѓСЃ", disabled=True, width="small")
                    }
                )

                # рџ’ѕ РљРќРћРџРљРђ РЎРћРҐР РђРќР•РќРРЇ
                c_save1, c_save2 = st.columns([4, 1])
                with c_save1:
                    st.caption("рџ’Ў РћС‚СЂРµРґР°РєС‚РёСЂСѓР№С‚Рµ Р·РЅР°С‡РµРЅРёСЏ РІСЂСѓС‡РЅСѓСЋ РёР»Рё РІС‹Р±РµСЂРёС‚Рµ СЃС‚СЂР°С‚РµРіРёСЋ РЅРёР¶Рµ")
                with c_save2:
                    if st.button("рџ’ѕ РЎРѕС…СЂР°РЅРёС‚СЊ", key="btn_save_manual_regularity", use_container_width=True):
                        if '_STATUS' in edited_df.columns:
                            edited_df = edited_df.drop(columns=['_STATUS'])
                        df_work.update(edited_df)
                        st.session_state.df_regularity_work = df_work
                        st.session_state.df = df_work
                        st.session_state.validation_ready = False
                        st.toast("вњ… РџСЂР°РІРєРё СЃРѕС…СЂР°РЅРµРЅС‹!", icon="вњ…")
                        st.rerun()

                st.divider()

                # РџР°РЅРµР»СЊ СЃС‚СЂР°С‚РµРіРёР№ (РђРІС‚РѕРјР°С‚РёС‡РµСЃРєР°СЏ РѕР±СЂР°Р±РѕС‚РєР°)
                st.markdown("### рџ§№ РЎС‚СЂР°С‚РµРіРёРё РѕР±СЂР°Р±РѕС‚РєРё РїСЂРѕРїСѓСЃРєРѕРІ РІСЂРµРјРµРЅРЅРѕРіРѕ СЂСЏРґР°")
                c1, c2 = st.columns([2, 1])
                with c1:
                    regularity_strategy = st.radio(
                        "Р’С‹Р±РµСЂРёС‚Рµ СЃС‚СЂР°С‚РµРіРёСЋ:",
                        ["Resample + Interpolate (Р»РёРЅРµР№РЅР°СЏ РёРЅС‚РµСЂРїРѕР»СЏС†РёСЏ)",
                        "Resample + Forward Fill (РїРѕСЃР»РµРґРЅРµРµ Р·РЅР°С‡РµРЅРёРµ)",
                        "Resample + Backward Fill (СЃР»РµРґСѓСЋС‰РµРµ Р·РЅР°С‡РµРЅРёРµ)",
                        "AsFreq (РѕР±РѕР·РЅР°С‡РёС‚СЊ РїСЂРѕРїСѓСЃРєРё РєР°Рє NaN)",
                        "Р”РѕР±Р°РІРёС‚СЊ С„РёРєС‚РёРІРЅС‹Рµ Р·Р°РїРёСЃРё СЃ РЅСѓР»РµРІС‹РјРё Р·РЅР°С‡РµРЅРёСЏРјРё",
                        "РўРѕР»СЊРєРѕ РѕС‚РјРµС‚РёС‚СЊ С„Р»Р°РіРѕРј (РЅРµ РјРµРЅСЏС‚СЊ РґР°РЅРЅС‹Рµ)"],
                        key="regularity_fill_strategy"
                    )
                    if "Interpolate" in regularity_strategy:
                        st.info("в„№пёЏ РџСЂРѕРїСѓС‰РµРЅРЅС‹Рµ Р·РЅР°С‡РµРЅРёСЏ Р±СѓРґСѓС‚ Р·Р°РїРѕР»РЅРµРЅС‹ Р»РёРЅРµР№РЅРѕР№ РёРЅС‚РµСЂРїРѕР»СЏС†РёРµР№ РјРµР¶РґСѓ СЃРѕСЃРµРґРЅРёРјРё С‚РѕС‡РєР°РјРё.")
                    elif "Forward Fill" in regularity_strategy:
                        st.info("в„№пёЏ РџСЂРѕРїСѓСЃРєРё Р±СѓРґСѓС‚ Р·Р°РїРѕР»РЅРµРЅС‹ РїРѕСЃР»РµРґРЅРёРј РґРѕСЃС‚СѓРїРЅС‹Рј Р·РЅР°С‡РµРЅРёРµРј (РјРµС‚РѕРґ LOCF).")
                    elif "Backward Fill" in regularity_strategy:
                        st.info("в„№пёЏ РџСЂРѕРїСѓСЃРєРё Р±СѓРґСѓС‚ Р·Р°РїРѕР»РЅРµРЅС‹ СЃР»РµРґСѓСЋС‰РёРј Р·РЅР°С‡РµРЅРёРµРј (РјРµС‚РѕРґ NOCB).")
                    elif "AsFreq" in regularity_strategy:
                        st.warning("вљ пёЏ Р СЏРґ Р±СѓРґРµС‚ РїСЂРёРІРµРґРµРЅ Рє СЂРµРіСѓР»СЏСЂРЅРѕР№ С‡Р°СЃС‚РѕС‚Рµ, РїСЂРѕРїСѓСЃРєРё РѕР±РѕР·РЅР°С‡РµРЅС‹ РєР°Рє NaN.")
                    elif "С„РёРєС‚РёРІРЅС‹Рµ" in regularity_strategy:
                        st.warning("вљ пёЏ Р‘СѓРґСѓС‚ РґРѕР±Р°РІР»РµРЅС‹ СЃС‚СЂРѕРєРё СЃ РїСЂРѕРїСѓС‰РµРЅРЅС‹РјРё РґР°С‚Р°РјРё Рё Р·РЅР°С‡РµРЅРёСЏРјРё 0/NaN.")
                    elif "С„Р»Р°РіРѕРј" in regularity_strategy:
                        st.info("рџљ© Р‘СѓРґРµС‚ РґРѕР±Р°РІР»РµРЅР° РєРѕР»РѕРЅРєР° `_has_gap` СЃ РѕС‚РјРµС‚РєРѕР№ Рѕ РїСЂРѕРїСѓСЃРєР°С….")
                with c2:
                    st.markdown("<div style='margin-top: 28px;'></div>", unsafe_allow_html=True)

                # РљРЅРѕРїРєР° Р·Р°РїСѓСЃРєР° РїСЂРµРІСЊСЋ
                if "show_regularity_preview" not in st.session_state:
                    st.session_state.show_regularity_preview = False

                st.markdown("<div style='margin: 15px 0;'></div>", unsafe_allow_html=True)
                if st.button("рџ“Љ РџРѕРєР°Р·Р°С‚СЊ РїСЂРѕРіРЅРѕР· РІР»РёСЏРЅРёСЏ РЅР° СЃС‚Р°С‚РёСЃС‚РёРєСѓ", type="secondary", use_container_width=True, key="btn_show_regularity_preview"):
                    st.session_state.show_regularity_preview = True
                    st.rerun()

                # Р‘Р»РѕРє РїСЂРµРІСЊСЋ
                if st.session_state.show_regularity_preview:
                    strategy = regularity_strategy
                    st.markdown("##### рџ“€ РџСЂРѕРіРЅРѕР· РІР»РёСЏРЅРёСЏ РЅР° РІСЂРµРјРµРЅРЅРѕР№ СЂСЏРґ:")

                    df_preview = df_work.copy()

                    # РћРїСЂРµРґРµР»СЏРµРј РІСЂРµРјРµРЅРЅСѓСЋ РєРѕР»РѕРЅРєСѓ
                    date_col = None
                    for r in regularity_results_local:
                        if 'Р’СЂРµРјРµРЅРЅР°СЏ РєРѕР»РѕРЅРєР°' in r:
                            date_col = r['Р’СЂРµРјРµРЅРЅР°СЏ РєРѕР»РѕРЅРєР°']
                            break

                    if date_col and date_col in df_preview.columns:
                        # РћРїСЂРµРґРµР»СЏРµРј С‡Р°СЃС‚РѕС‚Сѓ
                        freq = regularity_freq_info.get('inferred_freq', 'D')
                        if not freq:
                            freq = 'D'  # Default to daily

                        num_cols = df_preview.select_dtypes(include=['number']).columns.tolist()

                        if "Interpolate" in strategy:
                            # Resample + Interpolate
                            if len(num_cols) > 0:
                                df_preview = df_preview.set_index(date_col)
                                for col in num_cols:
                                    df_preview[col] = df_preview[col].resample(freq).interpolate(method='linear')
                                df_preview = df_preview.reset_index()
                            note = "(resample + interpolate)"

                        elif "Forward Fill" in strategy:
                            # Resample + FFill
                            if len(num_cols) > 0:
                                df_preview = df_preview.set_index(date_col)
                                for col in num_cols:
                                    df_preview[col] = df_preview[col].resample(freq).ffill()
                                df_preview = df_preview.reset_index()
                            note = "(resample + ffill)"

                        elif "Backward Fill" in strategy:
                            # Resample + BFill
                            if len(num_cols) > 0:
                                df_preview = df_preview.set_index(date_col)
                                for col in num_cols:
                                    df_preview[col] = df_preview[col].resample(freq).bfill()
                                df_preview = df_preview.reset_index()
                            note = "(resample + bfill)"

                        elif "AsFreq" in strategy:
                            # AsFreq (РїСЂРѕСЃС‚Рѕ РѕР±РѕР·РЅР°С‡РёС‚СЊ РїСЂРѕРїСѓСЃРєРё)
                            if len(num_cols) > 0:
                                df_preview = df_preview.set_index(date_col)
                                for col in num_cols:
                                    df_preview[col] = df_preview[col].resample(freq).asfreq()
                                df_preview = df_preview.reset_index()
                            note = "(asfreq, NaN РІ РїСЂРѕРїСѓСЃРєР°С…)"

                        elif "С„РёРєС‚РёРІРЅС‹Рµ" in strategy:
                            # Р”РѕР±Р°РІРёС‚СЊ С„РёРєС‚РёРІРЅС‹Рµ Р·Р°РїРёСЃРё
                            df_preview = df_preview.set_index(date_col)
                            full_range = pd.date_range(start=df_preview.index.min(),
                                                      end=df_preview.index.max(),
                                                      freq=freq)
                            df_preview = df_preview.reindex(full_range)
                            df_preview = df_preview.reset_index()
                            df_preview = df_preview.rename(columns={'index': date_col})
                            note = "(РґРѕР±Р°РІР»РµРЅС‹ С„РёРєС‚РёРІРЅС‹Рµ Р·Р°РїРёСЃРё)"
                        else:
                            note = "(Р±РµР· РёР·РјРµРЅРµРЅРёР№)"

                        # РњРµС‚СЂРёРєРё
                        c_p1, c_p2, c_p3, c_p4 = st.columns(4)
                        c_p1.metric("рџ“Љ Р—Р°РїРёСЃРµР№", f"{len(df_work)} в†’ {len(df_preview)}",
                                   delta=f"{len(df_preview)-len(df_work):+}")

                        if num_cols:
                            col = num_cols[0]
                            def safe_stat(d, c, f):
                                if c not in d.columns or d.empty or d[c].notna().sum() == 0:
                                    return 0.0
                                return f(d[c].dropna())

                            m_b, s_b, d_b = safe_stat(df_work, col, np.mean), safe_stat(df_work, col, np.std), safe_stat(df_work, col, np.median)
                            m_a, s_a, d_a = safe_stat(df_preview, col, np.mean), safe_stat(df_preview, col, np.std), safe_stat(df_preview, col, np.median)

                            fmt = lambda x: f"{x:.2f}" if pd.notnull(x) and x != 0.0 else "N/A"
                            delta = lambda b, a: f"{((a-b)/abs(b)*100):+.1f}%" if b != 0 and pd.notnull(b) else "0%"

                            c_p2.metric("рџ“€ Mean", f"{fmt(m_b)} в†’ {fmt(m_a)}", delta=delta(m_b, m_a))
                            c_p3.metric("рџ“‰ Std", f"{fmt(s_b)} в†’ {fmt(s_a)}", delta=delta(s_b, s_a))
                            c_p4.metric("рџ“Љ Median", f"{fmt(d_b)} в†’ {fmt(d_a)}", delta=delta(d_b, d_a))

                        st.caption(f"рџ“… Р§Р°СЃС‚РѕС‚Р°: {freq} | РЎС‚СЂР°С‚РµРіРёСЏ: {note}")

                        # РљРЅРѕРїРєРё РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ
                        st.divider()
                        c_ok, c_cancel = st.columns(2)
                        with c_ok:
                            if st.button("рџ’ѕ РџРѕРґС‚РІРµСЂРґРёС‚СЊ РёР·РјРµРЅРµРЅРёСЏ", type="primary", use_container_width=True, key="btn_confirm_regularity"):
                                st.session_state.df_after_fixes = df_preview.copy()
                                st.session_state.df = df_preview
                                st.session_state.validation_ready = False
                                st.session_state.show_regularity_preview = False
                                st.success("вњ… РЎС‚СЂР°С‚РµРіРёСЏ РїСЂРёРјРµРЅРµРЅР°! РџРµСЂРµР·Р°РїСѓСЃС‚РёС‚Рµ РІР°Р»РёРґР°С†РёСЋ.")
                                st.rerun()
                        with c_cancel:
                            if st.button("вќЊ РћС‚РјРµРЅР°", use_container_width=True, key="btn_cancel_regularity"):
                                st.session_state.show_regularity_preview = False
                                st.rerun()
                    else:
                        st.error("вќЊ РќРµ РЅР°Р№РґРµРЅР° РІСЂРµРјРµРЅРЅР°СЏ РєРѕР»РѕРЅРєР° РґР»СЏ РїСЂРёРјРµРЅРµРЅРёСЏ СЃС‚СЂР°С‚РµРіРёРё")

        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
        # 10. РџР РћР’Р•Р РљРђ Р”РћРЎРўРђРўРћР§РќРћРЎРўР Р§РРЎР›Рђ РќРђР‘Р›Р®Р”Р•РќРР™ (sufficiency)
        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ

        sufficiency_results_local = locals().get('sufficiency_results', [])
        sufficiency_recommendations = locals().get('sufficiency_recommendations', {})

        sufficiency_issues = len([r for r in sufficiency_results_local if r.get('РќР°СЂСѓС€РµРЅРёР№', 0) > 0]) > 0
        sufficiency_groups_with_issues = len([r for r in sufficiency_results_local if r.get('РќР°СЂСѓС€РµРЅРёР№', 0) > 0])

        make_card(" РџСЂРѕРІРµСЂРєР° РґРѕСЃС‚Р°С‚РѕС‡РЅРѕСЃС‚Рё С‡РёСЃР»Р° РЅР°Р±Р»СЋРґРµРЅРёР№ (sufficiency)", sufficiency_issues,
            "**в—»пёЏ РњРµС‚СЂРёРєРё:** `n_total` (С‡РёСЃР»Рѕ РЅР°Р±Р»СЋРґРµРЅРёР№), `n_seasons` (РїРѕР»РЅС‹С… СЃРµР·РѕРЅРѕРІ), `frequency` (С‡Р°СЃС‚РѕС‚Р°).  \n"
            "**в—»пёЏ РђР»РіРѕСЂРёС‚Рј:** РЎСЂР°РІРЅРµРЅРёРµ СЃ РїРѕСЂРѕРіР°РјРё РґР»СЏ С‚СЂРµРЅРґР° (в‰Ґ10), ARIMA (в‰Ґ50), FFT (в‰Ґ64), ML (в‰Ґ100), СЃРµР·РѕРЅРЅРѕСЃС‚Рё (в‰Ґ2 РїРѕР»РЅС‹С… СЃРµР·РѕРЅР°).  \n"
            "**в—»пёЏ Р’Р»РёСЏРЅРёРµ РЅР° TS:** РќРµРґРѕСЃС‚Р°С‚РѕС‡РЅС‹Р№ РѕР±СЉС‘Рј РґР°РЅРЅС‹С… РїСЂРёРІРѕРґРёС‚ Рє РїРµСЂРµРѕР±СѓС‡РµРЅРёСЋ, РЅРµСЃС‚Р°Р±РёР»СЊРЅС‹Рј РѕС†РµРЅРєР°Рј РїР°СЂР°РјРµС‚СЂРѕРІ, РЅРµРІРѕР·РјРѕР¶РЅРѕСЃС‚Рё РІС‹РґРµР»РёС‚СЊ СЃРµР·РѕРЅРЅРѕСЃС‚СЊ.  \n"
            "**в—»пёЏ РћРїРёСЃР°РЅРёРµ:** РњРѕРґСѓР»СЊ РѕС†РµРЅРёРІР°РµС‚, С…РІР°С‚Р°РµС‚ Р»Рё РґР°РЅРЅС‹С… РґР»СЏ РїСЂРёРјРµРЅРµРЅРёСЏ СЂР°Р·Р»РёС‡РЅС‹С… TS-РјРѕРґРµР»РµР№. РџСЂРѕРІРµСЂСЏРµС‚ РєР°Рє РѕР±С‰РµРµ С‡РёСЃР»Рѕ РЅР°Р±Р»СЋРґРµРЅРёР№, "
            "С‚Р°Рє Рё РєРѕР»РёС‡РµСЃС‚РІРѕ РїРѕР»РЅС‹С… СЃРµР·РѕРЅРЅС‹С… С†РёРєР»РѕРІ. Р”Р»СЏ РїР°РЅРµР»СЊРЅС‹С… РґР°РЅРЅС‹С… (СЃС‚СЂР°РЅС‹ Г— РІСЂРµРјСЏ) РїСЂРѕРІРµСЂРєР° РІС‹РїРѕР»РЅСЏРµС‚СЃСЏ РІРЅСѓС‚СЂРё РєР°Р¶РґРѕР№ РіСЂСѓРїРїС‹. "
            "Р РµР·СѓР»СЊС‚Р°С‚ вЂ” СЃРїРёСЃРѕРє РґРѕСЃС‚СѓРїРЅС‹С… Рё РЅРµРґРѕСЃС‚СѓРїРЅС‹С… РјРѕРґРµР»РµР№ СЃ СЂРµРєРѕРјРµРЅРґР°С†РёСЏРјРё РїРѕ СЃР±РѕСЂСѓ РґРѕРїРѕР»РЅРёС‚РµР»СЊРЅС‹С… РґР°РЅРЅС‹С….",
            "вњ… Р”РѕСЃС‚Р°С‚РѕС‡РЅРѕСЃС‚СЊ РѕР±РµСЃРїРµС‡РµРЅР° РґР»СЏ РІСЃРµС… РјРѕРґРµР»РµР№" if not sufficiency_issues else f"вљ пёЏ {sufficiency_groups_with_issues} РіСЂСѓРїРї СЃ РЅРµРґРѕСЃС‚Р°С‚РѕС‡РЅС‹Рј РѕР±СЉС‘РјРѕРј РґР°РЅРЅС‹С…",
            "вњ…" if not sufficiency_issues else "вљ пёЏ", None)

        # в”Ђв”Ђ рџ”§ РРќРўР•Р РђРљРўРР’РќР«Р™ РџРђР™РџР›РђР™Рќ (СЂР°СЃРєСЂС‹РІР°РµС‚СЃСЏ РїСЂРё РїСЂРѕР±Р»РµРјР°С…) в”Ђв”Ђ
        if sufficiency_issues:
            with st.expander("рџ”§ РџРѕР»РЅС‹Р№ РїР°Р№РїР»Р°Р№РЅ Р°РЅР°Р»РёР·Р° РґРѕСЃС‚Р°С‚РѕС‡РЅРѕСЃС‚Рё", expanded=True):
                st.markdown("### рџ“‹ Р”РµС‚Р°Р»СЊРЅС‹Р№ РѕС‚С‡С‘С‚ РїРѕ РіСЂСѓРїРїР°Рј")

                # РўР°Р±Р»РёС†Р° СЃ СЂРµР·СѓР»СЊС‚Р°С‚Р°РјРё (С‚РѕР»СЊРєРѕ РґР»СЏ С‡С‚РµРЅРёСЏ, С‚.Рє. СЌС‚Рѕ Р°РЅР°Р»РёС‚РёС‡РµСЃРєР°СЏ РїСЂРѕРІРµСЂРєР°)
                results_df = pd.DataFrame(sufficiency_results_local)

                # Р¤РёР»СЊС‚СЂ: С‚РѕР»СЊРєРѕ РїСЂРѕР±Р»РµРјРЅС‹Рµ РіСЂСѓРїРїС‹
                view_filter = st.radio(
                    "Р¤РёР»СЊС‚СЂ РіСЂСѓРїРї:",
                    ["вљ пёЏ РўРѕР»СЊРєРѕ СЃ РїСЂРѕР±Р»РµРјР°РјРё", "вњ… РџРѕРєР°Р·Р°С‚СЊ РІСЃРµ"],
                    horizontal=True,
                    key="sufficiency_view_filter"
                )

                if view_filter == "вљ пёЏ РўРѕР»СЊРєРѕ СЃ РїСЂРѕР±Р»РµРјР°РјРё":
                    df_view = results_df[results_df['РќР°СЂСѓС€РµРЅРёР№'] > 0]
                else:
                    df_view = results_df

                # РћС‚РѕР±СЂР°Р¶РµРЅРёРµ С‚Р°Р±Р»РёС†С‹
                st.dataframe(
                    df_view[['РўРёРї', 'Р“СЂСѓРїРїР°', 'Р’СЃРµРіРѕ РЅР°Р±Р»СЋРґРµРЅРёР№', 'Р§Р°СЃС‚РѕС‚Р°', 'РџРѕР»РЅС‹С… СЃРµР·РѕРЅРѕРІ (Р»РµС‚)', 'РќР°СЂСѓС€РµРЅРёР№', 'РЎС‚Р°С‚СѓСЃ']],
                    use_container_width=True,
                    height=250
                )

                # Р”РµС‚Р°Р»РёР·Р°С†РёСЏ РїРѕ РєР°Р¶РґРѕР№ РїСЂРѕР±Р»РµРјРЅРѕР№ РіСЂСѓРїРїРµ
                st.markdown("### рџ”Ќ Р”РµС‚Р°Р»РёР·Р°С†РёСЏ РЅР°СЂСѓС€РµРЅРёР№")
                for r in sufficiency_results_local:
                    if r.get('РќР°СЂСѓС€РµРЅРёР№', 0) > 0:
                        with st.container(border=True):
                            st.markdown(f"** {r.get('Р“СЂСѓРїРїР°', 'Р’РµСЃСЊ РґР°С‚Р°СЃРµС‚')}** ({r.get('Р’СЃРµРіРѕ РЅР°Р±Р»СЋРґРµРЅРёР№', 0)} РЅР°Р±Р»СЋРґРµРЅРёР№)")
                            st.markdown("#### РќР°СЂСѓС€РµРЅРёСЏ:")
                            for detail in r.get('Р”РµС‚Р°Р»Рё', []):
                                st.markdown(f"- {detail}")
                            st.markdown("#### рџ’Ў Р РµРєРѕРјРµРЅРґР°С†РёРё:")
                            st.markdown(r.get('Р РµРєРѕРјРµРЅРґР°С†РёРё', 'РќРµС‚ СЂРµРєРѕРјРµРЅРґР°С†РёР№'))

                st.divider()

                # Р‘Р»РѕРє РґРѕСЃС‚СѓРїРЅС‹С… РјРѕРґРµР»РµР№
                st.markdown("### рџ¤– Р”РѕСЃС‚СѓРїРЅС‹Рµ РјРѕРґРµР»Рё РїРѕ РіСЂСѓРїРїР°Рј")

                c1, c2 = st.columns(2)
                with c1:
                    st.markdown("#### вњ… Р”РѕСЃС‚СѓРїРЅС‹Рµ РјРѕРґРµР»Рё")
                    for group_name, rec in sufficiency_recommendations.items():
                        if rec.get('available_models'):
                            st.markdown(f"**{group_name}:**")
                            for model in rec['available_models']:
                                st.markdown(f"- вњ… {model}")

                with c2:
                    st.markdown("#### в›” РќРµРґРѕСЃС‚СѓРїРЅС‹Рµ РјРѕРґРµР»Рё")
                    for group_name, rec in sufficiency_recommendations.items():
                        if rec.get('unavailable_models'):
                            st.markdown(f"**{group_name}:**")
                            for model in rec['unavailable_models']:
                                st.markdown(f"- в›” {model}")

                st.divider()

                # РЎС‚СЂР°С‚РµРіРёРё РґРµР№СЃС‚РІРёР№
                st.markdown("### рџ§№ РЎС‚СЂР°С‚РµРіРёРё СЂРµС€РµРЅРёСЏ РїСЂРѕР±Р»РµРјС‹ РЅРµРґРѕСЃС‚Р°С‚РѕС‡РЅРѕСЃС‚Рё РґР°РЅРЅС‹С…")
                c1, c2 = st.columns([2, 1])
                with c1:
                    sufficiency_strategy = st.radio(
                        "Р’С‹Р±РµСЂРёС‚Рµ СЃС‚СЂР°С‚РµРіРёСЋ:",
                        ["РџСЂРѕРґРѕР»Р¶РёС‚СЊ Р°РЅР°Р»РёР· СЃ РґРѕСЃС‚СѓРїРЅС‹РјРё РјРѕРґРµР»СЏРјРё (СЂРµРєРѕРјРµРЅРґСѓРµС‚СЃСЏ)",
                        "РђРіСЂРµРіРёСЂРѕРІР°С‚СЊ РґР°РЅРЅС‹Рµ РїРѕ Р±РѕР»РµРµ РєСЂСѓРїРЅС‹Рј РїРµСЂРёРѕРґР°Рј (РЅР°РїСЂРёРјРµСЂ, РјРµСЃСЏС† в†’ РєРІР°СЂС‚Р°Р»)",
                        "РСЃРєР»СЋС‡РёС‚СЊ РіСЂСѓРїРїС‹ СЃ РЅРµРґРѕСЃС‚Р°С‚РѕС‡РЅС‹Рј РѕР±СЉС‘РјРѕРј РґР°РЅРЅС‹С…",
                        "Р”РѕР±Р°РІРёС‚СЊ СЃРёРЅС‚РµС‚РёС‡РµСЃРєРёРµ РґР°РЅРЅС‹Рµ (bootstrap/augmentation)",
                        "РўРѕР»СЊРєРѕ РѕС‚РјРµС‚РёС‚СЊ РІ РѕС‚С‡С‘С‚Рµ (Р±РµР· РёР·РјРµРЅРµРЅРёР№)"],
                        key="sufficiency_fill_strategy"
                    )
                    if "РџСЂРѕРґРѕР»Р¶РёС‚СЊ" in sufficiency_strategy:
                        st.info("в„№пёЏ РџР»Р°С‚С„РѕСЂРјР° Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРё РѕРіСЂР°РЅРёС‡РёС‚ РІС‹Р±РѕСЂ РјРѕРґРµР»РµР№ С‚РѕР»СЊРєРѕ РґРѕСЃС‚СѓРїРЅС‹РјРё.")
                    elif "РђРіСЂРµРіРёСЂРѕРІР°С‚СЊ" in sufficiency_strategy:
                        st.warning("вљ пёЏ Р”Р°РЅРЅС‹Рµ Р±СѓРґСѓС‚ Р°РіСЂРµРіРёСЂРѕРІР°РЅС‹ (mean/sum), С‡С‚Рѕ СЃРЅРёР·РёС‚ РґРµС‚Р°Р»РёР·Р°С†РёСЋ, РЅРѕ СѓРІРµР»РёС‡РёС‚ n.")
                    elif "РСЃРєР»СЋС‡РёС‚СЊ" in sufficiency_strategy:
                        st.warning(f"вљ пёЏ Р‘СѓРґРµС‚ СѓРґР°Р»РµРЅРѕ **{sufficiency_groups_with_issues} РіСЂСѓРїРї** СЃ РЅРµРґРѕСЃС‚Р°С‚РѕС‡РЅС‹Рј РѕР±СЉС‘РјРѕРј.")
                    elif "СЃРёРЅС‚РµС‚РёС‡РµСЃРєРёРµ" in sufficiency_strategy:
                        st.warning("вљ пёЏ РЎРёРЅС‚РµС‚РёС‡РµСЃРєРёРµ РґР°РЅРЅС‹Рµ РјРѕРіСѓС‚ РёСЃРєР°Р·РёС‚СЊ СЂРµР°Р»СЊРЅС‹Рµ Р·Р°РєРѕРЅРѕРјРµСЂРЅРѕСЃС‚Рё.")
                with c2:
                    st.markdown("<div style='margin-top: 28px;'></div>", unsafe_allow_html=True)

                # РљРЅРѕРїРєР° РїСЂРёРјРµРЅРµРЅРёСЏ СЃС‚СЂР°С‚РµРіРёРё
                st.markdown("<div style='margin: 15px 0;'></div>", unsafe_allow_html=True)
                if st.button("рџ“Љ РџСЂРёРјРµРЅРёС‚СЊ РІС‹Р±СЂР°РЅРЅСѓСЋ СЃС‚СЂР°С‚РµРіРёСЋ", type="primary", use_container_width=True, key="btn_apply_sufficiency"):
                    strategy = sufficiency_strategy

                    if "РђРіСЂРµРіРёСЂРѕРІР°С‚СЊ" in strategy:
                        # РћРїСЂРµРґРµР»СЏРµРј РІСЂРµРјРµРЅРЅСѓСЋ РєРѕР»РѕРЅРєСѓ
                        date_col = None
                        for r in sufficiency_results_local:
                            if 'РўРёРї' in r and 'Р“СЂСѓРїРїР°' in r:
                                # РС‰РµРј РєРѕР»РѕРЅРєСѓ СЃ РґР°С‚Р°РјРё
                                for col in df.columns:
                                    if 'year' in col.lower() or 'date' in col.lower():
                                        date_col = col
                                        break
                                break

                        if date_col:
                            df_aggregated = df.copy()
                            # РђРіСЂРµРіР°С†РёСЏ РїРѕ РіРѕРґСѓ (СѓРїСЂРѕС‰С‘РЅРЅС‹Р№ РІР°СЂРёР°РЅС‚)
                            if pd.api.types.is_datetime64_any_dtype(df_aggregated[date_col]):
                                df_aggregated['_year'] = df_aggregated[date_col].dt.year
                            else:
                                df_aggregated['_year'] = df_aggregated[date_col]

                            num_cols = df_aggregated.select_dtypes(include='number').columns.tolist()
                            group_cols = [c for c in df_aggregated.columns if c != date_col and c != '_year' and df_aggregated[c].dtype == 'object']

                            if group_cols:
                                agg_dict = {col: 'mean' for col in num_cols if col in df_aggregated.columns}
                                df_aggregated = df_aggregated.groupby(group_cols + ['_year']).agg(agg_dict).reset_index()
                            else:
