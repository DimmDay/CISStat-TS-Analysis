                        })

                        # в”Ђв”Ђ 2. РђРІС‚РѕРєРѕСЂСЂРµР»СЏС†РёСЏ (Ljung-Box) в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                        from statsmodels.stats.diagnostic import acorr_ljungbox
                        lb_res = acorr_ljungbox(analysis_series, lags=[10])
                        if isinstance(lb_res, pd.DataFrame):
