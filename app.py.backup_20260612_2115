        c1.metric("Р’СЃРµРіРѕ СЃС‚СЂРѕРє", f"{len(df):,}".replace(",", " "))
        c2.metric("Р’СЃРµРіРѕ РєРѕР»РѕРЅРѕРє", len(df.columns))
        c3.metric("РџР°РјСЏС‚СЊ", f"{df.memory_usage(deep=True).sum() / 1024**2:.2f} MB")
        c4.metric("Р§РёСЃР»РѕРІС‹С… / РўРµРєСЃС‚РѕРІС‹С…", f"{len(ct['num'])} / {len(ct['cat'])}")

