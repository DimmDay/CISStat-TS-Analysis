                        except Exception as e:
                            st.warning(f"вљ пёЏ РќРµ СѓРґР°Р»РѕСЃСЊ РїРѕРєР°Р·Р°С‚СЊ РїСЂРёРјРµСЂС‹: `{e}`")

                    st.divider()

            # в”Ђв”Ђ рџ§№ РЎРўР РђРўР•Р“РР РћР‘Р РђР‘РћРўРљР РќРђР РЈРЁР•РќРР™ в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
            with st.expander("рџ§№ РЎС‚СЂР°С‚РµРіРёРё РѕР±СЂР°Р±РѕС‚РєРё РЅР°СЂСѓС€РµРЅРёР№ С„РѕСЂРјР°С‚РѕРІ", expanded=True):
                # Р’С‹Р±РѕСЂ СЃС‚СЂР°С‚РµРіРёРё
                strategy = st.radio(
                    "Р’С‹Р±РµСЂРёС‚Рµ РґРµР№СЃС‚РІРёРµ:",
                    [
                        "Р—Р°РјРµРЅРёС‚СЊ РЅР° NaN (СѓРґР°Р»РёС‚СЊ Р·РЅР°С‡РµРЅРёСЏ)",
                        "Р—Р°РјРµРЅРёС‚СЊ РЅР° С€Р°Р±Р»РѕРЅРЅРѕРµ Р·РЅР°С‡РµРЅРёРµ (СѓРјРЅРѕРµ)",
                        "РџСЂРёРјРµРЅРёС‚СЊ regex-Р·Р°РјРµРЅСѓ (РЅРѕСЂРјР°Р»РёР·Р°С†РёСЏ)",
                        "РўРѕР»СЊРєРѕ РѕС‚РјРµС‚РёС‚СЊ С„Р»Р°РіРѕРј (РЅРµ РјРµРЅСЏС‚СЊ РґР°РЅРЅС‹Рµ)"
                    ],
                    key="format_fix_strategy",
                    horizontal=False
                )

                # Р”РёРЅР°РјРёС‡РµСЃРєРёРµ РїРѕРґСЃРєР°Р·РєРё
                if "NaN" in strategy:
                    st.warning("вљ пёЏ РќР°СЂСѓС€Р°СЋС‰РёРµ Р·РЅР°С‡РµРЅРёСЏ Р±СѓРґСѓС‚ Р·Р°РјРµРЅРµРЅС‹ РЅР° `NaN` (РїСЂРѕРїСѓС‰РµРЅРЅС‹Рµ)")
                elif "С€Р°Р±Р»РѕРЅРЅРѕРµ" in strategy:
                    st.info("рџ”„ **РЈРјРЅР°СЏ Р·Р°РјРµРЅР°:** email в†’ `unknown@example.com`, С‚РµР»РµС„РѕРЅ в†’ `+0000000000`, РѕСЃС‚Р°Р»СЊРЅРѕРµ в†’ `N/A`")
                elif "regex-Р·Р°РјРµРЅСѓ" in strategy:
                    st.info("вњЏпёЏ **РќРѕСЂРјР°Р»РёР·Р°С†РёСЏ:** `strip()` + `lower()` + СѓРґР°Р»РµРЅРёРµ СЃРїРµС†СЃРёРјРІРѕР»РѕРІ")
                elif "С„Р»Р°РіРѕРј" in strategy:
                    st.info("рџљ© Р‘СѓРґРµС‚ РґРѕР±Р°РІР»РµРЅР° РєРѕР»РѕРЅРєР° `{РёРјСЏ}_format_valid` СЃ True/False")

                # РљРЅРѕРїРєР° РїСЂРёРјРµРЅРµРЅРёСЏ СЃС‚СЂР°С‚РµРіРёРё
                if st.button("рџ’ѕ РџСЂРёРјРµРЅРёС‚СЊ СЃС‚СЂР°С‚РµРіРёСЋ Рє РґР°РЅРЅС‹Рј", type="primary", key="btn_apply_format_fix"):
                    try:
                        import numpy as np
                        df_work = st.session_state.df_pattern_work.copy()
                        cols_fixed = 0

                        for v in real_violations:
                            col_name = v.get("РљРѕР»РѕРЅРєР°")
                            pattern = v.get("pattern", ".*")

                            if not col_name or col_name not in df_work.columns:
                                continue

                            # РЎРѕР·РґР°С‘Рј РјР°СЃРєСѓ РЅР°СЂСѓС€РµРЅРёР№ РґР»СЏ С‚РµРєСѓС‰РµР№ РєРѕР»РѕРЅРєРё
                            mask_invalid = ~df_work[col_name].astype(str).str.fullmatch(pattern, na=False)
                            count_invalid = mask_invalid.sum()

                            if count_invalid == 0:
                                continue

                            # в”Ђв”Ђ РџР РРњР•РќР•РќРР• РЎРўР РђРўР•Р“РР в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                            if "Р—Р°РјРµРЅРёС‚СЊ РЅР° NaN" in strategy:
                                df_work.loc[mask_invalid, col_name] = np.nan
                                st.success(f"вњ… `{col_name}`: **{count_invalid}** Р·РЅР°С‡РµРЅРёР№ в†’ `NaN`")

                            elif "С€Р°Р±Р»РѕРЅРЅРѕРµ Р·РЅР°С‡РµРЅРёРµ" in strategy:
                                col_lower = col_name.lower()
                                # РЈРјРЅР°СЏ Р·Р°РјРµРЅР° РІ Р·Р°РІРёСЃРёРјРѕСЃС‚Рё РѕС‚ С‚РёРїР° РєРѕР»РѕРЅРєРё
                                if "email" in col_lower:
                                    replacement = "unknown@example.com"
                                elif "phone" in col_lower or "С‚РµР»РµС„РѕРЅ" in col_lower or "tel" in col_lower:
                                    replacement = "+0000000000"
                                elif "date" in col_lower or "РґР°С‚Р°" in col_lower:
                                    replacement = pd.NaT
                                elif df_work[col_name].dtype in ["int64", "float64"]:
                                    replacement = df_work[col_name].median()
                                else:
                                    replacement = "N/A"
                                df_work.loc[mask_invalid, col_name] = replacement
                                st.success(f"вњ… `{col_name}`: **{count_invalid}** Р·РЅР°С‡РµРЅРёР№ в†’ `{replacement}`")

                            elif "regex-Р·Р°РјРµРЅСѓ" in strategy:
                                # РќРѕСЂРјР°Р»РёР·Р°С†РёСЏ РўРћР›Р¬РљРћ РґР»СЏ РЅР°СЂСѓС€РёС‚РµР»РµР№
                                invalid_mask = mask_invalid & df_work[col_name].notna()
                                if invalid_mask.any():
                                    df_work.loc[invalid_mask, col_name] = (
                                        df_work.loc[invalid_mask, col_name]
                                        .astype(str)
                                        .str.strip()                    # РЈР±СЂР°С‚СЊ РїСЂРѕР±РµР»С‹
                                        .str.lower()                    # РќРёР¶РЅРёР№ СЂРµРіРёСЃС‚СЂ
                                        .str.replace(r"[^\w\s@.\-]", "", regex=True)  # РЈР±СЂР°С‚СЊ СЃРїРµС†СЃРёРјРІРѕР»С‹
                                        .str.replace(r"\s+", " ", regex=True)         # РЈР±СЂР°С‚СЊ РјРЅРѕР¶. РїСЂРѕР±РµР»С‹
                                    )
                                    st.success(f"вњ… `{col_name}`: РЅРѕСЂРјР°Р»РёР·РѕРІР°РЅРѕ **{invalid_mask.sum()}** Р·РЅР°С‡РµРЅРёР№")

                            elif "С„Р»Р°РіРѕРј" in strategy:
                                # Р”РѕР±Р°РІРёС‚СЊ РєРѕР»РѕРЅРєСѓ-РёРЅРґРёРєР°С‚РѕСЂ
                                flag_col = f"{col_name}_format_valid"
                                df_work[flag_col] = ~mask_invalid
                                st.success(f"вњ… `{col_name}`: РґРѕР±Р°РІР»РµРЅ С„Р»Р°Рі `{flag_col}`")

                            cols_fixed += 1

                        # Р“Р›РђР’РќРћР•: РЎРѕС…СЂР°РЅСЏРµРј РёР·РјРµРЅРµРЅРёСЏ РІ session_state
                        st.session_state.df_pattern_work = df_work
                        st.session_state.df = df_work  # РЎРёРЅС…СЂРѕРЅРёР·Р°С†РёСЏ СЃ РѕСЃРЅРѕРІРЅС‹Рј РґР°С‚Р°С„СЂРµР№РјРѕРј!
                        st.session_state.validation_ready = False  # РЎР±СЂРѕСЃ РІР°Р»РёРґР°С†РёРё
                        st.session_state.pattern_results = []  # РЎР±СЂРѕСЃ СЃС‚Р°СЂС‹С… СЂРµР·СѓР»СЊС‚Р°С‚РѕРІ С„РѕСЂРјР°С‚РѕРІ

                        st.divider()
                        st.success(f"вњ… **РЎС‚СЂР°С‚РµРіРёСЏ РїСЂРёРјРµРЅРµРЅР°!** РћР±СЂР°Р±РѕС‚Р°РЅРѕ РєРѕР»РѕРЅРѕРє: **{cols_fixed}**")
                        st.info("рџ”„ **РЎР»РµРґСѓСЋС‰РёР№ С€Р°Рі:** РќР°Р¶РјРёС‚Рµ **Р—Р°РїСѓСЃС‚РёС‚СЊ РІР°Р»РёРґР°С†РёСЋ** СЃРІРµСЂС…Сѓ РґР»СЏ РїСЂРѕРІРµСЂРєРё СЂРµР·СѓР»СЊС‚Р°С‚Р°")

                        # РљРЅРѕРїРєР° Р±С‹СЃС‚СЂРѕРіРѕ РїРµСЂРµР·Р°РїСѓСЃРєР°
                        if st.button("рџ”„ РџРµСЂРµР·Р°РїСѓСЃС‚РёС‚СЊ РІР°Р»РёРґР°С†РёСЋ СЃРµР№С‡Р°СЃ", type="secondary", key="btn_rerun_validation_fmt"):
                            st.rerun()

                    except Exception as e:
                        st.error(f"вќЊ РћС€РёР±РєР° РїСЂРё РїСЂРёРјРµРЅРµРЅРёРё СЃС‚СЂР°С‚РµРіРёРё: `{e}`")
                        import traceback
                        with st.expander("рџ”Ќ Stack trace (РґР»СЏ СЂР°Р·СЂР°Р±РѕС‚С‡РёРєР°)"):
                            st.code(traceback.format_exc(), language="python")

                # в”Ђв”Ђ  Р­РљРЎРџРћР Рў Р Р•Р—РЈР›Р¬РўРђРўРђ в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
                st.divider()
                st.download_button(
                    label="рџ’ѕ РЎРєР°С‡Р°С‚СЊ СЂРµР·СѓР»СЊС‚Р°С‚ (РѕС‡РёС‰РµРЅРЅС‹Рµ РґР°РЅРЅС‹Рµ, CSV)",
                    data=df_work.to_csv(index=False, encoding="utf-8-sig"),
                    file_name=f"format_fixed_{st.session_state.get('original_filename', 'data').rsplit('.', 1)[0]}.csv",
                    mime="text/csv",
                    type="secondary",
                    key="btn_export_format_fixed"
                )

        # ======================================================================================
        # в”Ђв”Ђ 3. РџР РћР’Р•Р РљРђ Р”РРђРџРђР—РћРќРћР’ Р—РќРђР§Р•РќРР™ (СЃ РёРЅС‚РµСЂР°РєС‚РёРІРЅС‹Рј РїР°Р№РїР»Р°Р№РЅРѕРј + РєРЅРѕРїРєР° СЃРѕС…СЂР°РЅРµРЅРёСЏ) в”Ђв”Ђ

        # 1. Р—Р°РіСЂСѓР·РєР° РїСЂР°РІРёР» РґРёР°РїР°Р·РѕРЅРѕРІ РёР· YAML
        range_rules_config = rules.get("ranges", [])
        range_rule_bounds = {}      # col -> (min, max)
        range_violation_masks = {}  # col -> boolean mask
        range_results = []

        num_cols = df.select_dtypes(include='number').columns.tolist()

        for col in num_cols:
            col_lower = col.lower()
            matched_rule = None

            # РС‰РµРј РїСЂР°РІРёР»Рѕ РїРѕ С‡Р°СЃС‚РёС‡РЅРѕРјСѓ СЃРѕРІРїР°РґРµРЅРёСЋ РєР»СЋС‡РµРІС‹С… СЃР»РѕРІ РёР· YAML
            for rule in range_rules_config:
                keywords = rule.get("keywords", [])
                if any(kw in col_lower for kw in keywords):
                    matched_rule = (rule.get("min"), rule.get("max"))
                    break

            if matched_rule:
                min_val, max_val = matched_rule
                range_rule_bounds[col] = (min_val, max_val)

                # РЎРѕР·РґР°РµРј РјР°СЃРєСѓ РЅР°СЂСѓС€РµРЅРёР№ РґР»СЏ РІСЃРµР№ РєРѕР»РѕРЅРєРё
                mask = pd.Series(False, index=df.index)
                if min_val is not None: mask |= (df[col] < min_val)
                if max_val is not None: mask |= (df[col] > max_val)

                if mask.any():
                    range_violation_masks[col] = mask
                    violations = mask.sum()
                    range_results.append({
                        "РљРѕР»РѕРЅРєР°": col,
                        "РџСЂР°РІРёР»Рѕ": f"{min_val if min_val is not None else '-в€ћ'} < x < {max_val if max_val is not None else 'в€ћ'}",
                        "РќР°СЂСѓС€РµРЅРёР№": int(violations),
                        "% Р±СЂР°РєР°": f"{(violations / len(df) * 100):.2f}%",
                        "Min С„Р°РєС‚": df[col].min(),
                        "Max С„Р°РєС‚": df[col].max()
                    })

        range_issues = len(range_results) > 0
        range_violations = sum(r.get('РќР°СЂСѓС€РµРЅРёР№', 0) for r in range_results)

        # 3. РљР°СЂС‚РѕС‡РєР°-СЂРµР·СЋРјРµ (Р›Р°РєРѕРЅРёС‡РЅР°СЏ РІРµСЂСЃРёСЏ)
        make_card(
            " РџСЂРѕРІРµСЂРєР° РґРёР°РїР°Р·РѕРЅРѕРІ Р·РЅР°С‡РµРЅРёР№ (value ranges)",
            has_issues=range_issues,
            methodology="**в—»пёЏ РњРµС‚СЂРёРєРё:** Р”РѕР»СЏ Р·РЅР°С‡РµРЅРёР№ РІРЅРµ РіСЂР°РЅРёС† `% invalid`, С„Р°РєС‚РёС‡РµСЃРєРёРµ `min/max`.  \n"
            "**в—»пёЏ РђР»РіРѕСЂРёС‚Рј:** Р’РµРєС‚РѕСЂРЅС‹Рµ РјР°СЃРєРё `(df[col] < min) | (df[col] > max)` в†’ Р°РіСЂРµРіР°С†РёСЏ РЅР°СЂСѓС€РµРЅРёР№.  \n"
            "**в—»пёЏ Р’Р»РёСЏРЅРёРµ РЅР° TS:** РћС‚СЂРёС†Р°С‚РµР»СЊРЅС‹Рµ С†РµРЅС‹ Р»РѕРјР°СЋС‚ `log()`, РїСЂРѕС†РµРЅС‚С‹ >100 РёСЃРєР°Р¶Р°СЋС‚ РЅРѕСЂРјР°Р»РёР·Р°С†РёСЋ.  \n"
            "**в—»пёЏ РћРїРёСЃР°РЅРёРµ:** РњРѕРґСѓР»СЊ Р°РЅР°Р»РёР·РёСЂСѓРµС‚ С‡РёСЃР»РѕРІС‹Рµ СЃС‚РѕР»Р±С†С‹ РЅР° СЃРѕРѕС‚РІРµС‚СЃС‚РІРёРµ РіСЂР°РЅРёС†Р°Рј РґРѕРїСѓСЃС‚РёРјС‹С… Р·РЅР°С‡РµРЅРёР№ (РЅР°РїСЂРёРјРµСЂ, РґР»СЏ С†РµРЅ, РІРѕР·СЂР°СЃС‚Р° Рё РѕР±СЉРµРјРѕРІ < 0 РёР»Рё РїСЂРѕС†РµРЅС‚РѕРІ > 100), Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРё РѕРїСЂРµРґРµР»СЏСЏ РїСЂРёРјРµРЅРёРјС‹Рµ РїСЂР°РІРёР»Р° РїРѕ РєР»СЋС‡РµРІС‹Рј СЃР»РѕРІР°Рј РІ РЅР°Р·РІР°РЅРёСЏС… РєРѕР»РѕРЅРѕРє. " \
            "Р—РЅР°С‡РµРЅРёСЏ, РЅР°СЂСѓС€Р°СЋС‰РёРµ СѓСЃС‚Р°РЅРѕРІР»РµРЅРЅС‹Рµ РїСЂРµРґРµР»С‹, Р·Р°С„РёРєСЃРёСЂСѓСЋС‚СЃСЏ Рё Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРё СЂР°СЃРєСЂРѕРµС‚СЃСЏ СЃРµРєС†РёСЏ РґР»СЏ РёС… РґР°Р»СЊРЅРµР№С€РµРіРѕ РёСЃРїСЂР°РІР»РµРЅРёСЏ РёР»Рё СѓРґР°Р»РµРЅРёСЏ.",
            result_text="вњ… Р’СЃРµ Р·РЅР°С‡РµРЅРёСЏ РІ РґРѕРїСѓСЃС‚РёРјС‹С… РґРёР°РїР°Р·РѕРЅР°С…" if not range_issues else f"вљ пёЏ РќР°Р№РґРµРЅРѕ {range_violations} РЅР°СЂСѓС€РµРЅРёР№ РІ {len(range_results)} РєРѕР»РѕРЅРєР°С…",
            result_status="вњ…" if not range_issues else "вљ пёЏ",
            fix_action=None
        )

        # 4. рџ”Ѕ РРќРўР•Р РђРљРўРР’РќР«Р™ РџРђР™РџР›РђР™Рќ РћР‘Р РђР‘РћРўРљР (СЂР°СЃРєСЂС‹РІР°РµС‚СЃСЏ РїСЂРё РїСЂРѕР±Р»РµРјР°С…)
        if range_issues:
            with st.expander("РџРѕР»РЅС‹Р№ РїР°Р№РїР»Р°Р№РЅ РѕР±СЂР°Р±РѕС‚РєРё РЅР°СЂСѓС€РµРЅРёР№ РґРёР°РїР°Р·РѕРЅРѕРІ", expanded=True):
                st.markdown("###  РўР°Р±Р»РёС†Р° РЅР°СЂСѓС€РµРЅРёР№ СЃ СЂСѓС‡РЅРѕР№ РєРѕСЂСЂРµРєС‚РёСЂРѕРІРєРѕР№")

                # РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ СЃРѕСЃС‚РѕСЏРЅРёР№
                if "df_range_work" not in st.session_state:
                    st.session_state.df_range_work = df.copy()

                df_work = st.session_state.df_range_work

                # Р¤РѕСЂРјРёСЂСѓРµРј РѕР±С‰СѓСЋ РјР°СЃРєСѓ РЅР°СЂСѓС€РµРЅРёР№
                combined_mask = pd.Series(False, index=df_work.index)
                for mask in range_violation_masks.values():
                    combined_mask |= mask

                # Р¤РёР»СЊС‚СЂ РѕС‚РѕР±СЂР°Р¶РµРЅРёСЏ (Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРёР№, РєР°Рє РІ РґСЂСѓРіРёС… Р±Р»РѕРєР°С…)
                view_filter = st.radio(
                    "Р¤РёР»СЊС‚СЂ СЃС‚СЂРѕРє:",
                    ["вљ пёЏ РўРѕР»СЊРєРѕ СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё", "вњ… РџРѕРєР°Р·Р°С‚СЊ РІСЃС‘"],
                    horizontal=True,
                    key="range_view_filter"
                )

                if view_filter == "вљ пёЏ РўРѕР»СЊРєРѕ СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё":
                    df_view = df_work[combined_mask].copy() if combined_mask.any() else df_work.iloc[:0].copy()
                else:
                    df_view = df_work.copy()

                # Р”РѕР±Р°РІР»СЏРµРј СЃС‚Р°С‚СѓСЃ-РєРѕР»РѕРЅРєСѓ
                df_view = df_view.copy()
                df_view.insert(0, '_STATUS', df_view.index.map(lambda idx: "рџ”ґ РќР°СЂСѓС€РµРЅРёРµ" if combined_mask.loc[idx] else "рџџў РќРѕСЂРјР°"))

                # РРЅС‚РµСЂР°РєС‚РёРІРЅР°СЏ С‚Р°Р±Р»РёС†Р° (Р СѓС‡РЅР°СЏ РїСЂР°РІРєР°)
                edited_df = st.data_editor(
                    df_view,
                    use_container_width=True,
                    height=300,  # Р¤РёРєСЃРёСЂРѕРІР°РЅРЅР°СЏ РІС‹СЃРѕС‚Р° РґР»СЏ СЃС‚Р°Р±РёР»СЊРЅРѕСЃС‚Рё
                    num_rows="dynamic",
                    disabled=['_STATUS'],
                    key="range_editor",
                    column_config={
                        "_STATUS": st.column_config.TextColumn("РЎС‚Р°С‚СѓСЃ", disabled=True, width="small")
                    }
                )

                # рџ’ѕ РљРќРћРџРљРђ РЎРћРҐР РђРќР•РќРРЇ (РЈРЅРёС„РёС†РёСЂРѕРІР°РЅР° СЃ РїСЂРѕРїСѓСЃРєР°РјРё Рё РІС‹Р±СЂРѕСЃР°РјРё)
                c_save1, c_save2 = st.columns([4, 1])
                with c_save1:
                    st.caption("рџ’Ў РћС‚СЂРµРґР°РєС‚РёСЂСѓР№С‚Рµ Р·РЅР°С‡РµРЅРёСЏ РІСЂСѓС‡РЅСѓСЋ РёР»Рё РІС‹Р±РµСЂРёС‚Рµ СЃС‚СЂР°С‚РµРіРёСЋ РЅРёР¶Рµ")
                with c_save2:
                    if st.button("рџ’ѕ РЎРѕС…СЂР°РЅРёС‚СЊ", key="btn_save_manual_range", use_container_width=True):
                        if '_STATUS' in edited_df.columns:
                            edited_df = edited_df.drop(columns=['_STATUS'])
                        df_work.update(edited_df)
                        st.session_state.df_range_work = df_work
                        st.session_state.df = df_work  # РЎРёРЅС…СЂРѕРЅРёР·РёСЂСѓРµРј СЃ РѕСЃРЅРѕРІРЅС‹Рј РґР°С‚Р°СЃРµС‚РѕРј
                        st.session_state.validation_ready = False
                        st.toast("вњ… РџСЂР°РІРєРё СЃРѕС…СЂР°РЅРµРЅС‹!", icon="вњ…")
                        st.rerun()

                st.divider()

                # РџР°РЅРµР»СЊ СЃС‚СЂР°С‚РµРіРёР№ (РђРІС‚РѕРјР°С‚РёС‡РµСЃРєР°СЏ РѕР±СЂР°Р±РѕС‚РєР°)
                st.markdown("### рџ§№ РЎС‚СЂР°С‚РµРіРёРё РѕР±СЂР°Р±РѕС‚РєРё РґРёР°РїР°Р·РѕРЅРѕРІ")
                c1, c2 = st.columns([2, 1])
                with c1:
                    range_strategy = st.radio(
                        "Р’С‹Р±РµСЂРёС‚Рµ СЃС‚СЂР°С‚РµРіРёСЋ:",
                        ["РљСЌРїРёСЂРѕРІР°С‚СЊ РґРѕ РіСЂР°РЅРёС† РїСЂР°РІРёР» (min/max)",
                        "Р—Р°РјРµРЅРёС‚СЊ РЅР° РјРµРґРёР°РЅСѓ (С‡РёСЃР»РѕРІС‹Рµ) / РјРѕРґСѓ",
                        "РЈРґР°Р»РёС‚СЊ СЃС‚СЂРѕРєРё СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё",
                        "Р—Р°РјРµРЅРёС‚СЊ РЅР° 0 РёР»Рё NaN",
                        "РўРѕР»СЊРєРѕ РѕС‚РјРµС‚РёС‚СЊ С„Р»Р°РіРѕРј (РЅРµ РјРµРЅСЏС‚СЊ РґР°РЅРЅС‹Рµ)"],
                        key="range_fill_strategy"
                    )
                    if "РљСЌРїРёСЂРѕРІР°С‚СЊ" in range_strategy:
                        st.warning("вљ пёЏ Р’С‹Р±СЂРѕСЃС‹ Р±СѓРґСѓС‚ Р·Р°РјРµРЅРµРЅС‹ РЅР° РіСЂР°РЅРёС†С‹: РЅРёР¶РЅРёР№ РЅР° min, РІРµСЂС…РЅРёР№ РЅР° max")
                    elif "РјРµРґРёР°РЅСѓ" in range_strategy:
                        st.warning("вљ пёЏ Р’СЃРµ РЅР°СЂСѓС€РµРЅРёСЏ Р±СѓРґСѓС‚ Р·Р°РјРµРЅРµРЅС‹ РЅР° РјРµРґРёР°РЅСѓ.")
                    elif "РЈРґР°Р»РёС‚СЊ" in range_strategy:
                        st.warning(f"вљ пёЏ Р‘СѓРґРµС‚ СѓРґР°Р»РµРЅРѕ **{combined_mask.sum()} СЃС‚СЂРѕРє** ({combined_mask.sum()/len(df_work)*100:.1f}% РґР°РЅРЅС‹С…).")
                    elif "0пёЏвѓЈ" in range_strategy:
                        st.warning("вљ пёЏ Р’СЃРµ РЅР°СЂСѓС€РµРЅРёСЏ Р±СѓРґСѓС‚ Р·Р°РјРµРЅРµРЅС‹ РЅР° 0 РёР»Рё NaN.")
                with c2:
                    # РџСѓСЃС‚Р°СЏ РєРѕР»РѕРЅРєР° РґР»СЏ РІС‹СЂР°РІРЅРёРІР°РЅРёСЏ
                    st.markdown("<div style='margin-top: 28px;'></div>", unsafe_allow_html=True)

                # РљРЅРѕРїРєР° Р·Р°РїСѓСЃРєР° РїСЂРµРІСЊСЋ (СѓРЅРёС„РёС†РёСЂРѕРІР°РЅР°)
                if "show_range_preview" not in st.session_state:
                    st.session_state.show_range_preview = False

                st.markdown("<div style='margin: 15px 0;'></div>", unsafe_allow_html=True)
                if st.button("рџ“Љ РџРѕРєР°Р·Р°С‚СЊ РїСЂРѕРіРЅРѕР· РІР»РёСЏРЅРёСЏ РЅР° СЃС‚Р°С‚РёСЃС‚РёРєРё", type="secondary", use_container_width=True, key="btn_show_range_preview"):
                    st.session_state.show_range_preview = True
                    st.rerun()

                # Р‘Р»РѕРє РїСЂРµРІСЊСЋ
                if st.session_state.show_range_preview:
                    strategy = range_strategy
                    st.markdown("##### рџ“€ РџСЂРѕРіРЅРѕР· РІР»РёСЏРЅРёСЏ РЅР° СЃС‚Р°С‚РёСЃС‚РёРєСѓ:")

                    df_preview = df_work.copy()
                    cols_to_fix = list(range_rule_bounds.keys())

                    if "РљСЌРїРёСЂРѕРІР°С‚СЊ" in strategy:
                        for col in cols_to_fix:
                            # рџ”§ РРЎРџР РђР’Р›Р•РќРР•: РџСЂРёРІРѕРґРёРј Рє float РїРµСЂРµРґ РєР»РёРїРёСЂРѕРІР°РЅРёРµРј, С‡С‚РѕР±С‹ РёР·Р±РµР¶Р°С‚СЊ РѕС€РёР±РєРё int64
                            df_preview[col] = df_preview[col].astype(float)
                            min_v, max_v = range_rule_bounds.get(col, (None, None))
                            if min_v is not None: df_preview[col] = df_preview[col].clip(lower=min_v)
                            if max_v is not None: df_preview[col] = df_preview[col].clip(upper=max_v)
                        note = "(РєСЌРїРёСЂРѕРІР°РЅРёРµ РїРѕ РіСЂР°РЅРёС†Р°Рј)"
                    elif "РјРµРґРёР°РЅСѓ" in strategy:
                        for col in cols_to_fix:
                            if df_preview[col].dtype in ['int64', 'float64']:
                                df_preview[col] = df_preview[col].fillna(df_preview[col].median())
                        note = "(Р·Р°РјРµРЅР° РјРµРґРёР°РЅРѕР№)"
                    elif "РЈРґР°Р»РёС‚СЊ" in strategy:
                        df_preview = df_preview[~combined_mask].reset_index(drop=True)
                        note = "(СѓРґР°Р»РµРЅРёРµ СЃС‚СЂРѕРє)"
                    elif "0пёЏвѓЈ" in strategy:
                        for col in cols_to_fix:
                            df_preview[col] = df_preview[col].fillna(0)
                        note = "(Р·Р°РјРµРЅР° РЅР° 0)"
                    else:
                        note = "(Р±РµР· РёР·РјРµРЅРµРЅРёР№)"

                    # РњРµС‚СЂРёРєРё (4 РєРѕР»РѕРЅРєРё)
                    c_p1, c_p2, c_p3, c_p4 = st.columns(4)
                    c_p1.metric("рџ“Љ Р—Р°РїРёСЃРµР№", f"{len(df_work)} в†’ {len(df_preview)}", delta=f"{len(df_preview)-len(df_work):+}")

                    if cols_to_fix:
                        col = cols_to_fix[0]
                        def safe_stat(d, c, f):
                            return f(d[c]) if not d.empty and c in d.columns and d[c].notna().any() else 0.0
                        m_b, s_b, d_b = safe_stat(df_work, col, np.mean), safe_stat(df_work, col, np.std), safe_stat(df_work, col, np.median)
                        m_a, s_a, d_a = safe_stat(df_preview, col, np.mean), safe_stat(df_preview, col, np.std), safe_stat(df_preview, col, np.median)
                        fmt = lambda x: f"{x:.2f}" if pd.notnull(x) and x != 0.0 else "N/A"
                        delta = lambda b, a: f"{((a-b)/abs(b)*100):+.1f}%" if b != 0 and pd.notnull(b) else "0%"
                        c_p2.metric("рџ“€ Mean", f"{fmt(m_b)} в†’ {fmt(m_a)}", delta=delta(m_b, m_a))
                        c_p3.metric("рџ“‰ Std", f"{fmt(s_b)} в†’ {fmt(s_a)}", delta=delta(s_b, s_a))
                        c_p4.metric("рџ“Љ Median", f"{fmt(d_b)} в†’ {fmt(d_a)}", delta=delta(d_b, d_a))

                    # РљРЅРѕРїРєРё РїРѕРґС‚РІРµСЂР¶РґРµРЅРёСЏ
                    st.divider()
                    c_ok, c_cancel = st.columns(2)
                    with c_ok:
                        if st.button("рџ’ѕ РџРѕРґС‚РІРµСЂРґРёС‚СЊ РёР·РјРµРЅРµРЅРёСЏ", type="primary", use_container_width=True, key="btn_confirm_range"):
                            st.session_state.df_after_fixes = df_preview.copy()
                            st.session_state.df = df_preview
                            st.session_state.validation_ready = False
                            st.session_state.show_range_preview = False
                            st.success("вњ… РЎС‚СЂР°С‚РµРіРёСЏ РїСЂРёРјРµРЅРµРЅР°! РџРµСЂРµР·Р°РїСѓСЃС‚РёС‚Рµ РІР°Р»РёРґР°С†РёСЋ.")
                            st.rerun()
                    with c_cancel:
                        if st.button("вќЊ РћС‚РјРµРЅР°", use_container_width=True, key="btn_cancel_range"):
                            st.session_state.show_range_preview = False
                            st.rerun()

        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ
        # 4. РџР РћР’Р•Р РљРђ РЎРћР“Р›РђРЎРћР’РђРќРќРћРЎРўР (СЃ РёРЅС‚РµСЂР°РєС‚РёРІРЅС‹Рј РїР°Р№РїР»Р°Р№РЅРѕРј)
        # в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ

        # 4. РЎРѕРіР»Р°СЃРѕРІР°РЅРЅРѕСЃС‚СЊ
        consistency_results_local = st.session_state.val_results.get("consistency", [])
