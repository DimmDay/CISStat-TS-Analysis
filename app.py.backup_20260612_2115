    </style>
    """, unsafe_allow_html=True)

    # в”Ђв”Ђ рџ”Ѕ РћРЎРќРћР’РќРћР™ РљРћРќРўР•РќРў РЎР•РљР¦РР в”Ђв”Ђв”Ђв”Ђв”Ђ
    with st.expander(" РџРѕРєР°Р·Р°С‚СЊ Р°РЅР°Р»РёР· СЂР°СЃРїСЂРµРґРµР»РµРЅРёСЏ", expanded=False):
        if st.session_state.col_types.get("num"):
            selected_col = st.selectbox(
                "Р’С‹Р±РµСЂРёС‚Рµ С‡РёСЃР»РѕРІСѓСЋ РєРѕР»РѕРЅРєСѓ РґР»СЏ Р°РЅР°Р»РёР·Р° СЂР°СЃРїСЂРµРґРµР»РµРЅРёСЏ:",
