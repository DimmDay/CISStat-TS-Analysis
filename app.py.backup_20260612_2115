            "**в—»пёЏ РњРµС‚СЂРёРєРё:** `% invalid = violations/valid`, РєРѕР»-РІРѕ Р»РѕРіРёС‡РµСЃРєРёС… РїСЂРѕС‚РёРІРѕСЂРµС‡РёР№.  \n"
            "**в—»пёЏ РђР»РіРѕСЂРёС‚Рј:** Р’РµРєС‚РѕСЂРёР·РѕРІР°РЅРЅС‹Рµ pandas-РјР°СЃРєРё `(df[A] OP df[B])` в†’ СЂР°СЃС‡РµС‚ % РЅР°СЂСѓС€РµРЅРёР№.  \n"
            "**в—»пёЏ Р’Р»РёСЏРЅРёРµ РЅР° TS:** РќРµСЃРѕРѕС‚РІРµС‚СЃС‚РІРёСЏ РІ С…СЂРѕРЅРѕР»РѕРіРёРё РёСЃРєР°Р¶Р°СЋС‚ Р»Р°РіРё, Р»РѕРјР°СЋС‚ `cumsum` Рё VAR/VECM.  \n"
            "**в—»пёЏ РћРїРёСЃР°РЅРёРµ:** РњРѕРґСѓР»СЊ Р°РІС‚РѕРјР°С‚РёС‡РµСЃРєРё РІС‹СЏРІР»СЏРµС‚ Р»РѕРіРёС‡РµСЃРєРёРµ Рё РІСЂРµРјРµРЅРЅС‹Рµ РїСЂРѕС‚РёРІРѕСЂРµС‡РёСЏ РІ РґР°РЅРЅС‹С…, " \
            "СЃРІРµСЂСЏСЏ Р·РЅР°С‡РµРЅРёСЏ РјРµР¶РґСѓ СЃРІСЏР·Р°РЅРЅС‹РјРё РєРѕР»РѕРЅРєР°РјРё Рё С…СЂРѕРЅРѕР»РѕРіРёРµР№ СЃРѕР±С‹С‚РёР№ РЅР° РѕСЃРЅРѕРІРµ Р·Р°РґР°РЅРЅС‹С… Р±РёР·РЅРµСЃ-РїСЂР°РІРёР» (РїСЂРёР±С‹Р»СЊ Р±РѕР»СЊС€Рµ РІС‹СЂСѓС‡РєРё, РїРѕС‚СЂРµР±Р»РµРЅРёРµ РЅР° РѕСЃРІРµС‰РµРЅРёРµ Р±РѕР»СЊС€Рµ РѕР±С‰РµРіРѕ РїРѕС‚СЂРµР±Р»РµРЅРёСЏ, Р·Р°РїРёСЃРё РёРґСѓС‚ РЅРµ РїРѕ С…СЂРѕРЅРѕР»РѕРіРёРё вЂ” РїРѕСЃР»Рµ 10:05:00 РёРґС‘С‚ 10:03:00 Рё С‚.Рґ.). " \
            "РџСЂРё РѕР±РЅР°СЂСѓР¶РµРЅРёРё РЅР°СЂСѓС€РµРЅРёР№ СЃРёСЃС‚РµРјР° СЂР°СЃСЃС‡РёС‚Р°РµС‚ РґРѕР»СЋ Р±СЂР°РєР° Рё РїСЂРµРґР»РѕР¶РёС‚ СЃС‚СЂР°С‚РµРіРёРё РїРѕ РёСЃРїСЂР°РІР»РµРЅРёСЋ Р°РЅРѕРјР°Р»РёР№.",
            "вњ… Р’СЃРµ Р±РёР·РЅРµСЃ-РїСЂР°РІРёР»Р° СЃРѕР±Р»СЋРґРµРЅС‹" if not consistency_issues else f"пёЏ РќР°Р№РґРµРЅРѕ {consistency_violations} РЅР°СЂСѓС€РµРЅРёР№",
            "вњ…" if not consistency_issues else "вљ пёЏ", None)

        # в”Ђв”Ђ рџ”§ РРќРўР•Р РђРљРўРР’РќР«Р™ РџРђР™РџР›РђР™Рќ РћР‘Р РђР‘РћРўРљР (СЂР°СЃРєСЂС‹РІР°РµС‚СЃСЏ РїСЂРё РїСЂРѕР±Р»РµРјР°С…) в”Ђв”Ђ
        if consistency_issues:
            with st.expander("рџ”§ РџРѕР»РЅС‹Р№ РїР°Р№РїР»Р°Р№РЅ РѕР±СЂР°Р±РѕС‚РєРё РЅР°СЂСѓС€РµРЅРёР№ СЃРѕРіР»Р°СЃРѕРІР°РЅРЅРѕСЃС‚Рё", expanded=consistency_violations > 0):
                st.markdown("### рџ“‹ РўР°Р±Р»РёС†Р° РЅР°СЂСѓС€РµРЅРёР№ СЃ СЂСѓС‡РЅРѕР№ РєРѕСЂСЂРµРєС‚РёСЂРѕРІРєРѕР№")

                # РРЅРёС†РёР°Р»РёР·Р°С†РёСЏ СЃРѕСЃС‚РѕСЏРЅРёР№
                if "df_consistency_work" not in st.session_state:
                    st.session_state.df_consistency_work = df.copy()
                df_work = st.session_state.df_consistency_work

                # Р¤РѕСЂРјРёСЂСѓРµРј РѕР±С‰СѓСЋ РјР°СЃРєСѓ РЅР°СЂСѓС€РµРЅРёР№ РёР· СЃР»РѕРІР°СЂСЏ РјР°СЃРѕРє
                combined_mask = pd.Series(False, index=df_work.index)
                for mask in consistency_masks.values():
                    combined_mask |= mask

                # Р¤РёР»СЊС‚СЂ РѕС‚РѕР±СЂР°Р¶РµРЅРёСЏ
                view_filter = st.radio(
                    "Р¤РёР»СЊС‚СЂ СЃС‚СЂРѕРє:",
                    ["вљ пёЏ РўРѕР»СЊРєРѕ СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё", "вњ… РџРѕРєР°Р·Р°С‚СЊ РІСЃС‘"],
                    horizontal=True,
                    key="consistency_view_filter"
                )

                if view_filter == "вљ пёЏ РўРѕР»СЊРєРѕ СЃ РЅР°СЂСѓС€РµРЅРёСЏРјРё":
                    df_view = df_work[combined_mask].copy() if combined_mask.any() else df_work.iloc[:0].copy()
                else:
                    df_view = df_work.copy()

                # Р”РѕР±Р°РІР»СЏРµРј СЃС‚Р°С‚СѓСЃ-РєРѕР»РѕРЅРєСѓ
                df_view = df_view.copy()
                df_view.insert(0, '_STATUS', df_view.index.map(lambda idx: "рџ”ґ РќР°СЂСѓС€РµРЅРёРµ" if combined_mask.loc[idx] else "рџџў РќРѕСЂРјР°"))

                # РРЅС‚РµСЂР°РєС‚РёРІРЅР°СЏ С‚Р°Р±Р»РёС†Р° (Р СѓС‡РЅР°СЏ РїСЂР°РІРєР°)
                edited_df = st.data_editor(
                    df_view,
                    use_container_width=True,
