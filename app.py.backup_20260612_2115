        # рџ”§ РРЎРџР РђР’Р›Р•РќРР•: РЈР±РёСЂР°РµРј st.columns(), РѕСЃС‚Р°РІР»СЏРµРј С‚РѕР»СЊРєРѕ radio СЃ horizontal=True
