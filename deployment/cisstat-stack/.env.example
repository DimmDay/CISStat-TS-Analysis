# deployment/cisstat-stack/.env.example
#
# AUTH-06-OPS-PHASE1: шаблон окружения прод-стека.
# Порядок ввода в эксплуатацию:
#   1. cp .env.example .env          # ВНУТРИ deployment/cisstat-stack/
#   2. заполнить каждое <плейсхолдер> реальным значением (команды ниже)
#   3. chmod 600 .env                # права только владельцу
#   4. КОПИЯ ВСЕХ ЗНАЧЕНИЙ -- в менеджер паролей (единственный источник
#      восстановления; volume caddy_data и pgdata без .env невосстановимы
#      для сессий/MFA-факторов).
# Файл .env в репозиторий не попадает (.gitignore).

# --- Postgres (compose создаёт БД cisstat и пользователя) -----------------
# openssl rand -base64 24
CISSTAT_PG_PASSWORD=<openssl-rand-base64-24>

# --- AUTH-05/AUTH-06 durable-ключи ----------------------------------------
# CSRF-ключ, >=32 байта: openssl rand -base64 32
CISSTAT_AUTH_CSRF_KEY=<openssl-rand-base64-32>
# MFA-keyring (формат docs/auth05/design.md): JSON БЕЗ ПРОБЕЛОВ,
# id ключа -- произвольная метка с датой ротации:
#   {"tsa-mfa-1-2026-11":"<openssl rand -base64 32>"}
CISSTAT_AUTH_MFA_KEYS=<json-keyring-no-spaces>
# Активный id -- должен совпадать с ключом внутри CISSTAT_AUTH_MFA_KEYS.
CISSTAT_AUTH_MFA_ACTIVE_KEY=<key-id-from-keyring>

# --- CORS / origins (exact HTTPS, через запятую) --------------------------
CISSTAT_AUTH_ALLOWED_ORIGINS=https://datasetup.ru,https://www.datasetup.ru

# --- Прочее (уже выставлено в compose, здесь -- для полноты картины) ------
# CISSTAT_STORAGE_MODE=required задаётся жёстко в docker-compose.yml
# (fail-closed: без БД сервис не стартует) -- в .env не переопределять.

# AUTH-13: выпустить credential официальным путём (интерактивный терминал):
#   python scripts/auth13/manage_workers.py issue-service --kinds modeling render delivery --reason "<причина>"
# и вписать напечатанный ключ (cwk_... без кавычек) в CISSTAT_WORKER_KEY ниже.
# С 09.11.2026 api при старте сам регистрирует дайджест ключа из env в
# auth_worker_services (bootstrap, OPS-DIAG-1), если валидной строки нет;
# revoked/expired строки не воскрешаются. Диагностика: /health/ops -> worker_credential.
# Empty/missing key fails closed for guarded jobs; never commit the real secret.
CISSTAT_WORKER_KEY=
CISSTAT_WORKER_ACCOUNT_SLOTS=1

# AUTH-14: leave both empty until benchmark/profile validation on this VM.
CISSTAT_CU_PROFILE=
CISSTAT_CU_PROFILE_SHA256=

# AUTH-16 bounded SQL expiry/cleanup worker (default on); physical GC is quiesced CLI only.
CISSTAT_DEMO_SWEEPER_ENABLED=1

# AUTH-18 isolated YooKassa TEST shop only. Default off; no live checkout.
# Enable only after explicit sandbox cycle provisioning (docs/auth18/deploy.md).
CISSTAT_YOOKASSA_ENABLED=off
CISSTAT_YOOKASSA_SHOP_ID=
CISSTAT_YOOKASSA_SECRET_KEY=

# AUTH-20: kill-switch safe rollback. Любое значение кроме пустого и "0"
# закрывает НОВЫЕ входы (password/demo/OIDC/email) с 503 auth_lockdown;
# существующие сессии и ключи не затрагиваются. Снятие: unset + пересоздание api.
# CISSTAT_AUTH_LOCKDOWN=0

# AUTH-20: период доставки обязательного audit outbox (сек; 0 = выключено).
CISSTAT_AUTH_AUDIT_OUTBOX_INTERVAL=30
# AUTH-20: retention revocation ledger (дней; минимум 7). Файл marks
# (scripts/auth20/reconcile.py --export) хранится ВНЕ pgdata volume.
CISSTAT_AUTH_OPS_LEDGER_RETENTION_DAYS=180

# AUTH-19: личный email-вход (trial/bind). Выключено, пока оба блока пусты.
# Ключ keyed-хранения одноразовых секретов (>=32 байта):
#   openssl rand -base64 32
CISSTAT_AUTH_EMAIL_KEY=
CISSTAT_AUTH_SMTP_HOST=
CISSTAT_AUTH_SMTP_PORT=587
CISSTAT_AUTH_SMTP_USER=
CISSTAT_AUTH_SMTP_PASSWORD=
CISSTAT_AUTH_SMTP_FROM=
# starttls | ssl | none
CISSTAT_AUTH_SMTP_TLS=starttls
CISSTAT_AUTH_TRIAL_PLAN_DAYS=

# AUTH-19: корпоративный OIDC (Authorization Code + PKCE S256 + state/nonce).
# Выключено, пока ISSUER/CLIENT_ID пусты. redirect_uri на IdP: <origin>/login.
CISSTAT_AUTH_OIDC_ISSUER=
CISSTAT_AUTH_OIDC_CLIENT_ID=
CISSTAT_AUTH_OIDC_CLIENT_SECRET=
# Пример: "openid profile email" (openid обязателен).
CISSTAT_AUTH_OIDC_SCOPES=openid profile email
